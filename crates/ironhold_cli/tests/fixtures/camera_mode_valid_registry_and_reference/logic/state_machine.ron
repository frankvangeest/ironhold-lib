(
    schema_versievent: 1,
    global_event: [
        (
            on: "ui.button_pressed:go_cinematic",
            do_actions: [ SetCameraMode(mode: "cine") ],
        ),
        (
            on: "ui.button_pressed:go_default",
            do_actions: [ SetCameraMode(mode: "default") ],
        ),
    ],
)
