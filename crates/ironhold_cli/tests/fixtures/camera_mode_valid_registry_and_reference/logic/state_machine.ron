(
    schema_version: 1,
    global_on: [
        (
            event: "ui.button_pressed:go_cinematic",
            do_actions: [ SetCameraMode(mode: "cine") ],
        ),
        (
            event: "ui.button_pressed:go_default",
            do_actions: [ SetCameraMode(mode: "default") ],
        ),
    ],
)
