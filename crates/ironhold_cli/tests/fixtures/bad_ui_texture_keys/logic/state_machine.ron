(
    schema_versievent: 1,
    global_event: [
        (
            on: "ui.button_pressed:close_inventory",
            do_actions: [Log("close inventory")],
        ),
        (
            on: "ui.button_pressed:close_container",
            do_actions: [Log("close container")],
        ),
        (
            on: "ui.button_pressed:take_all_from_container",
            do_actions: [Log("take all")],
        ),
    ],
)
