            kind: Prop,
            merchant: (
                currency_stat: "gold",
                stock: [
                    ( item_key: "ring", buy_price: 100, sell_price: 70 ),
                ],
            ),
        ),
        "pedlar": (
            kind: Prop,
            merchant: (
                currency_stat: "gold",
                stock: [
                    ( item_key: "ring", buy_price: 30, sell_price: 0 ),
                ],
            ),
        ),
    },
)
