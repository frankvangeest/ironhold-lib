(
    schema_version: 2,
    name: "main",
    entities: [
        (
            id: "player_01",
            prefab: "tight_orbit_player",
            transform: (translation: (-2.0, 0.0, 0.0)),
        ),
        (
            id: "player_02",
            prefab: "wide_orbit_player",
            transform: (translation: (2.0, 0.0, 0.0)),
        ),
    ],
    label_depth_scale: (
        // Far outside player_01's own tight 2.0-5.0 Orbit range, but well inside the union with
