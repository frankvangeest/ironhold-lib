// Example animation policy schema.
//
// This file is an example only and is not loaded automatically.
// It demonstrates how to add new looping overrides and abilities
// without recompiling the runtime.
(
  schema_version: 1,
  // The scene file would include this under `player: Some(( ... ))`
  animation_policy: (
    // Optional global default transition (ms). Omit for instant switching.
    default_transition_ms: Some(150),

    base: (
      idle: "Idle_Loop",
      walk: "Walk_Loop",
      run:  "Sprint_Loop",
      jump_loop: "Jump_Loop",
    ),

    // Optional aliases (semantic key -> glTF clip name)
    clips: {
      "dance": "Dance_Loop",
      "sit": "Sitting_Idle_Loop",
      "torch_idle": "Idle_Torch_Loop",
      "attack_light": "Sword_Attack",
    },

    // Overrides define cancellation and stop commands.
    overrides: [
      (
        id: "dance",
        clip: "Dance_Loop",
        priority: 50,
        looping: true,
        cancel_on_move: true,
        stop_action: Some("stop_dance"),
      ),
      (
        id: "sit",
        clip: "Sitting_Idle_Loop",
        priority: 60,
        looping: true,
        cancel_on_move: true,
        stop_action: Some("stand"),
      ),
      (
        id: "torch_idle",
        clip: "Idle_Torch_Loop",
        priority: 40,
        looping: true,
        cancel_on_move: false,
        stop_action: Some("stop_torch"),
      ),
      (
        id: "attack_light",
        clip: "Sword_Attack",
        priority: 100,
        looping: false,
        duration: Some(0.6),
        cancel_on_move: false,
      ),
    ],
  ),
)

