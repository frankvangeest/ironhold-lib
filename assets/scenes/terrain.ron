(
    schema_version: 1,
    models: [],
    ui: [],
    player: Some((
        model_path: "models/character-01.glb#Scene0",
        initial_position: (0.0, 0.0, 0.0),
        camera: (
            offset: (0.0, 5.0, 10.0),
            look_at_offset: (0.0, 2.0, 0.0),
            zoom_speed: 10.0,
            orbit_speed: 0.5,
            min_radius: 2.0,
            max_radius: 20.0,
        ),
        inputs: (
            forward: "KeyW",
            backward: "KeyS",
            left: "KeyA",
            right: "KeyD",
            strafe_left: "KeyQ",
            strafe_right: "KeyE",
            jump: "Space",
        ),
        animation_policy: (
            // Optional global default transition (ms). Omit for instant switching.
            default_transition_ms: Some(150),
            
            base: (
                idle: "Idle_Loop",
                walk: "Walk_Loop",
                run:  "Sprint_Loop",
                jump_loop: "Jump_Loop",
            ),

            // Optional aliases (semantic key -> glTF clip name)
            clips: {
                "dance": "Dance_Loop",
                "sit": "Sitting_Idle_Loop",
                "torch_idle": "Idle_Torch_Loop",
                "attack_light": "Sword_Attack",
            },

            // Overrides define cancellation and stop commands.
            overrides: [
                (
                    id: "dance",
                    clip: "Dance_Loop",
                    priority: 50,
                    looping: true,
                    cancel_on_move: true,
                    stop_action: Some("stop_dance"),
                ),
                (
                    id: "sit",
                    clip: "Sitting_Idle_Loop",
                    priority: 60,
                    looping: true,
                    cancel_on_move: true,
                    stop_action: Some("stand"),
                ),
                (
                    id: "torch_idle",
                    clip: "Idle_Torch_Loop",
                    priority: 40,
                    looping: true,
                    cancel_on_move: false,
                    stop_action: Some("stop_torch"),
                ),
                (
                    id: "attack_light",
                    clip: "Sword_Attack",
                    priority: 100,
                    looping: false,
                    duration: Some(0.6),
                    cancel_on_move: false,
                ),
            ],
        ),
    )),
    terrain: Some((
        heightmap_path: "terrain/heightmap.png",
        splatmap_path: "terrain/splatmap.png",
        height_scale: 10.0,
        //horizontal_scale: 100.0,
        position: (0.0, -10.0, 0.0),
        chunk_size: 64, // Not currently used but in schema
        material_paths: [
            "terrain/dirt.png",
            "terrain/grass.png",
            "terrain/rock.png",
            "terrain/snow.png",
        ],
    )),
    lighting: Some((
        ambient: Some((
            color: (0.8, 0.85, 1.0),
            brightness: 120.0,
        )),
        directional: Some((
            color: (1.0, 0.95, 0.85),
            illuminance: 15000.0,
            direction: (0.3, -1.0, 0.2),
            shadows_enabled: true,
        )),
    )),
)
