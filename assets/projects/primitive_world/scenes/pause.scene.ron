(
  schema_version: 2,
  name: "pause",

  entities: [],

  ui_panel: (
    background_color: (0.04, 0.04, 0.08, 0.92),
    padding: 32.0,
    gap: 16.0,
    width: 300.0,
  ),

  ui: [
    Label((
      id: "pause_title",
      text: "Paused",
      size: (260.0, 50.0),
    )),
    Button((
      id: "resume_button",
