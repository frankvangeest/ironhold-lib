    // ── Ground ────────────────────────────────────────────────────────────────
    // physics: true → static Rapier collider. Cuboid(80,1,80) centered at y=-0.5
    // puts the top surface at y=0.  Player spawn position is feet height above ground.
    (
      id: "ground",
      prefab: "ground_plane",
      transform: (
        translation: (0.0, -0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Player ────────────────────────────────────────────────────────────────
    // translation is the feet / ground-contact point. Physics settles to y=0.
