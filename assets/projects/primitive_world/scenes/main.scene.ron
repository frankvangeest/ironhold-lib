  lighting: (
    ambient: (0.22, 0.28, 0.38),
    ambient_brightness: 280.0,
    directional: (
      color: (1.0, 0.95, 0.80),
      intensity: 32000.0,
      rotation_euler_deg: (-45.0, 25.0, 0.0),
      shadows_enabled: true,
