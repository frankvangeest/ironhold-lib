// Character stats overlay — toggled with Key C while playing.
// Uses the same ToggleOverlay pattern as the world map (Key M).

(
  schema_version: 2,
  name: "character_stats",

  entities: [],

  ui_panel: (
    background_color: (0.06, 0.05, 0.05, 0.95),
    padding: 0.0,
    gap: 0.0,
    width: 320.0,
    height: 320.0,
  ),

  ui: [

    // ── Title ──────────────────────────────────────────────────────────────────
    Label((
      id: "stats_title",
      text: "PLAYER STATS",
      absolute: true,
      position: (12.0, 12.0),
      size: (296.0, 24.0),
    )),

    // ── Radar chart — all five player stats ────────────────────────────────────
    // Axes (clockwise from top): health, mana, stamina, strength, speed.
    StatRadar((
      id: "stats_radar",
      stats: ["player_health", "player_mana", "player_stamina", "player_strength", "player_speed"],
      size: (280.0, 280.0),
      absolute: true,
      position: (20.0, 30.0),
      grid_steps: 5,
      outline_width: 2.0,
      fill_color:       (0.35, 0.65, 1.0, 0.40),
      outline_color:    (0.55, 0.85, 1.0, 1.0),
      grid_color:       (0.40, 0.45, 0.55, 0.40),
      background_color: (0.08, 0.10, 0.18, 0.85),
    )),

  ],
)
