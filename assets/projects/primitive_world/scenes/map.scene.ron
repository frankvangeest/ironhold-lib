// World Map overlay for primitive_world.
//
// All element positions are relative to the panel's top-left corner.
// Coordinate mapping from world space:
//   panel_x = 18 + (world_x + 14) * 8
//   panel_y = 46 + (9  - world_z) * 8
//
// World bounds shown: X [-14, 14]  Z [-31, 9]  →  map canvas 224 × 320 px
// Panel:              260 × 424 px, centered on screen by flex layout
// Map canvas origin:  (18, 46) within panel

(
  schema_version: 2,
  name: "map",

  entities: [],

  ui_panel: Some((
    background_color: (0.06, 0.05, 0.04, 0.97),
    padding: 0.0,
    gap: 0.0,
    width: Some(260.0),
    height: Some(424.0),
  )),

  ui: [

    // ── Title ─────────────────────────────────────────────────────────────────
    (
      kind: "label",
      id: "map_title",
      text: "WORLD MAP",
      absolute: true,
      position: (18.0, 10.0),
      size: (224.0, 26.0),
    ),

    // ── Decorative divider below title ────────────────────────────────────────
    (
      kind: "rect",
      id: "divider_top",
      absolute: true,
      position: (18.0, 40.0),
      size: (224.0, 2.0),
      color: (0.30, 0.26, 0.18, 1.0),
    ),

    // ── Map canvas border (1 px wider/taller than grass, draws as thin frame) ─
    (
      kind: "rect",
      id: "map_border",
      absolute: true,
      position: (17.0, 45.0),
      size: (226.0, 322.0),
      color: (0.32, 0.28, 0.20, 1.0),
    ),

    // ── Grass background ──────────────────────────────────────────────────────
    (
      kind: "rect",
      id: "grass",
