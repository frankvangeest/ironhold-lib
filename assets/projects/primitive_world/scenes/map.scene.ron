      position: (18.0, 46.0),
      size: (224.0, 320.0),
      color: (0.16, 0.33, 0.11, 1.0),
    ),

    // ── Paths ─────────────────────────────────────────────────────────────────
    // North segment: player start (z=8) to village entry (z=-8)
    (
      kind: "rect",
      id: "path_n",
      absolute: true,
      position: (127.0, 54.0),
      size: (6.0, 128.0),
      color: (0.55, 0.50, 0.40, 1.0),
    ),
    // South segment: village entry (z=-8) to pond edge (z=-22)
    (
