  audio: {
    "bg_music":     (path: "shared/audio/bg-music-balance.mp3", volume: 0.2),
    "click":        (path: "shared/audio/menu-button-click.wav"),
    "collect_coin": (path: "shared/audio/game-pickup-01.wav"),
    "jump":         (path: "shared/audio/jump.wav"),
    "npc_greet":    (path: "projects/primitive_world/audio/child-hello.wav"),
    "goblin_growl": (path: "projects/primitive_world/audio/growl.wav", volume: 0.5),
    "goblin_hit":   (path: "shared/audio/combat/punch-01.wav"),
    "player_pain":  (path: "shared/audio/combat/pain-01.wav", volume: 0.8),
    "swing_miss":   (path: "shared/audio/combat/heave-male.wav", volume: 0.6),
  },

  effects: {

    // Fast orange sparks flying in all directions — classic "hit" reaction.
    // Full sphere spread + heavy gravity = debris-falling-away feel.
    "hit_spark": (
      particle_count: 12,      // sparse — quick read, not noisy
      lifetime_secs: 0.45,     // brief flash, gone before next hit lands
      speed: 3.5,
      speed_jitter: 0.8,       // variation prevents robotic uniformity
      spread_deg: 180.0,       // full sphere — debris flies everywhere
      offset: (0.0, 1.0, 0.0),
      size: 0.055,
      size_end: 0.0,           // shrinks to nothing at end of life
      color_start: (1.0, 0.8, 0.2, 1.0),
      color_end:   (1.0, 0.1, 0.0, 0.0),
      gravity: -5.0,           // strong fall — heavy "ash" feel
    ),

    // Soft green sparkles rising upward — used when the dummy resets to full health.
    // Narrow cone + positive gravity = upward drift that settles back down.
    "heal_burst": (
      particle_count: 18,
      lifetime_secs: 0.8,
      speed: 2.2,
      speed_jitter: 0.5,
      spread_deg: 50.0,        // narrow upward cone — looks intentional, not random
      offset: (0.0, 1.2, 0.0),
      size: 0.05,
      size_end: 0.08,          // grows slightly — "blooming" sparkle
      color_start: (0.2, 1.0, 0.4, 1.0),
      color_end:   (0.0, 0.4, 0.1, 0.0),
      gravity: 1.5,            // positive gravity = floats upward then slows
    ),

    // Slow floaty white-to-blue particles drifting upward — used on coin pickup or scene events.
    // Demonstrates: low speed, near-zero gravity, growing size, longer life.
    "pickup_sparkle": (
      particle_count: 16,
      lifetime_secs: 1.2,
      speed: 0.8,
      speed_jitter: 0.3,
      spread_deg: 60.0,
      offset: (0.0, 0.8, 0.0),
      size: 0.04,
      size_end: 0.12,          // grows — "blossoming" feel
      color_start: (0.9, 0.95, 1.0, 1.0),
      color_end:   (0.3, 0.5, 1.0, 0.0),
      gravity: 0.3,            // near-zero: slow rise
    ),

    // Single-layer campfire flame sprites — one burst every 0.2 s from campfire.behavior.ron.
    // (particles_demo and effect_mayhem_demo use a two-layer version of this key.)
    // sprite: flame_03 is a narrow candle-tongue shape; additive blending makes it glow.
    // Fewer particles than the old sphere version — sprites are much more visible.
    // Three-stop gradient tints the sprite: white-yellow base → orange core → dark-red tip.
    "campfire_fire": (
      particle_count: 8,
      lifetime_secs: 0.55,
      speed: 1.6,
      speed_jitter: 0.45,
      spread_deg: 16.0,
      emit_radius: 0.12,         // scatter across log surface
      offset: (0.0, 0.15, 0.0),
      size: 0.26,                // quad scale — 0.26 m wide sprite tongue
      size_jitter: 0.06,
      size_end: 0.0,             // shrinks to nothing as it burns out
      color_start: (1.0, 0.92, 0.55, 1.0), // bright white-yellow at base
      color_mid:   (1.0, 0.45, 0.05, 1.0), // deep orange through the middle
      color_end:   (0.5, 0.04, 0.0,  0.0), // dark red, fully transparent at tip
      gravity: -0.6,
      turbulence: 0.40,
      sprite: "particle/flame_03",          // narrow upward flame tongue sprite
      additive: true,                        // additive blending for glowing fire look
      uv_distort: 0.55,                      // tip-weighted distortion: flame wavers and dances
      uv_scroll_speed: 0.35,                 // slow upward drift: flame appears to consume itself
    ),

    // Billboard smoke puffs rising above the flames — one burst every 0.8 s.
    // sprite: smoke_04 is a soft rounded puff; Blend mode preserves soft alpha edges.
    // size grows 0.25 → 0.90 m: puffs spread as hot air disperses and cools.
    "campfire_smoke": (
      particle_count: 3,
      lifetime_secs: 2.4,
      speed: 0.5,
      speed_jitter: 0.15,
      spread_deg: 10.0,
      emit_radius: 0.06,
      offset: (0.0, 0.7, 0.0),
      size: 0.25,
      size_jitter: 0.05,
      size_end: 0.90,            // expands ~3.6× — natural dispersion into the air
      color_start: (0.65, 0.62, 0.60, 0.65), // mid-gray in sRGB → ~0.38 linear: visible gray puff
      color_end:   (0.78, 0.78, 0.76, 0.0),  // lighter gray, fully transparent as it disperses
      gravity: 0.4,
      turbulence: 0.25,          // more billowing than before — columns sway visibly
      sprite: "particle/smoke_04",          // soft rounded smoke puff sprite
    ),

    // ── Skill bar effects ──────────────────────────────────────────────────────

    // Dramatic heal burst — large green/white star shower rising from the player.
    "skill_heal": (
      particle_count: 40,
      lifetime_secs: 1.4,
      speed: 5.5,
      speed_jitter: 2.0,
      spread_deg: 70.0,
      emit_radius: 0.5,
      offset: (0.0, 0.6, 0.0),
      size: 0.12,
      size_end: 0.0,
      color_start: (0.4, 1.0, 0.5, 1.0),
      color_mid:   (0.9, 1.0, 0.9, 0.7),
      color_end:   (0.1, 0.6, 0.2, 0.0),
      gravity: 1.2,
      sprites: ["particle/star_01", "particle/star_05", "particle/magic_03"],
      additive: true,
    ),

    // Speed boost aura — fast radiating blue/cyan ring bursting outward from the player.
    "skill_speedboost": (
      particle_count: 36,
      lifetime_secs: 0.65,
      speed: 8.0,
      speed_jitter: 1.5,
      spread_deg: 180.0,
      emit_radius: 0.2,
      offset: (0.0, 0.9, 0.0),
      size: 0.10,
      size_end: 0.0,
      color_start: (0.4, 0.85, 1.0, 1.0),
      color_end:   (0.0, 0.3, 1.0, 0.0),
      gravity: -0.5,
      sprites: ["particle/magic_01", "particle/light_02", "particle/trace_01"],
      additive: true,
    ),

    // Fire burst — large orange-red explosion on the player; strong gravity gives flying-debris feel.
    "skill_fireburst": (
      layers: [
        // Outer shockwave sparks — fast, wide, heavy fall
        (
          particle_count: 28,
          lifetime_secs: 0.55,
          speed: 9.0,
          speed_jitter: 2.5,
          spread_deg: 180.0,
          emit_radius: 0.3,
          offset: (0.0, 1.0, 0.0),
          size: 0.11,
          size_end: 0.0,
          color_start: (1.0, 0.6, 0.1, 1.0),
          color_end:   (0.8, 0.05, 0.0, 0.0),
          gravity: -7.0,
          sprite: "particle/muzzle_03",
          additive: true,
        ),
        // Core fire glow — slower, large, upward drift
        (
          particle_count: 12,
          lifetime_secs: 0.75,
          speed: 2.5,
          speed_jitter: 0.8,
          spread_deg: 50.0,
          emit_radius: 0.2,
          offset: (0.0, 0.8, 0.0),
          size: 0.25,
          size_end: 0.04,
          color_start: (1.0, 0.9, 0.3, 0.0),
          color_mid:   (1.0, 0.45, 0.05, 1.0),
          color_end:   (0.6, 0.05, 0.0, 0.0),
          gravity: 0.8,
          uv_distort: 0.4,
          uv_scroll_speed: 0.6,
          sprites: ["particle/flame_03", "particle/flame_04"],
          additive: true,
        ),
      ],
    ),

  },

  materials: {

    // ── Scenery surface textures — full PBR triplanar ─────────────────────────
    // All use custom_texture_triplanar_pbr.wgsl with basecolor + normal +
    // roughness + AO. Triplanar projection drives UVs from world-space position
    // so there are no UV seams or pole pinch on cylinders, spheres, and cones.
    // tiling = repeats per world unit; tune per object scale.

    "mat_bark": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar_pbr.wgsl",
        textures: {
          "texture_0": "shared/textures/Stylized_Bark_003_SD/Stylized_Bark_003_basecolor.png",
          "texture_1": "shared/textures/Stylized_Bark_003_SD/Stylized_Bark_003_normal.png",
          "texture_2": "shared/textures/Stylized_Bark_003_SD/Stylized_Bark_003_roughness.png",
          "texture_3": "shared/textures/Stylized_Bark_003_SD/Stylized_Bark_003_ambientOcclusion.png",
        },
        colors: { "tint": (r:1.0, g:1.0, b:1.0, a:1.0) },
        floats: { "blend_sharpness": 4.0, "metallic": 0.0, "normal_strength": 1.2, "tiling": 0.5 },
      )),
    ),

    "mat_wood_planks": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar_pbr.wgsl",
        textures: {
          "texture_0": "shared/textures/Stylized_Wood_Planks_001_SD/Stylized_Wood_Planks_001_basecolor.jpg",
          "texture_1": "shared/textures/Stylized_Wood_Planks_001_SD/Stylized_Wood_Planks_001_normal.jpg",
          "texture_2": "shared/textures/Stylized_Wood_Planks_001_SD/Stylized_Wood_Planks_001_roughness.jpg",
          "texture_3": "shared/textures/Stylized_Wood_Planks_001_SD/Stylized_Wood_Planks_001_ambientOcclusion.jpg",
