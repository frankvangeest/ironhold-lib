    "mat_thatched_roof": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar_pbr.wgsl",
        textures: {
          "texture_0": "shared/textures/Stylized_Thatched_Roof_003_SD/Stylized_Thatched_Roof_003_basecolor.png",
