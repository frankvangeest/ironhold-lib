      )),
    ),

    // ── Lamp orb — warm glass glow. Blend mode: centre is semi-transparent,
    // rim is opaque warm white, giving a lantern-glass effect.
    "mat_lamp_orb": (
      kind: Custom((
        shader: "shared/shaders/custom_emissive_fresnel.wgsl",
        colors: {
          "base_color": (r:0.90, g:0.80, b:0.30, a:0.50),
          "rim_color":  (r:1.00, g:0.95, b:0.70, a:1.00),
        },
        floats: {
          "rim_power": 2.0,
        },
      )),
      alpha_mode: Blend,
      unlit: true,
    ),

    // Gold deco orb — additive golden energy, invisible centre fades to bright rim.
    "mat_deco_orb_gold": (
      kind: Custom((
        shader: "shared/shaders/custom_emissive_fresnel.wgsl",
        colors: {
          "base_color": (r:0.60, g:0.40, b:0.00, a:0.10),
          "rim_color":  (r:1.00, g:0.80, b:0.15, a:1.00),
        },
        floats: {
          "rim_power": 2.5,
        },
      )),
      alpha_mode: Add,
      unlit: true,
    ),

    // Collectible coin — warm gold pulse. min_alpha: 0.25 so the coin never
    // goes fully dark; the steady glow helps the player spot it.
    "mat_coin_pulse": (
      kind: Custom((
        shader: "shared/shaders/custom_pulse.wgsl",
        colors: {
          "color": (r:1.00, g:0.85, b:0.10, a:1.00),
        },
        floats: {
          "min_alpha": 0.25,
          "speed": 1.5,
        },
      )),
      alpha_mode: Add,
      unlit: true,
    ),

    // Animated stylised water — Fresnel deep/shallow blend with procedural sine-wave ripples.
    // flow_speed: wave animation rate. tiling: ripple density. wave_strength: normal perturbation.
    "mat_water": (
      kind: Custom((
        shader: "shared/shaders/custom_water_stylized.wgsl",
        colors: {
          "deep_color":    (r:0.12, g:0.35, b:0.70, a:0.85),
          "shallow_color": (r:0.60, g:0.88, b:1.00, a:0.95),
        },
        floats: {
          "flow_speed":    0.5,
          "fresnel_power": 2.5,
          "tiling":        0.5,
          "wave_strength": 0.20,
        },
      )),
      alpha_mode: Blend,
      unlit: true,
    ),

    // Violet deco orb — additive violet energy.
    "mat_deco_orb_violet": (
      kind: Custom((
        shader: "shared/shaders/custom_emissive_fresnel.wgsl",
        colors: {
          "base_color": (r:0.20, g:0.00, b:0.40, a:0.10),
          "rim_color":  (r:0.80, g:0.30, b:1.00, a:1.00),
        },
        floats: {
          "rim_power": 2.5,
        },
      )),
      alpha_mode: Add,
      unlit: true,
    ),
  },
)
