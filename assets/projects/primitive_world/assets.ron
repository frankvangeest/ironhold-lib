      )),
    ),

    "mat_stone_cobble": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar_pbr.wgsl",
        textures: {
          "texture_0": "shared/textures/Cobblestone_001_SD/Cobblestone_001_COLOR.jpg",
