          ),
          // Body top at y=3; frustum center at 3+1 = 4.0
          offset: (0.0, 4.0, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Well (cylinder base + two pillars + crossbeam) ─────────────────────
    "well": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        (
          shape: "Cylinder",
          material: Some("mat_stone_bricks"),
          primitive: (
            radius: Some(0.70),
            height: Some(0.80),
          ),
          // Base: h=0.8 → center at 0.4
          offset: (0.0, 0.4, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Cylinder",
          material: Some("mat_stone_bricks"),
          primitive: (
            radius: Some(0.10),
            height: Some(1.80),
          ),
          // Pillar left: bottom at y=0.8, h=1.8 → center at 0.8+0.9 = 1.7
          offset: (-0.55, 1.7, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Cylinder",
          material: Some("mat_stone_bricks"),
          primitive: (
            radius: Some(0.10),
            height: Some(1.80),
          ),
          // Pillar right
          offset: (0.55, 1.7, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Cuboid",
          material: Some("mat_wood_planks"),
          primitive: (
            size: Some((1.20, 0.12, 0.14)),
          ),
          // Crossbeam at top of pillars: y = 0.8+1.8+0.06 = 2.66
          offset: (0.0, 2.66, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // Stone rim ring — outer edge (r=0.65+0.05=0.70) aligns with the cylinder wall.
        // Thinner tube (0.05) widens the inner opening to 0.60.
        (
          shape: "Torus",
          material: Some("mat_stone_bricks"),
          primitive: (
            radius: Some(0.7),
            radius_top: Some(0.4),
          ),
          // Slightly above stone cylinder top (y=0.80) to avoid z-fighting.
          offset: (0.0, 0.82, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // Water surface — fits inside torus inner opening (0.65−0.05=0.60).
        (
          shape: "Cylinder",
          material: Some("mat_water"),
          primitive: (
            radius: Some(0.58),
            height: Some(0.03),
          ),
          offset: (0.0, 0.82, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

