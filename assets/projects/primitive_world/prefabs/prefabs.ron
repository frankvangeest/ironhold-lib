(
  schema_version: 1,
  prefabs: {

    // ── Player ─────────────────────────────────────────────────────────────────
    // Capsule3d with `tags: ["player"]` is detected by the runtime and spawned
    // with a CharacterController, Rapier physics, and an OrbitCamera.
    // Children add a cap and face features so the front is clearly visible.
    // All child offsets are relative to the entity origin = feet = ground contact (y=0).
    // Capsule: radius=0.4, height=1.8 → extends from y=0 (feet) to y=1.8 (top).
    "player_capsule": (
      kind: "primitive",
      model: "Capsule3d",
      components: (
        tags: ["player"],
        sounds: {
          "jump": "jump",
        },
        movement: (
          walk_speed: 5.5,
          run_speed: 10.0,
          //jump: Some(Fixed(height: 1.8)),
          jump: Some(RelativeToHeight(percent: 100.0)),
          double_jump: true,
        ),
      ),
      primitive: Some((
        radius: Some(0.4),
        height: Some(1.8),
        color: Some((0.22, 0.52, 0.88)),
        roughness: Some(0.3),
        metallic: Some(0.15),
      )),
      children: [

        // ── Left eye (player faces −Z, so front is negative Z) ───────────
        // Eye level at y=0.68 above capsule centre → y=0.68+0.9=1.58 above feet.
        (
          shape: "Sphere",
          primitive: (
            radius: Some(0.07),
            color: Some((0.03, 0.03, 0.05)),
            roughness: Some(0.20),
            metallic: Some(0.10),
          ),
          offset: (-0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // ── Right eye ────────────────────────────────────────────────────
        (
          shape: "Sphere",
          primitive: (
            radius: Some(0.07),
            color: Some((0.03, 0.03, 0.05)),
            roughness: Some(0.20),
            metallic: Some(0.10),
          ),
          offset: (0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // ── Nose ─────────────────────────────────────────────────────────
        // Nose at y=0.59 above capsule centre → y=0.59+0.9=1.49 above feet.
        (
          shape: "Sphere",
          primitive: (
            radius: Some(0.07),
            color: Some((0.95, 0.58, 0.42)),
            roughness: Some(0.40),
          ),
          offset: (0.0, 1.49, -0.40),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ══════════════════════════════════════════════════════════════════════════
    // NPC capsule archetypes
    //
    // All NPC prefabs follow the same structure as the player capsule:
    //   • top-level `primitive` defines body shape (capsule radius + height) —
    //     these params drive the physics collider in the spawner.
    //   • `children` adds visual face features (eyes, nose) so the front is
    //     clearly visible even without a 3-D model.
    //   • `components.npc` configures the AI behaviour loaded at spawn time.
    //
    // Events emitted into the rules pipeline:
    //   "npc.player_spotted:{id}"  — player entered detection zone
    //   "npc.player_reached:{id}"  — NPC closed to approach_distance
    //   "npc.player_lost:{id}"     — NPC gave up chasing
    // ══════════════════════════════════════════════════════════════════════════

    // ── Friendly Villager ───────────────────────────────────────────────────
    // Patrols two waypoints near the village area. Approaches the player
    // with a 120° forward-cone detection (can be sneaked from behind).
    // Greets the player with a sound when approached.
    "npc_villager": (
      kind: "primitive",
      model: "Capsule3d",
      components: (
        tags: ["npc"],
        sounds: {
          "spotted": "npc_greet",
          "reached": "npc_greet",
        },
        npc: Some((
          faction: Friendly,
          on_player_near: Interact,
          detection_radius: 6.0,
          chase_radius: 10.0,
          fov_degrees: Some(120.0),
          requires_los: false,
          approach_distance: 2.5,
          patrol_speed: 1.8,
          chase_speed: 2.8,
          patrol_waypoints: [
            (-5.0, 0.0, 0.0),
            (5.0,  0.0, 0.0),
          ],
        )),
      ),
      primitive: Some((
        radius: Some(0.4),
        height: Some(1.8),
        color: Some((0.85, 0.65, 0.40)),
        roughness: Some(0.65),
        metallic: Some(0.0),
      )),
      children: [
        // Body — capsule centred at body_y=0.9 so its bottom aligns with the
        // entity origin (feet at y=0).  All face-feature offsets below are also
        // measured from the feet origin, consistent with the player prefab.
        (
          shape: "Capsule3d",
          primitive: (
            radius: Some(0.4),
            height: Some(1.8),
            color: Some((0.85, 0.65, 0.40)),
            roughness: Some(0.65),
            metallic: Some(0.0),
          ),
          offset: (0.0, 0.9, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // hat
        (
          shape: "Cylinder",
          primitive: (
            radius: Some(0.28),
            height: Some(0.2),
            color: Some((0.38, 0.24, 0.12)),
            roughness: Some(0.88),
          ),
          offset: (0.0, 1.8, 0.1),
          rotation_euler_deg: (10.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Left eye
        (
          shape: "Sphere",
          primitive: ( radius: Some(0.07), color: Some((0.08, 0.06, 0.05)), roughness: Some(0.2) ),
          offset: (-0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Right eye
        (
          shape: "Sphere",
          primitive: ( radius: Some(0.07), color: Some((0.08, 0.06, 0.05)), roughness: Some(0.2) ),
          offset: (0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Nose
        (
          shape: "Sphere",
          primitive: ( radius: Some(0.06), color: Some((0.95, 0.60, 0.42)), roughness: Some(0.5) ),
          offset: (0.0, 1.50, -0.40),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Hostile Goblin Guard ─────────────────────────────────────────────────
    // Patrols a small area. Chases aggressively; requires LOS (walls block
    // detection). 200° wide arc — nearly all-around but still has a small
    // rear blind spot. Emits a growl when it spots or reaches the player.
    "npc_goblin_guard": (
      kind: "primitive",
      model: "Capsule3d",
      components: (
        tags: ["npc"],
        sounds: {
          "spotted": "goblin_growl",
          "reached": "goblin_growl",
        },
        npc: Some((
          faction: Hostile,
          on_player_near: Chase,
          detection_radius: 8.0,
          chase_radius: 20.0,
          fov_degrees: Some(200.0),
          requires_los: true,
          approach_distance: 1.5,
          patrol_speed: 2.2,
          chase_speed: 5.5,
          patrol_waypoints: [
            (-4.0, 0.0,  0.0),
            ( 4.0, 0.0,  0.0),
            ( 0.0, 0.0, -4.0),
          ],
        )),
      ),
      primitive: Some((
        radius: Some(0.38),
        height: Some(1.6),
        color: Some((0.55, 0.22, 0.18)),
        roughness: Some(0.7),
        metallic: Some(0.05),
      )),
      children: [
        // Body — centred at body_y=0.8 (radius=0.38, cap_half=0.42).
        (
          shape: "Capsule3d",
          primitive: (
            radius: Some(0.38),
            height: Some(1.6),
            color: Some((0.55, 0.22, 0.18)),
            roughness: Some(0.7),
            metallic: Some(0.05),
          ),
          offset: (0.0, 0.8, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // shoulders
        (
          shape: "Capsule3d",
          primitive: (
            radius: Some(0.36),
            height: Some(1.2),
            color: Some((0.55, 0.22, 0.18)),
            roughness: Some(0.7),
            metallic: Some(0.05),
          ),
          offset: (0.0, 0.9, 0.0),
          rotation_euler_deg: (0.0, 0.0, 90.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Left eye — slanted inward for an angry look
        (
          shape: "Sphere",
          primitive: ( radius: Some(0.07), color: Some((0.80, 0.10, 0.05)), roughness: Some(0.1), metallic: Some(0.1) ),
          offset: (-0.16, 1.42, -0.33),
          rotation_euler_deg: (0.0, 0.0, 15.0),
          scale: (1.0, 1.4, 1.0),
        ),
        // Right eye — mirrored
        (
          shape: "Sphere",
          primitive: ( radius: Some(0.07), color: Some((0.80, 0.10, 0.05)), roughness: Some(0.1), metallic: Some(0.1) ),
          offset: (0.16, 1.42, -0.33),
          rotation_euler_deg: (0.0, 0.0, -15.0),
          scale: (1.0, 1.4, 1.0),
        ),
        // Snout
        (
          shape: "Sphere",
          primitive: ( radius: Some(0.08), color: Some((0.42, 0.18, 0.14)), roughness: Some(0.8) ),
          offset: (0.0, 1.32, -0.38),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 0.7, 1.0),
        ),
      ],
    ),

    // ── Neutral Merchant ─────────────────────────────────────────────────────
    // Stands still; reacts only when the player walks directly in front
    // (narrow 60° FOV). Does not move — just acknowledges the player.
    // Emits a greeting sound when spotted.
    "npc_merchant": (
      kind: "primitive",
      model: "Capsule3d",
      components: (
        tags: ["npc"],
        sounds: {
          "spotted": "npc_greet",
        },
        npc: Some((
          faction: Neutral,
          on_player_near: Alert,
          detection_radius: 4.0,
          chase_radius: 6.0,
          fov_degrees: Some(60.0),
          requires_los: false,
          approach_distance: 2.0,
          patrol_speed: 1.0,
          chase_speed: 1.0,
          patrol_waypoints: [],
        )),
      ),
      primitive: Some((
        radius: Some(0.42),
        height: Some(1.85),
        color: Some((0.40, 0.25, 0.60)),
        roughness: Some(0.4),
        metallic: Some(0.1),
      )),
      children: [
        // Body — centred at body_y=0.925 (radius=0.42, cap_half=0.505).
        (
          shape: "Capsule3d",
          primitive: (
            radius: Some(0.42),
            height: Some(1.85),
            color: Some((0.40, 0.25, 0.60)),
            roughness: Some(0.4),
            metallic: Some(0.1),
          ),
          offset: (0.0, 0.925, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Left eye — wide & round, friendly look
        (
          shape: "Sphere",
          primitive: ( radius: Some(0.08), color: Some((0.05, 0.05, 0.08)), roughness: Some(0.15) ),
          offset: (-0.19, 1.62, -0.38),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Right eye
        (
          shape: "Sphere",
          primitive: ( radius: Some(0.08), color: Some((0.05, 0.05, 0.08)), roughness: Some(0.15) ),
          offset: (0.19, 1.62, -0.38),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Nose
        (
          shape: "Sphere",
          primitive: ( radius: Some(0.06), color: Some((0.85, 0.55, 0.38)), roughness: Some(0.45) ),
          offset: (0.0, 1.52, -0.42),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Block of player hight ─────────────────────────────────────────────────────────────────
    // For testing jumping
    "block_of_player_hight": (
      kind: "primitive",
      model: "Cuboid",
      components: (),
      primitive: Some((
        size: Some((2.0, 1.6, 2.0)),
        color: Some((0.65, 0.60, 0.50)),
        roughness: Some(0.98),
        physics: true,
      )),
    ),

    // ── Ground ─────────────────────────────────────────────────────────────────
    // Large flat Cuboid with physics: true gives the player a surface to walk on.
    "ground_plane": (
      kind: "primitive",
      model: "Cuboid",
      components: (),
      primitive: Some((
        size: Some((80.0, 1.0, 80.0)),
        color: Some((0.32, 0.52, 0.22)),
        roughness: Some(0.95),
        physics: true,
      )),
    ),

    // ── Path stone ─────────────────────────────────────────────────────────────
    "path_stone": (
      kind: "primitive",
      model: "Cuboid",
      material: Some("mat_stone_floor"),
      components: (),
      primitive: Some((
        size: Some((2.0, 0.06, 2.0)),
      )),
    ),

    // ── Rocks ──────────────────────────────────────────────────────────────────
    "rock_small": (
      kind: "primitive",
      model: "Sphere",
      material: Some("mat_cliff_rock"),
      components: (),
      primitive: Some((
        radius: Some(0.3),
      )),
    ),

    "rock_medium": (
      kind: "primitive",
      model: "Sphere",
      material: Some("mat_cliff_rock"),
      components: (),
      primitive: Some((
        radius: Some(0.55),
      )),
    ),

    // ── Barrel ─────────────────────────────────────────────────────────────────
    // Half-length = 0.5 → total height = 1.0 + 2*0.3 = 1.6 doesn't apply here.
    // Cylinder height param is full height. Place center at y = height/2 in scene.
    "barrel": (
      kind: "primitive",
      model: "Cylinder",
      material: Some("mat_wood_planks"),
      components: (),
      primitive: Some((
        radius: Some(0.28),
        height: Some(0.9),
      )),
    ),

    // ── Fence elements ─────────────────────────────────────────────────────────
    "fence_post": (
      kind: "primitive",
      model: "Cylinder",
      material: Some("mat_wood_planks"),
      components: (),
      primitive: Some((
        radius: Some(0.08),
        height: Some(1.5),
      )),
    ),

    // X-aligned plank; rotate 90° Y in the scene to make it Z-facing.
    "fence_rail": (
      kind: "primitive",
      model: "Cuboid",
      material: Some("mat_wood_planks"),
      components: (),
      primitive: Some((
        size: Some((2.0, 0.1, 0.1)),
      )),
    ),

    // ── Pond ───────────────────────────────────────────────────────────────────
    // Stone basin: floor slab + 4 border beams + animated water surface.
    // Entity origin at y=0 (ground level).
    // Outer footprint: 7.0 × 12.0.  Beam width: 0.5.  Inner water: 6.0 × 11.0.
    // Beams extend to y=0.35; water surface sits at y=0.27 (below the rim).
    "pond": (
      kind: "primitive",
      model: "",
      components: (),
      children: [

        // Stone floor inside the basin (slightly above ground to avoid z-fighting)
        (
          shape: "Cuboid",
          material: Some("mat_stone_mossy"),
          primitive: ( size: Some((6.0, 0.06, 11.0)) ),
          offset: (0.0, 0.03, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // North border beam — full outer width
        (
          shape: "Cuboid",
          material: Some("mat_stone_bricks"),
          primitive: ( size: Some((7.0, 0.35, 0.5)) ),
          offset: (0.0, 0.175, 5.75),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // South border beam — full outer width
        (
          shape: "Cuboid",
          material: Some("mat_stone_bricks"),
          primitive: ( size: Some((7.0, 0.35, 0.5)) ),
          offset: (0.0, 0.175, -5.75),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // East border beam — inner length (fits between north/south beams, no corner overlap)
        (
          shape: "Cuboid",
          material: Some("mat_stone_bricks"),
          primitive: ( size: Some((0.5, 0.35, 11.0)) ),
          offset: (3.25, 0.175, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // West border beam — inner length
        (
          shape: "Cuboid",
          material: Some("mat_stone_bricks"),
          primitive: ( size: Some((0.5, 0.35, 11.0)) ),
          offset: (-3.25, 0.175, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // Animated water surface — sits inside the beams
        (
          shape: "Cuboid",
          material: Some("mat_water"),
          primitive: ( size: Some((6.0, 0.04, 11.0)) ),
          offset: (0.0, 0.27, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

      ],
    ),

    // ── Collectible coin ──────────────────────────────────────────────────────
    // Flat gold Cylinder placed upright (rotation_euler_deg: (90,0,0) in the
    // scene).  motion.rotate spins it around world Y for the classic coin look.
    // sensor: true → ghost collider; sounds.collect → catalog key for pickup SFX.
    // mat_coin_pulse adds an additive gold pulse so the coin glows and breathes,
    // making it easier to spot from a distance.
    "coin_collectible": (
      kind: "primitive",
      model: "Cylinder",
      material: Some("mat_coin_pulse"),
      components: (
        tags: ["collectable"],
        sounds: {
          "collect": "collect_coin",
        },
      ),
      primitive: Some((
        radius: Some(0.42),
        height: Some(0.12),
        sensor: true,
      )),
      motion: Some((
        rotate: Some((0.0, 1.5, 0.0)),
      )),
    ),

    // ── Floating decorations ───────────────────────────────────────────────────
    "deco_orb_gold": (
      kind: "primitive",
      model: "Sphere",
      material: Some("mat_deco_orb_gold"),
      components: (),
      primitive: Some((
        radius: Some(0.55),
      )),
    ),

    "deco_orb_violet": (
      kind: "primitive",
      model: "Sphere",
      material: Some("mat_deco_orb_violet"),
      components: (),
      primitive: Some((
        radius: Some(0.45),
      )),
    ),

    "deco_torus_copper": (
      kind: "primitive",
      model: "Torus",
      components: (),
      primitive: Some((
        radius: Some(1.2),
        radius_top: Some(0.22),
        color: Some((0.80, 0.42, 0.18)),
        roughness: Some(0.25),
        metallic: Some(0.75),
      )),
    ),

    // ── Composite prefabs ──────────────────────────────────────────────────────
    //
    // All children use offsets relative to the parent entity's origin (base of object).
    // Geometry notes:
    //   Cylinder(h): center at 0 → bottom = -h/2, top = +h/2
    //   Cone(h):     base at -h/2, apex at +h/2 (apex pointing up)
    //   Cuboid(y):   center at 0 → bottom = -y/2, top = +y/2
    //   ConicalFrustum(h): center at 0 → bottom = -h/2, top = +h/2
    //   Sphere(r):   center at 0, bottom = -r, top = +r

    // ── Pine tree (cylinder trunk + cone canopy) ────────────────────────────
    "tree_pine": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        (
          shape: "Cylinder",
          material: Some("mat_bark"),
          primitive: (
            radius: Some(0.22),
            height: Some(3.0),
          ),
          // h=3 → center at 1.5 so bottom sits at y=0
          offset: (0.0, 1.5, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Cone",
          primitive: (
            radius: Some(1.30),
            height: Some(4.0),
            color: Some((0.14, 0.44, 0.14)),
            roughness: Some(0.90),
          ),
          // h=4 → base at y=-2; to sit on trunk top (y=3): center at 3+2 = 5
          offset: (0.0, 5.0, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Round tree (cylinder trunk + sphere canopy) ─────────────────────────
    "tree_round": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        (
          shape: "Cylinder",
          material: Some("mat_bark"),
          primitive: (
            radius: Some(0.25),
            height: Some(2.5),
          ),
          offset: (0.0, 1.25, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Sphere",
          primitive: (
            radius: Some(1.40),
            color: Some((0.20, 0.52, 0.18)),
            roughness: Some(0.90),
          ),
          // Trunk top at y=2.5; sphere bottom = y-r → center at 2.5+1.4 = 3.9
          offset: (0.0, 3.9, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Cottage house (cuboid body + conical-frustum roof + cylinder chimney) ─
    "house_cottage": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        (
          shape: "Cuboid",
          material: Some("mat_wall_plaster"),
          primitive: (
            size: Some((5.0, 4.0, 6.0)),
          ),
          // h=4 → center at 2.0 so bottom sits at y=0
          offset: (0.0, 2.0, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "ConicalFrustum",
          material: Some("mat_roof_tiles"),
          primitive: (
            radius: Some(3.2),
            radius_top: Some(0.3),
            height: Some(2.5),
          ),
          // Body top at y=4; frustum h=2.5 → center at 4+1.25 = 5.25
          offset: (0.0, 5.25, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Cylinder",
          material: Some("mat_stone_bricks"),
          primitive: (
            radius: Some(0.24),
            height: Some(1.4),
          ),
          // Protrudes from the roof slope near the ridge
          offset: (1.2, 6.1, 1.4),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Small house (cuboid body + cone roof) ───────────────────────────────
    "house_small": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
