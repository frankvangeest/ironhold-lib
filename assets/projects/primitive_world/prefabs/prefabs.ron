    // ── Village (nested-prefab demo: cobblestone square + cottage + small house + well) ──
    // Demonstrates nested prefab composition: child entries reference other named prefabs
    // by key.  Transforms are multiplicative — each nested prefab's own children inherit
    // the anchor's world-space position and rotation.
    //
    // Layout (X, Z relative to village origin):
    //   house_cottage  at (-6,  -4)   facing forward
    //   house_small    at ( 6,  -4)   rotated 90° CW
    //   well           at ( 0,  -4)   centre square
    //   Square paving  inline Cuboid at (0, -0.01, -1) — slightly below ground to avoid z-fight
    "village": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        // Cobblestone plaza — inline Cuboid, flush with ground
        (
          shape: "Cuboid",
          material: Some("mat_stone_cobble"),
          primitive: (
            size: Some((18.0, 0.02, 14.0)),
          ),
          offset: (0.0, 0.01, -1.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Cottage house — nested prefab reference
        (
          prefab: Some("house_cottage"),
          offset: (-6.0, 0.0, -4.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Small house — nested prefab, rotated 90° around Y
        (
          prefab: Some("house_small"),
          offset: (6.0, 0.0, -4.0),
          rotation_euler_deg: (0.0, 90.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Well — nested prefab at village centre
        (
          prefab: Some("well"),
          offset: (0.0, 0.0, -4.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

  }
)
