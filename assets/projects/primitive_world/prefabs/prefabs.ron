(
  schema_version: 1,
  prefabs: {

    // ── Player ─────────────────────────────────────────────────────────────────
    // Capsule3d with `tags: ["player"]` is detected by the runtime and spawned
    // with a CharacterController, Rapier physics, and an OrbitCamera.
    // Children add a cap and face features so the front is clearly visible.
    // All child offsets are relative to the entity origin = feet = ground contact (y=0).
    // Capsule: radius=0.4, height=1.8 → extends from y=0 (feet) to y=1.8 (top).
    "player_capsule": (
      kind: "primitive",
      model: "Capsule3d",
      components: (
        tags: ["player"],
        sounds: {
          "jump": "jump",
        },
        movement: (
          walk_speed: 5.5,
          run_speed: 10.0,
          //jump: Fixed(height: 1.8),
          jump: RelativeToHeight(percent: 100.0),
          double_jump: true,
        ),
      ),
      primitive: (
        radius: 0.4,
        height: 1.8,
        color: (0.22, 0.52, 0.88),
        roughness: 0.3,
        metallic: 0.15,
      ),
      children: [

        // ── Left eye (player faces −Z, so front is negative Z) ───────────
        // Eye level at y=0.68 above capsule centre → y=0.68+0.9=1.58 above feet.
        (
          shape: "Sphere",
          primitive: (
            radius: 0.07,
            color: (0.03, 0.03, 0.05),
            roughness: 0.20,
            metallic: 0.10,
          ),
          offset: (-0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // ── Right eye ────────────────────────────────────────────────────
        (
          shape: "Sphere",
          primitive: (
            radius: 0.07,
            color: (0.03, 0.03, 0.05),
            roughness: 0.20,
            metallic: 0.10,
          ),
          offset: (0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // ── Nose ─────────────────────────────────────────────────────────
        // Nose at y=0.59 above capsule centre → y=0.59+0.9=1.49 above feet.
        (
          shape: "Sphere",
          primitive: (
            radius: 0.07,
            color: (0.95, 0.58, 0.42),
            roughness: 0.40,
          ),
          offset: (0.0, 1.49, -0.40),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ══════════════════════════════════════════════════════════════════════════
    // NPC capsule archetypes
    //
    // All NPC prefabs follow the same structure as the player capsule:
    //   • top-level `primitive` defines body shape (capsule radius + height) —
    //     these params drive the physics collider in the spawner.
    //   • `children` adds visual face features (eyes, nose) so the front is
    //     clearly visible even without a 3-D model.
    //   • `components.npc` configures the AI behaviour loaded at spawn time.
    //
    // Events emitted into the rules pipeline:
    //   "npc.player_spotted:{id}"  — player entered detection zone
    //   "npc.player_reached:{id}"  — NPC closed to approach_distance
    //   "npc.player_lost:{id}"     — NPC gave up chasing
    // ══════════════════════════════════════════════════════════════════════════

    // ── Friendly Villager ───────────────────────────────────────────────────
    // Patrols two waypoints near the village area. Approaches the player
    // with a 120° forward-cone detection (can be sneaked from behind).
    // Greets the player with a sound when approached.
    "npc_villager": (
      kind: "primitive",
      model: "Capsule3d",
      components: (
        tags: ["npc"],
        sounds: {
          "spotted": "npc_greet",
          "reached": "npc_greet",
        },
        npc: (
          faction: Friendly,
          on_player_near: Interact,
          detection_radius: 6.0,
          chase_radius: 10.0,
          fov_degrees: 120.0,
          requires_los: false,
          approach_distance: 2.5,
          patrol_speed: 1.8,
          chase_speed: 2.8,
          patrol_waypoints: [
            (-5.0, 0.0, 0.0),
            (5.0,  0.0, 0.0),
          ],
        ),
      ),
      primitive: (
        radius: 0.4,
        height: 1.8,
        color: (0.85, 0.65, 0.40),
        roughness: 0.65,
        metallic: 0.0,
      ),
      children: [
        // Body — capsule centred at body_y=0.9 so its bottom aligns with the
        // entity origin (feet at y=0).  All face-feature offsets below are also
        // measured from the feet origin, consistent with the player prefab.
        (
          shape: "Capsule3d",
          primitive: (
            radius: 0.4,
            height: 1.8,
            color: (0.85, 0.65, 0.40),
            roughness: 0.65,
            metallic: 0.0,
          ),
          offset: (0.0, 0.9, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // hat
        (
          shape: "Cylinder",
          primitive: (
            radius: 0.28,
            height: 0.2,
            color: (0.38, 0.24, 0.12),
            roughness: 0.88,
          ),
          offset: (0.0, 1.8, 0.1),
          rotation_euler_deg: (10.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Left eye
        (
          shape: "Sphere",
          primitive: ( radius: 0.07, color: (0.08, 0.06, 0.05), roughness: 0.2 ),
          offset: (-0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Right eye
        (
          shape: "Sphere",
          primitive: ( radius: 0.07, color: (0.08, 0.06, 0.05), roughness: 0.2 ),
          offset: (0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Nose
        (
          shape: "Sphere",
          primitive: ( radius: 0.06, color: (0.95, 0.60, 0.42), roughness: 0.5 ),
          offset: (0.0, 1.50, -0.40),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Hostile Goblin Guard ─────────────────────────────────────────────────
    // Patrols a small area. Chases aggressively; requires LOS (walls block
    // detection). 200° wide arc — nearly all-around but still has a small
    // rear blind spot. Emits a growl when it spots or reaches the player.
    "npc_goblin_guard": (
      kind: "primitive",
      model: "Capsule3d",
      components: (
        tags: ["npc"],
        sounds: {
          "spotted": "goblin_growl",
          "reached": "goblin_growl",
        },
        npc: (
          faction: Hostile,
          on_player_near: Chase,
          detection_radius: 8.0,
          chase_radius: 20.0,
          fov_degrees: 200.0,
          requires_los: true,
          approach_distance: 1.5,
          patrol_speed: 2.2,
          chase_speed: 5.5,
          patrol_waypoints: [
            (-4.0, 0.0,  0.0),
            ( 4.0, 0.0,  0.0),
            ( 0.0, 0.0, -4.0),
          ],
        ),
      ),
      primitive: (
        radius: 0.38,
        height: 1.6,
        color: (0.55, 0.22, 0.18),
        roughness: 0.7,
        metallic: 0.05,
      ),
      children: [
        // Body — centred at body_y=0.8 (radius=0.38, cap_half=0.42).
        (
          shape: "Capsule3d",
          primitive: (
            radius: 0.38,
            height: 1.6,
            color: (0.55, 0.22, 0.18),
            roughness: 0.7,
            metallic: 0.05,
          ),
          offset: (0.0, 0.8, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // shoulders
        (
          shape: "Capsule3d",
          primitive: (
            radius: 0.36,
            height: 1.2,
            color: (0.55, 0.22, 0.18),
            roughness: 0.7,
            metallic: 0.05,
          ),
          offset: (0.0, 0.9, 0.0),
          rotation_euler_deg: (0.0, 0.0, 90.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Left eye — slanted inward for an angry look
        (
          shape: "Sphere",
          primitive: ( radius: 0.07, color: (0.80, 0.10, 0.05), roughness: 0.1, metallic: 0.1 ),
          offset: (-0.16, 1.42, -0.33),
          rotation_euler_deg: (0.0, 0.0, 15.0),
          scale: (1.0, 1.4, 1.0),
        ),
        // Right eye — mirrored
        (
          shape: "Sphere",
          primitive: ( radius: 0.07, color: (0.80, 0.10, 0.05), roughness: 0.1, metallic: 0.1 ),
          offset: (0.16, 1.42, -0.33),
          rotation_euler_deg: (0.0, 0.0, -15.0),
          scale: (1.0, 1.4, 1.0),
        ),
        // Snout
        (
          shape: "Sphere",
          primitive: ( radius: 0.08, color: (0.42, 0.18, 0.14), roughness: 0.8 ),
          offset: (0.0, 1.32, -0.38),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 0.7, 1.0),
        ),
      ],
      interactable: (radius: 2.5, hint_text: "F  Attack!"),
    ),

    // ── Neutral Merchant ─────────────────────────────────────────────────────
    // Stands still; reacts only when the player walks directly in front
    // (narrow 60° FOV). Does not move — just acknowledges the player.
    // Emits a greeting sound when spotted.
    "npc_merchant": (
      kind: "primitive",
      model: "Capsule3d",
      components: (
        tags: ["npc"],
        sounds: {
          "spotted": "npc_greet",
        },
        npc: (
          faction: Neutral,
          on_player_near: Alert,
          detection_radius: 4.0,
          chase_radius: 6.0,
          fov_degrees: 60.0,
          requires_los: false,
          approach_distance: 2.0,
          patrol_speed: 1.0,
          chase_speed: 1.0,
          patrol_waypoints: [],
        ),
      ),
      primitive: (
        radius: 0.42,
        height: 1.85,
        color: (0.40, 0.25, 0.60),
        roughness: 0.4,
        metallic: 0.1,
      ),
      children: [
        // Body — centred at body_y=0.925 (radius=0.42, cap_half=0.505).
        (
          shape: "Capsule3d",
          primitive: (
            radius: 0.42,
            height: 1.85,
            color: (0.40, 0.25, 0.60),
            roughness: 0.4,
            metallic: 0.1,
          ),
          offset: (0.0, 0.925, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Left eye — wide & round, friendly look
        (
          shape: "Sphere",
          primitive: ( radius: 0.08, color: (0.05, 0.05, 0.08), roughness: 0.15 ),
          offset: (-0.19, 1.62, -0.38),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Right eye
        (
          shape: "Sphere",
          primitive: ( radius: 0.08, color: (0.05, 0.05, 0.08), roughness: 0.15 ),
          offset: (0.19, 1.62, -0.38),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Nose
        (
          shape: "Sphere",
          primitive: ( radius: 0.06, color: (0.85, 0.55, 0.38), roughness: 0.45 ),
          offset: (0.0, 1.52, -0.42),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Block of player hight ─────────────────────────────────────────────────────────────────
    // For testing jumping
    "block_of_player_hight": (
      kind: "primitive",
      model: "Cuboid",
      components: (),
      primitive: (
        size: (2.0, 1.6, 2.0),
        color: (0.65, 0.60, 0.50),
        roughness: 0.98,
        physics: true,
      ),
    ),

    // ── Ground ─────────────────────────────────────────────────────────────────
    // Large flat Cuboid with physics: true gives the player a surface to walk on.
    "ground_plane": (
      kind: "primitive",
      model: "Cuboid",
      components: (),
      primitive: (
        size: (80.0, 1.0, 80.0),
        color: (0.32, 0.52, 0.22),
        roughness: 0.95,
        physics: true,
      ),
    ),

    // ── Path stone ─────────────────────────────────────────────────────────────
    "path_stone": (
      kind: "primitive",
      model: "Cuboid",
      material: "mat_stone_floor",
      components: (),
      primitive: (
        size: (2.0, 0.06, 2.0),
      ),
    ),

    // ── Rocks ──────────────────────────────────────────────────────────────────
    "rock_small": (
      kind: "primitive",
      model: "Sphere",
      material: "mat_cliff_rock",
      components: (),
      primitive: (
        radius: 0.3,
      ),
    ),

    "rock_medium": (
      kind: "primitive",
      model: "Sphere",
      material: "mat_cliff_rock",
      components: (),
      primitive: (
        radius: 0.55,
      ),
    ),

    // ── Barrel ─────────────────────────────────────────────────────────────────
    // Half-length = 0.5 → total height = 1.0 + 2*0.3 = 1.6 doesn't apply here.
    // Cylinder height param is full height. Place center at y = height/2 in scene.
    "barrel": (
      kind: "primitive",
      model: "Cylinder",
      material: "mat_wood_planks",
      components: (),
      primitive: (
        radius: 0.28,
        height: 0.9,
      ),
    ),

    // ── Fence elements ─────────────────────────────────────────────────────────
    "fence_post": (
      kind: "primitive",
      model: "Cylinder",
      material: "mat_wood_planks",
      components: (),
      primitive: (
        radius: 0.08,
        height: 1.5,
      ),
    ),

    // X-aligned plank; rotate 90° Y in the scene to make it Z-facing.
    "fence_rail": (
      kind: "primitive",
      model: "Cuboid",
      material: "mat_wood_planks",
      components: (),
      primitive: (
        size: (2.0, 0.1, 0.1),
      ),
    ),

    // ── Pond ───────────────────────────────────────────────────────────────────
    // Stone basin: floor slab + 4 border beams + animated water surface.
    // Entity origin at y=0 (ground level).
    // Outer footprint: 7.0 × 12.0.  Beam width: 0.5.  Inner water: 6.0 × 11.0.
    // Beams extend to y=0.35; water surface sits at y=0.27 (below the rim).
    "pond": (
      kind: "primitive",
      model: "",
      components: (),
      children: [

        // Stone floor inside the basin (slightly above ground to avoid z-fighting)
        (
          shape: "Cuboid",
          material: "mat_stone_mossy",
          primitive: ( size: (6.0, 0.06, 11.0) ),
          offset: (0.0, 0.03, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // North border beam — full outer width
        (
          shape: "Cuboid",
          material: "mat_stone_bricks",
          primitive: ( size: (7.0, 0.35, 0.5) ),
          offset: (0.0, 0.175, 5.75),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // South border beam — full outer width
        (
          shape: "Cuboid",
          material: "mat_stone_bricks",
          primitive: ( size: (7.0, 0.35, 0.5) ),
          offset: (0.0, 0.175, -5.75),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // East border beam — inner length (fits between north/south beams, no corner overlap)
        (
          shape: "Cuboid",
          material: "mat_stone_bricks",
          primitive: ( size: (0.5, 0.35, 11.0) ),
          offset: (3.25, 0.175, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // West border beam — inner length
        (
          shape: "Cuboid",
          material: "mat_stone_bricks",
          primitive: ( size: (0.5, 0.35, 11.0) ),
          offset: (-3.25, 0.175, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // Animated water surface — sits inside the beams
        (
          shape: "Cuboid",
          material: "mat_water",
          primitive: ( size: (6.0, 0.04, 11.0) ),
          offset: (0.0, 0.27, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

      ],
    ),

    // ── Collectible coin ──────────────────────────────────────────────────────
    // Flat gold Cylinder placed upright (rotation_euler_deg: (90,0,0) in the
    // scene).  motion.rotate spins it around world Y for the classic coin look.
    // sensor: true → ghost collider; sounds.collect → catalog key for pickup SFX.
    // mat_coin_pulse adds an additive gold pulse so the coin glows and breathes,
    // making it easier to spot from a distance.
    "coin_collectible": (
      kind: "primitive",
      model: "Cylinder",
      material: "mat_coin_pulse",
      components: (
        tags: ["collectable"],
        sounds: {
          "collect": "collect_coin",
        },
      ),
      primitive: (
        radius: 0.42,
        height: 0.12,
        sensor: true,
      ),
      motion: (
        rotate: (0.0, 1.5, 0.0),
      ),
    ),

    // ── Floating decorations ───────────────────────────────────────────────────
    "deco_orb_gold": (
      kind: "primitive",
      model: "Sphere",
      material: "mat_deco_orb_gold",
      components: (),
      primitive: (
        radius: 0.55,
      ),
    ),

    "deco_orb_violet": (
      kind: "primitive",
      model: "Sphere",
      material: "mat_deco_orb_violet",
      components: (),
      primitive: (
        radius: 0.45,
      ),
    ),

    "deco_torus_copper": (
      kind: "primitive",
      model: "Torus",
      components: (),
      primitive: (
        radius: 1.2,
        radius_top: 0.22,
        color: (0.80, 0.42, 0.18),
        roughness: 0.25,
        metallic: 0.75,
      ),
    ),

    // ── Composite prefabs ──────────────────────────────────────────────────────
    //
    // All children use offsets relative to the parent entity's origin (base of object).
    // Geometry notes:
    //   Cylinder(h): center at 0 → bottom = -h/2, top = +h/2
    //   Cone(h):     base at -h/2, apex at +h/2 (apex pointing up)
    //   Cuboid(y):   center at 0 → bottom = -y/2, top = +y/2
    //   ConicalFrustum(h): center at 0 → bottom = -h/2, top = +h/2
    //   Sphere(r):   center at 0, bottom = -r, top = +r

    // ── Pine tree (cylinder trunk + cone canopy) ────────────────────────────
    "tree_pine": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        (
          shape: "Cylinder",
          material: "mat_bark",
          primitive: (
            radius: 0.22,
            height: 3.0,
          ),
          // h=3 → center at 1.5 so bottom sits at y=0
          offset: (0.0, 1.5, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Cone",
          primitive: (
            radius: 1.30,
            height: 4.0,
            color: (0.14, 0.44, 0.14),
            roughness: 0.90,
          ),
          // h=4 → base at y=-2; to sit on trunk top (y=3): center at 3+2 = 5
          offset: (0.0, 5.0, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Round tree (cylinder trunk + sphere canopy) ─────────────────────────
    "tree_round": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        (
          shape: "Cylinder",
          material: "mat_bark",
          primitive: (
            radius: 0.25,
            height: 2.5,
          ),
          offset: (0.0, 1.25, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Sphere",
          primitive: (
            radius: 1.40,
            color: (0.20, 0.52, 0.18),
            roughness: 0.90,
          ),
          // Trunk top at y=2.5; sphere bottom = y-r → center at 2.5+1.4 = 3.9
          offset: (0.0, 3.9, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Cottage house (cuboid body + conical-frustum roof + cylinder chimney) ─
    "house_cottage": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        (
          shape: "Cuboid",
          material: "mat_wall_plaster",
          primitive: (
            size: (5.0, 4.0, 6.0),
          ),
          // h=4 → center at 2.0 so bottom sits at y=0
          offset: (0.0, 2.0, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "ConicalFrustum",
          material: "mat_roof_tiles",
          primitive: (
            radius: 3.2,
            radius_top: 0.3,
            height: 2.5,
          ),
          // Body top at y=4; frustum h=2.5 → center at 4+1.25 = 5.25
          offset: (0.0, 5.25, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Cylinder",
          material: "mat_stone_bricks",
          primitive: (
            radius: 0.24,
            height: 1.4,
          ),
          // Protrudes from the roof slope near the ridge
          offset: (1.2, 6.1, 1.4),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Small house (cuboid body + cone roof) ───────────────────────────────
    "house_small": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        (
          shape: "Cuboid",
          material: "mat_wall_plaster",
          primitive: (
            size: (4.0, 3.0, 4.0),
          ),
          offset: (0.0, 1.5, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "ConicalFrustum",
          material: "mat_thatched_roof",
          primitive: (
            radius: 2.6,
            radius_top: 0.2,
            height: 2.0,
          ),
          // Body top at y=3; frustum center at 3+1 = 4.0
          offset: (0.0, 4.0, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Well (cylinder base + two pillars + crossbeam) ─────────────────────
    "well": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        (
          shape: "Cylinder",
          material: "mat_stone_bricks",
          primitive: (
            radius: 0.70,
            height: 0.80,
          ),
          // Base: h=0.8 → center at 0.4
          offset: (0.0, 0.4, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Cylinder",
          material: "mat_stone_bricks",
          primitive: (
            radius: 0.10,
            height: 1.80,
          ),
          // Pillar left: bottom at y=0.8, h=1.8 → center at 0.8+0.9 = 1.7
          offset: (-0.55, 1.7, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Cylinder",
          material: "mat_stone_bricks",
          primitive: (
            radius: 0.10,
            height: 1.80,
          ),
          // Pillar right
          offset: (0.55, 1.7, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Cuboid",
          material: "mat_wood_planks",
          primitive: (
            size: (1.20, 0.12, 0.14),
          ),
          // Crossbeam at top of pillars: y = 0.8+1.8+0.06 = 2.66
          offset: (0.0, 2.66, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // Stone rim ring — outer edge (r=0.65+0.05=0.70) aligns with the cylinder wall.
        // Thinner tube (0.05) widens the inner opening to 0.60.
        (
          shape: "Torus",
          material: "mat_stone_bricks",
          primitive: (
            radius: 0.7,
            radius_top: 0.4,
          ),
          // Slightly above stone cylinder top (y=0.80) to avoid z-fighting.
          offset: (0.0, 0.82, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),

        // Water surface — fits inside torus inner opening (0.65−0.05=0.60).
        (
          shape: "Cylinder",
          material: "mat_water",
          primitive: (
            radius: 0.58,
            height: 0.03,
          ),
          offset: (0.0, 0.82, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Lamp post (thin cylinder post + glowing sphere orb) ────────────────
    "lamp_post": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        (
          shape: "Cylinder",
          primitive: (
            radius: 0.07,
            height: 3.5,
            color: (0.24, 0.24, 0.26),
            roughness: 0.50,
            metallic: 0.60,
          ),
          // h=3.5 → center at 1.75
          offset: (0.0, 1.75, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        (
          shape: "Sphere",
          material: "mat_lamp_orb",
          primitive: (
            radius: 0.22,
          ),
          // Post top at y=3.5; sphere center at 3.5+0.22 = 3.72
          offset: (0.0, 3.72, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Village (nested-prefab demo: cobblestone square + cottage + small house + well) ──
    // Demonstrates nested prefab composition: child entries reference other named prefabs
    // by key.  Transforms are multiplicative — each nested prefab's own children inherit
    // the anchor's world-space position and rotation.
    //
    // Layout (X, Z relative to village origin):
    //   house_cottage  at (-6,  -4)   facing forward
    //   house_small    at ( 6,  -4)   rotated 90° CW
    //   well           at ( 0,  -4)   centre square
    //   Square paving  inline Cuboid at (0, -0.01, -1) — slightly below ground to avoid z-fight
    "village": (
      kind: "primitive",
      model: "",
      components: (),
      children: [
        // Cobblestone plaza — inline Cuboid, flush with ground
        (
          shape: "Cuboid",
          material: "mat_stone_cobble",
          primitive: (
            size: (18.0, 0.02, 14.0),
          ),
          offset: (0.0, 0.01, -1.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Cottage house — nested prefab reference
        (
          prefab: "house_cottage",
          offset: (-6.0, 0.0, -4.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Small house — nested prefab, rotated 90° around Y
        (
          prefab: "house_small",
          offset: (6.0, 0.0, -4.0),
          rotation_euler_deg: (0.0, 90.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Well — nested prefab at village centre
        (
          prefab: "well",
          offset: (0.0, 0.0, -4.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

  }
)
