(
    schema_version: 1,
    initial_state: "menu",

    global_on: [],

    states: [
        (
            name: "menu",
            entry_actions: [],
            exit_actions: [],
            on: [
                ( event: "ui.button_pressed:start_game", do_actions: [ LoadScene("scenes/main.scene.ron") ] ),
                ( event: "ui.button_pressed:quit",       do_actions: [ Quit ] ),
            ],
        ),
        (
            name: "playing",
            entry_actions: [
                SetVariable("health", "100"),
                SetVariable("score", "0"),
                PlayMusicLoop("bg_music"),
                Preload("scenes/pause.scene.ron"),
                Preload("scenes/map.scene.ron"),
            ],
            exit_actions:  [ StopMusic ],
            on: [
                ( event: "ui.button_pressed:toggle_map", do_actions: [ ToggleOverlay("scenes/map.scene.ron") ] ),

                // Coin collectibles — each fires Despawn + sound + score + small health restore.
                // Picking up coins is the only way to recover health in the field.
                ( event: "entity.collected:coin_01", do_actions: [ Despawn("coin_01"), PlaySound("collect_coin"), IncrementVariable("score", 10), IncrementVariable("health", 5) ] ),
                ( event: "entity.collected:coin_02", do_actions: [ Despawn("coin_02"), PlaySound("collect_coin"), IncrementVariable("score", 10), IncrementVariable("health", 5) ] ),
                ( event: "entity.collected:coin_03", do_actions: [ Despawn("coin_03"), PlaySound("collect_coin"), IncrementVariable("score", 10), IncrementVariable("health", 5) ] ),
                ( event: "entity.collected:coin_04", do_actions: [ Despawn("coin_04"), PlaySound("collect_coin"), IncrementVariable("score", 10), IncrementVariable("health", 5) ] ),
                ( event: "entity.collected:coin_05", do_actions: [ Despawn("coin_05"), PlaySound("collect_coin"), IncrementVariable("score", 10), IncrementVariable("health", 5) ] ),

                // ── NPC events ──────────────────────────────────────────────────────────
                // Friendly villager — greets the player when spotted and when reached.
                ( event: "npc.player_spotted:villager_01", do_actions: [ PlaySound("npc_greet") ] ),
                ( event: "npc.player_reached:villager_01", do_actions: [ PlaySound("npc_greet") ] ),

                // Goblin guards — growl when spotted; deal 25 health damage and -10 score on contact.
                // Four hits from a single goblin would be lethal from full health.
                ( event: "npc.player_spotted:goblin_01",   do_actions: [ PlaySound("goblin_growl") ] ),
                ( event: "npc.player_reached:goblin_01",   do_actions: [ PlaySound("goblin_growl"), IncrementVariable("score", -10), IncrementVariable("health", -25) ] ),
                ( event: "npc.player_spotted:goblin_02",   do_actions: [ PlaySound("goblin_growl") ] ),
                ( event: "npc.player_reached:goblin_02",   do_actions: [ PlaySound("goblin_growl"), IncrementVariable("score", -10), IncrementVariable("health", -25) ] ),

                // Merchant — acknowledges the player with a greeting sound.
                ( event: "npc.player_spotted:merchant_01", do_actions: [ PlaySound("npc_greet") ] ),
            ],
        ),
        (
            name: "paused",
            entry_actions: [ LoadSceneOverlay("scenes/pause.scene.ron") ],
            exit_actions:  [ UnloadOverlay ],
            on: [
                ( event: "ui.button_pressed:pause_quit", do_actions: [ Quit ] ),
            ],
        ),
    ],

    transitions: [
        ( on: "scene.ready:start_menu", to: "menu" ),
        ( on: "scene.ready:main",       to: "playing" ),

        ( from: Some("playing"), on: "ui.button_pressed:toggle_pause", to: "paused" ),
        ( from: Some("paused"),  on: "ui.button_pressed:toggle_pause", to: "playing" ),
        ( from: Some("paused"),  on: "ui.button_pressed:resume",       to: "playing" ),
    ],
)
