(
    schema_version: 1,
    initial_state: "menu",

    global_on: [],

    states: [
        (
            name: "menu",
            entry_actions: [],
            exit_actions: [],
            on: [
                ( event: "ui.button_pressed:start_game", do_actions: [ LoadScene("scenes/main.scene.ron") ] ),
                ( event: "ui.button_pressed:quit",       do_actions: [ Quit ] ),
            ],
        ),
        (
            name: "playing",
            entry_actions: [ PlayMusicLoop("bg_music"), Preload("scenes/pause.scene.ron"), Preload("scenes/map.scene.ron") ],
            exit_actions:  [ StopMusic ],
            on: [
                ( event: "ui.button_pressed:toggle_map", do_actions: [ ToggleOverlay("scenes/map.scene.ron") ] ),

                // Coin collectibles — each fires Despawn + sound + score via the rules pipeline.
                // GameEvent::Trigger names pass through the interpreter unchanged,
                // so the namespaced string here matches exactly what the capability emits.
                ( event: "entity.collected:coin_01", do_actions: [ Despawn("coin_01"), PlaySound("collect_coin"), AddScore(10) ] ),
                ( event: "entity.collected:coin_02", do_actions: [ Despawn("coin_02"), PlaySound("collect_coin"), AddScore(10) ] ),
                ( event: "entity.collected:coin_03", do_actions: [ Despawn("coin_03"), PlaySound("collect_coin"), AddScore(10) ] ),
                ( event: "entity.collected:coin_04", do_actions: [ Despawn("coin_04"), PlaySound("collect_coin"), AddScore(10) ] ),
                ( event: "entity.collected:coin_05", do_actions: [ Despawn("coin_05"), PlaySound("collect_coin"), AddScore(10) ] ),
            ],
        ),
        (
            name: "paused",
            entry_actions: [ LoadSceneOverlay("scenes/pause.scene.ron") ],
            exit_actions:  [ UnloadOverlay ],
            on: [
                ( event: "ui.button_pressed:pause_quit", do_actions: [ Quit ] ),
            ],
        ),
    ],

    transitions: [
        ( on: "scene.ready:start_menu", to: "menu" ),
        ( on: "scene.ready:main",       to: "playing" ),

        ( from: Some("playing"), on: "ui.button_pressed:toggle_pause", to: "paused" ),
        ( from: Some("paused"),  on: "ui.button_pressed:toggle_pause", to: "playing" ),
        ( from: Some("paused"),  on: "ui.button_pressed:resume",       to: "playing" ),
    ],
)
