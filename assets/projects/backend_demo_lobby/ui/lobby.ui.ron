// Copy-and-edit snippet (not loaded by the engine): a lobby browser, a waiting room and a "started" panel for the project's online backend.
// Paste it into a scene's `ui:` list. The buttons and the show/hide rules are in logic/state_machine.ron; backend.ron needs
// `features: [Lobbies]` and the `lobby_names` the Create button uses.
// ROWS: the browser shows 5 (the engine writes up to 10). A rule cannot test a variable, so after every list the engine fires
// `lobby.row_filled:<n>` or `lobby.row_empty:<n>` for each row and the rules show or hide `row_<n>` from those. For a 6th row you need:
// a `row_6` Group with `lobby.6.name`/`.players`/`.host` labels and a `join_btn_6` (action `ui.join_6`), plus the rules `lobby.row_filled:6`,
// `lobby.row_empty:6` and `ui.button_pressed:join_6`. Hide every row on `scene.ready:main` and on `backend.signed_out`, or empty
// rows show blank labels and a Join button that does nothing useful before the first list arrives.
// WAITING ROOM: up to 4 members are shown (a lobby holds up to 8): `lobby.member_row_filled:<n>` / `lobby.member_row_empty:<n>` do the same.
// TEXT SIZE: a Label does not shrink its text or clip it, so text that is longer than the box spills over its neighbours. Budget about
// width / (font_size * 0.6) characters (see "Sizing text to its box" in docs/20_data_formats.md): the lobby name column fits about 14
// characters, the host column about 10; a lobby name can be up to 32, so widen the columns if yours are long.
// `demo_msg` is a friendly message your own rules write (the reason events, e.g. `lobby.join_failed:full`, pick the wording).
// Use plain ASCII (the engine font has no em-dash).
Group((
    id: "lobby",
    flex_direction: Column,
    gap: 10.0,
    children: [
        Label((id: "demo_msg_label", text: "", bind: "demo_msg", format: "{}", size: (600.0, 24.0), align: Left, font_size: 18.0)),
        Group((
            id: "browse",
            flex_direction: Column,
            gap: 6.0,
            padding: 10.0,
            background_color: (0.05, 0.05, 0.08, 0.85),
            children: [
                Label((id: "browse_title", text: "", bind: "lobby.count", format: "Open lobbies: {}", size: (500.0, 28.0), align: Left)),
                Group((
                    id: "row_1",
                    gap: 12.0,
                    children: [
                        Label((id: "lobby_name_1", text: "", bind: "lobby.1.name", format: "{}", size: (170.0, 26.0), align: Left, font_size: 20.0)),
                        Label((id: "lobby_players_1", text: "", bind: "lobby.1.players", format: "{}", size: (60.0, 26.0), align: Right, font_size: 20.0)),
                        Label((id: "lobby_host_1", text: "", bind: "lobby.1.host", format: "{}", size: (130.0, 26.0), align: Left, font_size: 20.0)),
                        Button((id: "join_btn_1", text: "Join", action: "ui.join_1", size: (80.0, 36.0))),
                    ],
                )),
                Group((
                    id: "row_2",
                    gap: 12.0,
                    children: [
                        Label((id: "lobby_name_2", text: "", bind: "lobby.2.name", format: "{}", size: (170.0, 26.0), align: Left, font_size: 20.0)),
                        Label((id: "lobby_players_2", text: "", bind: "lobby.2.players", format: "{}", size: (60.0, 26.0), align: Right, font_size: 20.0)),
                        Label((id: "lobby_host_2", text: "", bind: "lobby.2.host", format: "{}", size: (130.0, 26.0), align: Left, font_size: 20.0)),
                        Button((id: "join_btn_2", text: "Join", action: "ui.join_2", size: (80.0, 36.0))),
                    ],
                )),
                Group((
                    id: "row_3",
                    gap: 12.0,
                    children: [
                        Label((id: "lobby_name_3", text: "", bind: "lobby.3.name", format: "{}", size: (170.0, 26.0), align: Left, font_size: 20.0)),
                        Label((id: "lobby_players_3", text: "", bind: "lobby.3.players", format: "{}", size: (60.0, 26.0), align: Right, font_size: 20.0)),
                        Label((id: "lobby_host_3", text: "", bind: "lobby.3.host", format: "{}", size: (130.0, 26.0), align: Left, font_size: 20.0)),
                        Button((id: "join_btn_3", text: "Join", action: "ui.join_3", size: (80.0, 36.0))),
                    ],
                )),
                Group((
                    id: "row_4",
                    gap: 12.0,
                    children: [
                        Label((id: "lobby_name_4", text: "", bind: "lobby.4.name", format: "{}", size: (170.0, 26.0), align: Left, font_size: 20.0)),
                        Label((id: "lobby_players_4", text: "", bind: "lobby.4.players", format: "{}", size: (60.0, 26.0), align: Right, font_size: 20.0)),
                        Label((id: "lobby_host_4", text: "", bind: "lobby.4.host", format: "{}", size: (130.0, 26.0), align: Left, font_size: 20.0)),
                        Button((id: "join_btn_4", text: "Join", action: "ui.join_4", size: (80.0, 36.0))),
                    ],
                )),
                Group((
                    id: "row_5",
                    gap: 12.0,
                    children: [
                        Label((id: "lobby_name_5", text: "", bind: "lobby.5.name", format: "{}", size: (170.0, 26.0), align: Left, font_size: 20.0)),
                        Label((id: "lobby_players_5", text: "", bind: "lobby.5.players", format: "{}", size: (60.0, 26.0), align: Right, font_size: 20.0)),
                        Label((id: "lobby_host_5", text: "", bind: "lobby.5.host", format: "{}", size: (130.0, 26.0), align: Left, font_size: 20.0)),
                        Button((id: "join_btn_5", text: "Join", action: "ui.join_5", size: (80.0, 36.0))),
                    ],
                )),
                Group((
                    gap: 8.0,
                    children: [
                        Button((id: "create_btn", text: "Create lobby", action: "ui.create", size: (200.0, 44.0))),
                        Button((id: "refresh_btn", text: "Refresh", action: "ui.refresh", size: (150.0, 44.0))),
                    ],
                )),
            ],
        )),
        Group((
            id: "room",
            flex_direction: Column,
            gap: 6.0,
            padding: 10.0,
            background_color: (0.05, 0.05, 0.08, 0.85),
            children: [
                Label((id: "room_title", text: "", bind: "lobby.current.name", format: "Lobby: {}", size: (560.0, 28.0), align: Left)),
                Label((id: "room_players", text: "", bind: "lobby.current.players", format: "Players: {}", size: (560.0, 26.0), align: Left)),
                Group((
                    id: "member_row_1",
                    children: [
                        Label((id: "member_1", text: "", bind: "lobby.member.1.name", format: "1. {}", size: (300.0, 26.0), align: Left, font_size: 22.0)),
                    ],
                )),
                Group((
                    id: "member_row_2",
                    children: [
                        Label((id: "member_2", text: "", bind: "lobby.member.2.name", format: "2. {}", size: (300.0, 26.0), align: Left, font_size: 22.0)),
                    ],
                )),
                Group((
                    id: "member_row_3",
                    children: [
                        Label((id: "member_3", text: "", bind: "lobby.member.3.name", format: "3. {}", size: (300.0, 26.0), align: Left, font_size: 22.0)),
                    ],
                )),
                Group((
                    id: "member_row_4",
                    children: [
                        Label((id: "member_4", text: "", bind: "lobby.member.4.name", format: "4. {}", size: (300.0, 26.0), align: Left, font_size: 22.0)),
                    ],
                )),
                Group((
                    gap: 8.0,
                    children: [
                        Group((
                            id: "start_row",
                            children: [
                                Button((id: "start_btn", text: "Start", action: "ui.start", size: (150.0, 44.0))),
                            ],
                        )),
                        Button((id: "leave_btn", text: "Leave", action: "ui.leave", size: (150.0, 44.0))),
                    ],
                )),
            ],
        )),
        Group((
            id: "started",
            flex_direction: Column,
            gap: 6.0,
            padding: 10.0,
            background_color: (0.05, 0.05, 0.08, 0.85),
            children: [
                Label((id: "started_title", text: "The lobby was started.", size: (560.0, 28.0), align: Left)),
                Label((id: "started_note", text: "This is where a match would begin.", size: (560.0, 24.0), align: Left, font_size: 20.0)),
                Label((id: "started_note_2", text: "Online play is not built yet.", size: (560.0, 24.0), align: Left, font_size: 20.0)),
                Label((id: "started_players", text: "", bind: "lobby.current.players", format: "Players in this lobby: {}", size: (560.0, 26.0), align: Left)),
                Button((id: "started_leave_btn", text: "Back to the lobbies", action: "ui.leave", size: (240.0, 44.0))),
            ],
        )),
    ],
))
