(
    schema_version: 3,
    project_id: "effect_mayhem_demo",
    display_name: "Effect Mayhem Demo",

    initial_scene: "scenes/main.scene.ron",

    asset_catalog: "assets.ron",
    prefab_catalog: "prefabs/prefabs.ron",
    rules_path: "logic/rules.ron",

    // Deep night — near-black sky so every additive effect blazes against it.
    global_environment: (
        intensity: 50.0,
        fallback: (
            top_color:    (0.02, 0.02, 0.08),
            bottom_color: (0.01, 0.01, 0.04),
        ),
    ),

    global_key_bindings: {},

    primitive_default_color: (0.25, 0.23, 0.22),
)
