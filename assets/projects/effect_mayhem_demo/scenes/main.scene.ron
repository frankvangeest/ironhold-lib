(
  schema_version: 2,
  name: "main",
  tonemapping: AcesFitted,

  // Deep night: dark enough that additive particles blaze; warm point lights pool colour
  // around each station so the scene reads well even before particles fire.
  lighting: (
    ambient: (0.25, 0.28, 0.45),
    ambient_brightness: 100.0,

    directional: (
      color: (0.55, 0.65, 0.90),
      intensity: 8000.0,
      rotation_euler_deg: (-25.0, 40.0, 0.0),
      shadows_enabled: true,
    ),

    point_lights: [
      // Four campfire corners — warm orange pools
      ( position: (-12.0, 3.0, -12.0), color: (1.0, 0.55, 0.15), intensity: 20000.0, range: 16.0 ),
      ( position: ( 12.0, 3.0, -12.0), color: (1.0, 0.55, 0.15), intensity: 20000.0, range: 16.0 ),
      ( position: (-12.0, 3.0,  12.0), color: (1.0, 0.55, 0.15), intensity: 20000.0, range: 16.0 ),
      ( position: ( 12.0, 3.0,  12.0), color: (1.0, 0.55, 0.15), intensity: 20000.0, range: 16.0 ),
      // Lightning orbs — cyan arc between both positions
      ( position: (  0.0, 4.0, -11.0), color: (0.45, 0.80, 1.0), intensity: 22000.0, range: 20.0 ),
      // Magic shrines — dual violet wash
      ( position: (-18.0, 3.0, 0.0),   color: (0.75, 0.30, 1.0), intensity: 15000.0, range: 15.0 ),
      ( position: ( 18.0, 3.0, 0.0),   color: (0.75, 0.30, 1.0), intensity: 15000.0, range: 15.0 ),
    ],
  ),

  label_depth_scale: (
    reference_distance: 20.0,
    min_scale: 0.35,
  ),

  spawn_points: {},

  entities: [

    // ── Player ──────────────────────────────────────────────────────────────
    (
      id: "player_01",
      prefab: "player_capsule",
      transform: (
        translation: (0.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Arena floor ─────────────────────────────────────────────────────────
    (
