(
    schema_version: 1,
    // Every Button in scenes/main.scene.ron needs a handler here (ironhold validate reports `unreachable_trigger` otherwise).
    // Online answers arrive seconds later, while paused and across LoadScene, so they are bound in global_on.
    global_on: [
        ( event: "scene.ready:main", do_actions: [ SetVariable("score", "0"), SetVariable("demo_msg", "") ] ),

        // Nothing is requested until the visitor presses Sign in (no auto sign-in), so a page load never creates an account.
        ( event: "ui.button_pressed:sign_in",   do_actions: [ SetVariable("demo_msg", ""), SignIn ] ),
        ( event: "ui.button_pressed:sign_out",  do_actions: [ SignOut ] ),
        ( event: "ui.button_pressed:add_score", do_actions: [ IncrementVariable("score", 10) ] ),
        ( event: "ui.button_pressed:submit",    do_actions: [ SubmitScore(leaderboard: "best", score_var: "score") ] ),
        ( event: "ui.button_pressed:refresh",   do_actions: [ FetchLeaderboard(leaderboard: "best", count: 5) ] ),

        // Signing in automatically on start-up is off on purpose in this project (see above): bind `backend.ready` (the backend finished loading), not `scene.ready:main` -
        // a SignIn fired before that answers `backend.busy`. `backend.offline` means there is no usable backend at all.
        // ( event: "backend.ready", do_actions: [ SignIn ] ),

        // Friendly status. backend.* variables are engine-owned (validate rejects writing them), so the message goes through a
        // game variable shown in its own Label; the raw backend.last_error Label stays below it as the detail line.
        // A stopped server or a gateway error page arrives as backend.unreachable or backend.sign_in_failed.
        ( event: "backend.unreachable",    do_actions: [ SetVariable("demo_msg", "Demo server unavailable. Press Sign in to retry.") ] ),
        ( event: "backend.sign_in_failed", do_actions: [ SetVariable("demo_msg", "Demo server unavailable. Press Sign in to retry.") ] ),
        ( event: "backend.offline",        do_actions: [ SetVariable("demo_msg", "The online demo is not available in this build.") ] ),
        ( event: "backend.signed_in",      do_actions: [ SetVariable("demo_msg", "") ] ),

        // Fill the board as soon as sign-in works, and again after every accepted score.
        ( event: "backend.signed_in",    do_actions: [ FetchLeaderboard(leaderboard: "best", count: 5) ] ),
        ( event: "score.submitted:best", do_actions: [ FetchLeaderboard(leaderboard: "best", count: 5) ] ),
    ],
)
