(
  schema_version: 1,
  models: {
    "character_male":   ( path: "shared/models/characters/character-male-01.glb#Scene0" ),
    "character_female": ( path: "shared/models/characters/character-female-01.glb#Scene0" ),
    "anim_locomotion":  ( path: "shared/models/characters/character-animations/locomotion.glb#Scene0" ),
  },
  textures: {},
  audio: {},
  effects: {
    // Stationary, long-lived, non-fading sparks — playtest aid for the split-screen particle
    // billboard orientation fix (Phase 1 of planning/features/split_screen_camera_followups.md).
    // Spawned in room3 (fixed vertical split) at the midpoint between the two spawn points so
    // both players see it immediately; orbit either camera around it to confirm each viewport's
    // quads face that viewport's own camera, not world axes or the other player's camera.
    "billboard_test_spark": (
      particle_count: 6,
      lifetime_secs: 30.0,
      speed: 0.0,
      spread_deg: 0.0,
      emit_radius: 0.6,
      size: 0.4,
      size_jitter: 0.1,
      color_start: (1.0, 0.6, 0.1, 1.0),
      color_end: (1.0, 0.6, 0.1, 1.0),
      gravity: 0.0,
    ),
  },
  // Solid-color tints for room6's 4-way split — distinguishes 4 players who otherwise reuse just
  // the 2 existing character models (2 players per model). Standard (not unlit), so tinted
  // characters still respond to each room's lighting like every other model in this project.
  materials: {
    "tint_blue":       ( kind: Standard(( base_color: (r:0.15, g:0.35, b:0.95, a:1.0) )) ),
    "tint_pink":       ( kind: Standard(( base_color: (r:0.95, g:0.35, b:0.70, a:1.0) )) ),
    "tint_dark_green": ( kind: Standard(( base_color: (r:0.10, g:0.40, b:0.15, a:1.0) )) ),
    "tint_red":        ( kind: Standard(( base_color: (r:0.85, g:0.15, b:0.15, a:1.0) )) ),
  },
)
