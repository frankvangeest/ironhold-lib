(
  schema_version: 2,
  prefabs: {

    // Static ground platform — physics: true gives it a fixed collider.
    "ground": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      components: (),
      primitive: (
        size: (50.0, 1.0, 50.0),
        color: (0.30, 0.34, 0.30),
        roughness: 0.95,
        physics: true,
      ),
    ),

    // Room 2's ground — same shape as "ground", distinct color so a portal teleport is
    // visually obvious even before either player moves.
    "ground_room2": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      components: (),
      primitive: (
        size: (50.0, 1.0, 50.0),
        color: (0.24, 0.28, 0.36),
        roughness: 0.95,
        physics: true,
      ),
    ),

    // Local-coop interact-fix playtest aid: `interactable_system` used `player_query.single()`,
    // which failed and early-returned for *every* player once 2+ CharacterControllers existed —
    // interact silently did nothing for anyone in any local-coop scene (this project had zero
    // `interactable:` props before this, so the bug was never player-visible here). Fixed as a
    // per-player loop; either player_p1/player_p2 walking up and pressing their interact key
    // (both default to "KeyF" in this project) fires entity.interacted:interact_test_prop.
    "interact_test_prop": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      components: (),
      primitive: (
        size: (0.8, 0.8, 0.8),
        color: (0.85, 0.65, 0.15),
        roughness: 0.6,
      ),
      interactable: (radius: 2.0, hint_text: "Press F to interact"),
    ),

    // Room 3's ground — warm/amber tone, matching the orange portal_to_room3 accent.
    "ground_room3": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      components: (),
      primitive: (
        size: (50.0, 1.0, 50.0),
        color: (0.36, 0.30, 0.20),
        roughness: 0.95,
        physics: true,
      ),
    ),

    // Room 4's ground — cool teal/blue tone, matching the cyan portal_to_room4 accent. Distinct
    // from room3's warm amber, continuing each room's one-color-identity convention.
    "ground_room4": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      components: (),
      primitive: (
        size: (50.0, 1.0, 50.0),
        color: (0.18, 0.30, 0.34),
        roughness: 0.95,
        physics: true,
      ),
    ),

    // Stationary click-target sphere — playtest aid for the split-screen viewport-aware
    // click-to-select fix (Phase 2 of planning/features/split_screen_camera_followups.md).
    // Placed once per viewport in room3 so each half's click resolves against its own camera.
    "click_target_test": (
      kind: Primitive,
      model: "",
      shape: Sphere,
      components: (),
      primitive: (
        radius: 0.5,
        color: (0.95, 0.85, 0.10),
        roughness: 0.3,
        metallic: 0.1,
      ),
      click_selectable: true,
      // Phase 3 (split_screen_camera_followups.md) playtest aid: force-show a nameplate
      // (bypasses faction_filter entirely, so it's independent of room3's own
      // faction_filter: All setting below) so nameplate_visibility_system's store-and-read
      // distance-culling can be exercised against 2 simultaneously active split cameras.
      display_name: "Click Target",
      nameplate: true,
      // Phase 1 (per_player_split_screen_targeting.md) playtest aid: also Tab-cycle-targetable,
      // reusing these same two scene-placed instances (one per viewport) to exercise per-player
      // Tab-targeting, the per-player-tinted target indicator ring, and the per-viewport
      // target_hud: readout — no new prop needed since click_target_test already sits one per
      // viewport in room3.
      targetable: true,
      // Phase 2 (per_player_split_screen_targeting.md) playtest aid: gives this prop a real
      // StatMap so the per-player action bars' ModifyStat({target}.health, ...) slot has
      // something to subtract from instead of warning "no StatMap component" every press. No
      // stat_label/world_stat_bar attached — invisible on its own, matching the "reuse existing
      // playtest aids without changing what Phase 1's playtest already looks like" intent.
      stat_templates: [
        (
          key: "health",
          base: 100.0,
          min: 0.0,
          max: 100.0,
        ),
      ],
    ),

    // Phase 4 (split_screen_camera_followups.md) playtest aid: floating stat_label +
    // Ascii world_stat_bar, placed on room3's centerline so both split viewports can see the
    // same instance simultaneously (mirrors the portal-label bug's original repro condition).
    // One copy is scene-placed (room3.scene.ron); another is fired dynamically via
    // Action::Spawn on scene.ready:room3 (rules.ron) to exercise drain_dynamic_stat_ui_system's
    // duplication path too. A fixed base health value is used (no damage source in this demo) —
    // the point of this aid is duplication across viewports, not stat gameplay.
    "stat_widget_test": (
      kind: Primitive,
      model: "",
      shape: Sphere,
      components: (),
      primitive: (
        radius: 0.4,
        color: (0.55, 0.20, 0.75),
        roughness: 0.4,
        metallic: 0.1,
      ),
      stat_templates: [
        (
          key: "health",
          base: 75.0,
          min: 0.0,
          max: 100.0,
        ),
      ],
      stat_label: (
        stat_key: "{self}.health",
        offset: (0.0, 1.2, 0.0),
      ),
      world_stat_bar: (
        stat_key: "{self}.health",
        offset: (0.0, 1.6, 0.0),
        style: Ascii( cells: 10, font_size: 14.0 ),
      ),
    ),

    // Room 5's ground — rose/magenta tone, matching the pink portal_to_room5 accent. Distinct
    // from room3's amber and room4's teal, continuing each room's one-color-identity convention.
    "ground_room5": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      components: (),
      primitive: (
        size: (50.0, 1.0, 50.0),
        color: (0.34, 0.18, 0.26),
        roughness: 0.95,
        physics: true,
      ),
    ),

    // Room 6's ground — golden/amber-yellow tone, matching the gold portal_to_room6 accent.
    // Distinct from every prior room's color identity (blue/amber/teal/rose).
    "ground_room6": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      components: (),
      primitive: (
        size: (50.0, 1.0, 50.0),
        color: (0.34, 0.30, 0.14),
        roughness: 0.95,
        physics: true,
      ),
    ),

    // ── Portals ────────────────────────────────────────────────────────────────
    // Stage 2: TriggerZone (radius 1.5) fires entity.entered:{id} -> rules.ron -> LoadScene.
    // trigger_zone_system fires for ANY CharacterController entity that enters, so either
    // player triggers it; LoadScene then reloads the whole world (both players included) from
    // the destination scene's entities: list — "both players teleport" needs no extra code.
    // If both players enter in the same physics tick, the rule fires twice — harmless, the
    // second LoadScene just re-triggers an already-in-flight load.
    "portal_to_room2": (
      kind: Primitive,
      model: "",
      components: (),
      trigger_zone: (radius: 1.5),
      children: [
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.20, 0.18, 0.25), roughness: 0.88), offset: (-1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.20, 0.18, 0.25), roughness: 0.88), offset: ( 1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (2.60, 0.25, 0.30), color: (0.18, 0.16, 0.22), roughness: 0.90), offset: ( 0.0, 2.92, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cylinder, primitive: (radius: 0.85, height: 0.04, color: (0.42, 0.62, 1.0), roughness: 0.05, metallic: 0.30), offset: (0.0, 0.02, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
      ],
    ),

    "portal_to_room1": (
      kind: Primitive,
      model: "",
      components: (),
      trigger_zone: (radius: 1.5),
      children: [
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.72, 0.68, 0.62), roughness: 0.85), offset: (-1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.72, 0.68, 0.62), roughness: 0.85), offset: ( 1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (2.60, 0.25, 0.30), color: (0.65, 0.62, 0.58), roughness: 0.88), offset: ( 0.0, 2.92, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cylinder, primitive: (radius: 0.85, height: 0.04, color: (0.55, 0.28, 0.82), roughness: 0.05, metallic: 0.30), offset: (0.0, 0.02, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
      ],
    ),

    // room2 -> room3 (Stage 3, vertical split). The return trip reuses the existing
    // "portal_to_room2" prefab placed a second time in room3.scene.ron — same event name
    // ("entity.entered:portal_to_room2"), same rules.ron entry, no new prefab needed for that
    // direction.
    "portal_to_room3": (
      kind: Primitive,
      model: "",
      components: (),
      trigger_zone: (radius: 1.5),
      children: [
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.30, 0.20, 0.10), roughness: 0.85), offset: (-1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.30, 0.20, 0.10), roughness: 0.85), offset: ( 1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (2.60, 0.25, 0.30), color: (0.24, 0.16, 0.08), roughness: 0.90), offset: ( 0.0, 2.92, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cylinder, primitive: (radius: 0.85, height: 0.04, color: (1.0, 0.55, 0.15), roughness: 0.05, metallic: 0.30), offset: (0.0, 0.02, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
      ],
    ),

    // room3 -> room4 (Stage 4, horizontal split). The return trip reuses the existing
    // "portal_to_room3" prefab placed a second time in room4.scene.ron — same event name
    // ("entity.entered:portal_to_room3"), same rules.ron entry, no new prefab needed for that
    // direction (same trick Stage 3 used reusing "portal_to_room2").
    "portal_to_room4": (
      kind: Primitive,
      model: "",
      components: (),
      trigger_zone: (radius: 1.5),
      children: [
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.10, 0.22, 0.24), roughness: 0.85), offset: (-1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.10, 0.22, 0.24), roughness: 0.85), offset: ( 1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (2.60, 0.25, 0.30), color: (0.08, 0.18, 0.20), roughness: 0.90), offset: ( 0.0, 2.92, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cylinder, primitive: (radius: 0.85, height: 0.04, color: (0.15, 0.85, 0.80), roughness: 0.05, metallic: 0.30), offset: (0.0, 0.02, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
      ],
    ),

    // room4 -> room5 (Stage 5, dynamic split). The return trip reuses the existing
    // "portal_to_room4" prefab placed a second time in room5.scene.ron — same event name
    // ("entity.entered:portal_to_room4"), same rules.ron entry, no new prefab needed for that
    // direction (same trick every prior stage used).
    "portal_to_room5": (
      kind: Primitive,
      model: "",
      components: (),
      trigger_zone: (radius: 1.5),
      children: [
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.24, 0.10, 0.18), roughness: 0.85), offset: (-1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.24, 0.10, 0.18), roughness: 0.85), offset: ( 1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (2.60, 0.25, 0.30), color: (0.20, 0.08, 0.14), roughness: 0.90), offset: ( 0.0, 2.92, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cylinder, primitive: (radius: 0.85, height: 0.04, color: (0.95, 0.25, 0.55), roughness: 0.05, metallic: 0.30), offset: (0.0, 0.02, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
      ],
    ),

    // room5 -> room6 (Stage 6, 4-way grid split). The return trip reuses the existing
    // "portal_to_room5" prefab placed a second time in room6.scene.ron — same event name
    // ("entity.entered:portal_to_room5"), same rules.ron entry, no new prefab needed for that
    // direction (same trick every prior stage used).
    "portal_to_room6": (
      kind: Primitive,
      model: "",
      components: (),
      trigger_zone: (radius: 1.5),
      children: [
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.24, 0.20, 0.10), roughness: 0.85), offset: (-1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.24, 0.20, 0.10), roughness: 0.85), offset: ( 1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (2.60, 0.25, 0.30), color: (0.20, 0.16, 0.08), roughness: 0.90), offset: ( 0.0, 2.92, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cylinder, primitive: (radius: 0.85, height: 0.04, color: (0.95, 0.75, 0.15), roughness: 0.05, metallic: 0.30), offset: (0.0, 0.02, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
      ],
    ),

    // Player 1 — WASD + Space + Left Shift to run. Local co-op reads the SHARED party
    // camera config from whichever player-tagged entity appears FIRST in the scene's
    // `entities` list (see scenes/main.scene.ron) — that entity's `camera.party` block is
    // the sole switch for the shared camera; player_p1 is placed first on purpose.
    // IMPORTANT: `party` on player_p2 (or any non-first player) would be silently ignored —
    // there is no validation error, so always author it on the first player only.
    // `player_index` is stored on the entity (queryable `PlayerIndex` component) — read by the
    // split-screen "P{n}" corner HUD label, per-player targeting (which player is "primary"),
    // and per-player `ActionBar((owner_player: n))` bars (see room3.scene.ron).
    "player_p1": (
      kind: Actor,
      model: "character_male",
      display_name: "Player 1",
      animation_policy: "prefabs/animation/player_locomotion.ron",
      player_index: 0,
      components: (
        tags: ["player"],
        camera: (
          offset:         (0.0, 7.0, 14.0),
          look_at_offset: (0.0, 1.2, 0.0),
          zoom_speed:     8.0,
          orbit_speed:    0.4,
          min_radius:     8.0,
          max_radius:     28.0,
          orbit_button:   "Right",
          // Shared-camera zoom: radius = clamp(max player separation + zoom_margin, min, max).
          party: (
            zoom_margin: 6.0,
            // allow_manual_zoom: true,  // uncomment to let scroll wheel nudge the auto-zoom
          ),
        ),
        inputs: (
          forward:      "KeyW",
          backward:     "KeyS",
          left:         "KeyA",
          right:        "KeyD",
          strafe_left:  "KeyQ",
          strafe_right: "KeyE",
          jump:         "Space",
          run:          "ShiftLeft",
          // One shared mouse — mouse-driven strafe/rotate is a single-player convenience
          // that would conflict between two keyboard players, so it's disabled here.
          strafe_mouse_button: None,
          // gamepad_index: 0,  // uncomment to put Player 1 on a controller — the keyboard
          // bindings above are simply ignored while gamepad_index is set, nothing to remove.
          // jump/run/interact/target_next default to South/East/West/North (Xbox A/B/X/Y) —
          // no other fields needed unless rebinding (see docs/20_data_formats.md's InputMap
          // table). Interact (West/Square) fires entity.interacted:interact_test_prop in room2
          // exactly like the keyboard "KeyF" default does, even with player_p2 present (interact
          // now works per-player in local co-op — see docs/20's "player" tag section).
          // IMPORTANT: no look_left/look_right here (or on player_p2 below) — this is party mode,
          // where PartyOrbitCamera is shared across all players. There's no single per-player
          // owner to attribute a look binding to, so per-player keyboard camera look only applies
          // to real split-screen scenes (see player_p1_split etc. below). See
          // planning/features/done/per_player_camera_look_controls.md.
        ),
        movement: (
          walk_speed: 5.0,
          run_speed: 8.5,
        ),
      ),
    ),

    // Player 2 — arrow keys + Enter to jump + Right Shift to run.
    // `camera`/`party` omitted: with 2+ players only player_p1's camera config is read.
    "player_p2": (
      kind: Actor,
      model: "character_female",
      display_name: "Player 2",
      animation_policy: "prefabs/animation/player_locomotion.ron",
      player_index: 1,
      components: (
        tags: ["player"],
        inputs: (
          forward:      "ArrowUp",
          backward:     "ArrowDown",
          left:         "ArrowLeft",
          right:        "ArrowRight",
          strafe_left:  "ArrowLeft",
          strafe_right: "ArrowRight",
          jump:         "Enter",
          run:          "ShiftRight",
          strafe_mouse_button: None,
          // gamepad_index: 1,  // uncomment for controller co-op (see player_p1's inputs comment)
          // No look_left/look_right here either — see player_p1's "IMPORTANT" comment above.
        ),
        movement: (
          walk_speed: 5.0,
          run_speed: 8.5,
        ),
      ),
    ),

    // ── Stage 3: vertical split-screen player prefabs ───────────────────────────
    // Split-screen gives each player their own real OrbitCamera (see spawn_players_and_camera's
    // `split` branch), so — unlike party mode — EVERY player's own `camera` block matters, not
    // just the first's. Both cameras here disable manual control entirely: `zoom_speed: 0.0`
    // (scroll x 0 has no effect) and `orbit_button: "None"` (new parse_orbit_button arm). One
    // shared mouse would otherwise rotate/zoom both players' cameras together — see the Stage 3
    // plan's "Research findings" for why disabling is the fix, not per-camera input masking.
    // Per-player stat pools (per_player_stat_pools.md) playtest aid: this player's own `mana`
    // pool for room3's `action_bar_p1` cost-gated slot. Declaring `stat_templates` here (the same
    // field NPCs like `click_target_test` above already use) is what gives this specific player a
    // real `StatMap`-backed pool instead of the shared global `LoadedStats` resource — omit this
    // block entirely and the cost would silently fall back to that shared pool instead, exactly
    // the bug this feature exists to fix. Base/max deliberately differ from player 2's pool below
    // (100 vs. 60) so the two players' independent bars are visually distinguishable in playtest.
    // Visual confirmation is the action bar's own cooldown-overlay dim (spend player 1's mana down
    // past 20 with repeated KeyG presses and watch only P1's bar dim, not P2's), AND (since
    // `player_stat_widgets.md`) a real floating `world_stat_bar` overhead — `stat_label`/
    // `world_stat_bar` now take effect on player prefabs exactly like any NPC/prop, giving each
    // player their own independent overhead mana readout. Uses Pixel style deliberately (not
    // Ascii): Pixel bars now duplicate correctly across simultaneously-visible split viewports
    // just like Ascii already did, so either style works on a co-op player — this demo picks
    // Pixel for the production-quality look. Fields NOT yet honored on a player prefab: `behavior`,
    // `interactable`, `dialogue`, `inventory`, `trigger_zone` (see
    // `planning/features/player_model_source_unification.md`'s "explicitly out of scope" note).
    "player_p1_split": (
      kind: Actor,
      model: "character_male",
      display_name: "Player 1",
      animation_policy: "prefabs/animation/player_locomotion.ron",
      player_index: 0,
      stat_templates: [
        (
          key: "mana",
          base: 100.0,
          min: 0.0,
          max: 100.0,
          regen_rate: 5.0,
          regen_delay: 1.0,
        ),
      ],
      world_stat_bar: (
        stat_key: "{self}.mana",
        offset: (0.0, 2.8, 0.0),
        fill_color: (0.35, 0.45, 0.95, 0.95),
        style: Pixel( size: (60.0, 6.0) ),
      ),
      components: (
        tags: ["player"],
        camera: (
          offset:         (0.0, 4.5, 9.0),
          look_at_offset: (0.0, 1.2, 0.0),
          zoom_speed:     0.0,
          orbit_speed:    0.4,
          min_radius:     4.5,
          max_radius:     9.0,
          orbit_button:   "None",
          // Sole switch for split-screen — read only from this (the first) player.
          split: (
            orientation: Vertical,
          ),
        ),
        inputs: (
          forward:      "KeyW",
          backward:     "KeyS",
          left:         "KeyA",
          right:        "KeyD",
          strafe_left:  "KeyQ",
          strafe_right: "KeyE",
          jump:         "Space",
          run:          "ShiftLeft",
          strafe_mouse_button: None,
          // Phase 1 (per_player_split_screen_targeting.md) playtest aid: explicit override of
          // InputMap's "Tab" default — Tab is intercepted by browsers for focus navigation in
          // WASM builds (see the InputMap field table in docs/20_data_formats.md), so it would
          // silently fail to cycle this player's target in the exact browser playtest meant to
          // confirm this feature. Also deliberately distinct from player 2's key below.
          target_next: "KeyT",
          // per_player_camera_look_controls.md playtest aid: since split-screen disables mouse
          // orbit (`orbit_button: "None"` above), these are this player's only way to rotate
          // their own camera. Z/X sit right under WASD.
          look_left:  "KeyZ",
          look_right: "KeyX",
          // Pitch is also supported (same mechanism) but left unbound in this demo to keep the
          // new-key count low. Uncomment to try it — clamped to `min_pitch`/`max_pitch` above:
          // look_up:   "KeyC",
          // look_down: "KeyV",
        ),
        movement: (
          walk_speed: 5.0,
          run_speed: 8.5,
        ),
      ),
    ),

    // Per-player stat pools (per_player_stat_pools.md) playtest aid — see player_p1_split's
    // comment above. Base/max (60 vs. player 1's 100) deliberately differ for visual contrast.
    "player_p2_split": (
      kind: Actor,
      model: "character_female",
      display_name: "Player 2",
      animation_policy: "prefabs/animation/player_locomotion.ron",
      player_index: 1,
      stat_templates: [
        (
          key: "mana",
          base: 60.0,
          min: 0.0,
          max: 60.0,
          regen_rate: 3.0,
          regen_delay: 1.0,
        ),
      ],
      world_stat_bar: (
        stat_key: "{self}.mana",
        offset: (0.0, 2.8, 0.0),
        fill_color: (0.95, 0.35, 0.55, 0.95),
        style: Pixel( size: (60.0, 6.0) ),
      ),
      components: (
        tags: ["player"],
        // No `split`/`party` here — only the first player's camera block is read for those.
        // The rest of this camera block (fixed distance, no manual control) DOES still apply,
        // since split-screen spawns one real camera per player from their OWN config.
        camera: (
          offset:         (0.0, 4.5, 9.0),
          look_at_offset: (0.0, 1.2, 0.0),
          zoom_speed:     0.0,
          orbit_speed:    0.4,
          min_radius:     4.5,
          max_radius:     9.0,
          orbit_button:   "None",
        ),
        inputs: (
          forward:      "ArrowUp",
          backward:     "ArrowDown",
          left:         "ArrowLeft",
          right:        "ArrowRight",
          strafe_left:  "ArrowLeft",
          strafe_right: "ArrowRight",
          jump:         "Enter",
          run:          "ShiftRight",
          strafe_mouse_button: None,
          // Phase 1 (per_player_split_screen_targeting.md) playtest aid: deliberately distinct
          // from player 1's "Tab" above (both defaulting to "Tab" would make both players
          // Tab-cycle in lockstep on a single keyboard press, masking the per-player fix).
          target_next: "KeyM",
          // per_player_camera_look_controls.md playtest aid: Comma/Period sit right beside the
          // arrow cluster on a standard layout, next to this player's own RShift run key.
          look_left:  "Comma",
          look_right: "Period",
        ),
        movement: (
          walk_speed: 5.0,
          run_speed: 8.5,
        ),
      ),
    ),

    // Stage 4, horizontal split. `player_p1_split`/`player_p2_split` above are the VERTICAL
    // pair (no `_v` suffix — they predate `Horizontal` existing at all); orientation is set by
    // the `split:` block below, not by the prefab name. Same fixed-camera tuning as the vertical
    // pair otherwise — only `split.orientation` differs.
    "player_p1_split_h": (
      kind: Actor,
      model: "character_male",
      display_name: "Player 1",
      animation_policy: "prefabs/animation/player_locomotion.ron",
      player_index: 0,
      components: (
        tags: ["player"],
        camera: (
          offset:         (0.0, 4.5, 9.0),
          look_at_offset: (0.0, 1.2, 0.0),
          zoom_speed:     0.0,
          orbit_speed:    0.4,
          min_radius:     4.5,
          max_radius:     9.0,
          orbit_button:   "None",
          // Sole switch for split-screen — read only from this (the first) player.
          split: (
            orientation: Horizontal,
          ),
        ),
        inputs: (
          forward:      "KeyW",
          backward:     "KeyS",
          left:         "KeyA",
          right:        "KeyD",
          strafe_left:  "KeyQ",
          strafe_right: "KeyE",
          jump:         "Space",
          run:          "ShiftLeft",
          strafe_mouse_button: None,
          look_left:  "KeyZ",
          look_right: "KeyX",
        ),
        movement: (
          walk_speed: 5.0,
          run_speed: 8.5,
        ),
      ),
    ),

    "player_p2_split_h": (
      kind: Actor,
      model: "character_female",
      display_name: "Player 2",
      animation_policy: "prefabs/animation/player_locomotion.ron",
      player_index: 1,
      components: (
        tags: ["player"],
        // No `split`/`party` here — only the first player's camera block is read for those.
        // The rest of this camera block (fixed distance, no manual control) DOES still apply,
        // since split-screen spawns one real camera per player from their OWN config.
        camera: (
          offset:         (0.0, 4.5, 9.0),
          look_at_offset: (0.0, 1.2, 0.0),
          zoom_speed:     0.0,
          orbit_speed:    0.4,
          min_radius:     4.5,
          max_radius:     9.0,
          orbit_button:   "None",
        ),
        inputs: (
          forward:      "ArrowUp",
          backward:     "ArrowDown",
          left:         "ArrowLeft",
          right:        "ArrowRight",
          strafe_left:  "ArrowLeft",
          strafe_right: "ArrowRight",
          jump:         "Enter",
          run:          "ShiftRight",
          strafe_mouse_button: None,
          look_left:  "Comma",
          look_right: "Period",
        ),
        movement: (
          walk_speed: 5.0,
          run_speed: 8.5,
        ),
      ),
    ),

    // Stage 5, dynamic split. `min_radius`/`max_radius` here serve two different purposes at
    // once: the split-mode per-player OrbitCamera never re-derives its radius from these (zoom
    // is fully disabled — `zoom_speed: 0.0` + `orbit_button: "None"` freeze it at `offset`'s
    // length), but the MERGED-state PartyOrbitCamera spawned alongside it (see
    // `split.dynamic`) genuinely zooms within this range as the players separate, up to
    // `max_radius` — widened to 15.0 (vs the split pair's 9.0) so the merged camera can pull
    // back smoothly as players approach `split_distance` before the screen actually splits.
    "player_p1_dynamic": (
      kind: Actor,
      model: "character_male",
      display_name: "Player 1",
      animation_policy: "prefabs/animation/player_locomotion.ron",
      player_index: 0,
      components: (
        tags: ["player"],
        camera: (
          offset:         (0.0, 4.5, 9.0),
          look_at_offset: (0.0, 1.2, 0.0),
          zoom_speed:     0.0,
          orbit_speed:    0.4,
          min_radius:     4.5,
          max_radius:     15.0,
          orbit_button:   "None",
          // Sole switch for split-screen — read only from this (the first) player.
          // `orientation` here is only a tie-break hint for the rare frame where the players end
          // up exactly equally separated on both axes — the live axis is otherwise chosen
          // automatically from their actual relative position. See `dynamic` below.
          split: (
            orientation: Vertical,
            dynamic: (
              split_distance: 12.0,
              merge_distance: 5.0,
              merged_zoom_margin: 3.0,
              merged_allow_manual_zoom: false,
            ),
          ),
        ),
        inputs: (
          forward:      "KeyW",
          backward:     "KeyS",
          left:         "KeyA",
          right:        "KeyD",
          strafe_left:  "KeyQ",
          strafe_right: "KeyE",
          jump:         "Space",
          run:          "ShiftLeft",
          strafe_mouse_button: None,
          look_left:  "KeyZ",
          look_right: "KeyX",
        ),
        movement: (
          walk_speed: 5.0,
          run_speed: 8.5,
        ),
      ),
    ),

    "player_p2_dynamic": (
      kind: Actor,
      model: "character_female",
      display_name: "Player 2",
      animation_policy: "prefabs/animation/player_locomotion.ron",
      player_index: 1,
      components: (
        tags: ["player"],
        // No `split`/`party` here — only the first player's camera block is read for those.
        // The rest of this camera block (fixed distance, no manual control) DOES still apply
        // to the split-mode camera spawned for this player from their OWN config.
        camera: (
          offset:         (0.0, 4.5, 9.0),
          look_at_offset: (0.0, 1.2, 0.0),
          zoom_speed:     0.0,
          orbit_speed:    0.4,
          min_radius:     4.5,
          max_radius:     15.0,
          orbit_button:   "None",
        ),
        inputs: (
          forward:      "ArrowUp",
          backward:     "ArrowDown",
          left:         "ArrowLeft",
          right:        "ArrowRight",
          strafe_left:  "ArrowLeft",
          strafe_right: "ArrowRight",
          jump:         "Enter",
          run:          "ShiftRight",
          strafe_mouse_button: None,
          look_left:  "Comma",
          look_right: "Period",
        ),
        movement: (
          walk_speed: 5.0,
          run_speed: 8.5,
        ),
      ),
    ),

    // ── Stage 6: 4-way grid split-screen player prefabs ─────────────────────────
    // Same fixed-camera tuning as the Stage 3/4 split pairs (zoom_speed: 0.0, orbit_button:
    // "None" — no manual control, one shared mouse would otherwise move every camera at once).
    // All 4 players reuse the existing character_male/character_female models (2 players per
    // model) and are told apart by a solid-color `material` override instead — see
    // assets.ron's `tint_*` entries and `apply_material_overrides` (material_factory.rs), an
    // existing mechanism, not new engine code.
    "player_p1_grid": (
      kind: Actor,
      model: "character_male",
      material: "tint_blue",
