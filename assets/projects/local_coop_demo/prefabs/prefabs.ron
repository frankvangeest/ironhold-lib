    // no new prefab needed for that direction (same trick every prior stage used).
    "portal_to_room7": (
      kind: Primitive,
      model: "",
      components: (),
      trigger_zone: (radius: 1.5),
      children: [
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.10, 0.24, 0.14), roughness: 0.85), offset: (-1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (0.30, 2.80, 0.30), color: (0.10, 0.24, 0.14), roughness: 0.85), offset: ( 1.0, 1.40, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cuboid,   primitive: (size: (2.60, 0.25, 0.30), color: (0.08, 0.18, 0.10), roughness: 0.90), offset: ( 0.0, 2.92, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ( shape: Cylinder, primitive: (radius: 0.85, height: 0.04, color: (0.20, 0.95, 0.45), roughness: 0.05, metallic: 0.30), offset: (0.0, 0.02, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
