(
    default_transition_ms: 150,

    // Locomotion-only pack — this demo doesn't need combat/emote clips.
    animation_sources: [
        "anim_locomotion",
    ],

    base: (
        idle:      "Idle_Loop",
        walk:      "Walk_Loop",
        run:       "Sprint_Loop",
        jump_loop: "Jump_Loop",
    ),

    // player_movement_system fires "jump_enter"/"jump_exit" sentinels on every jump/landing
    // regardless of animation policy — these overrides must exist or the resolver falls back
    // to treating the sentinel as a literal (nonexistent) clip name and logs a warning.
    overrides: [
        (
            id: "jump_enter",
            clip: "Jump_Start",
            priority: 200,
            looping: false,
            duration: 0.4,
            cancel_on_move: false,
        ),
        (
            id: "jump_exit",
            clip: "Jump_Land",
            priority: 200,
            looping: false,
            duration: 0.4,
            cancel_on_move: false,
            transition_ms: 100,
        ),
    ],
)
