(
    schema_version: 3,
    project_id: "local_coop_demo",
    display_name: "Local Co-op Demo",

    initial_scene: "scenes/main.scene.ron",

    asset_catalog: "assets.ron",
    prefab_catalog: "prefabs/prefabs.ron",
    rules_path: "logic/rules.ron",
    model_fixes_path: "overrides/model_fixes.ron",

    global_environment: (
        intensity: 400.0,
        fallback: (
            top_color: (0.12, 0.20, 0.40),
            bottom_color: (0.01, 0.01, 0.01),
        ),
    ),

    // Temporary camera_modes.md v1 playtest aid — press C anywhere in this project to fire
    // Action::CameraShake, verifying it fires on both the shared party camera (main/room2) and
    // every active split-screen camera at once (room3+). Project-level (not per-scene) so it
    // reaches every room without a per-scene binding. Remove once confirmed.
    global_key_bindings: {
        "KeyC": "shake_camera",
    },
)
