(
    schema_version: 2,
    rules: [
        ( on: "scene.ready:main",  do_actions: [ Log("Local co-op demo scene ready") ] ),
        ( on: "scene.ready:room2", do_actions: [ Log("Local co-op demo room2 ready") ] ),
        // Also spawns a stationary billboard_test_spark burst — playtest aid for the
        // split-screen particle billboard orientation fix (Phase 1 of
        // planning/features/split_screen_camera_followups.md). See assets.ron's comment.
        ( on: "scene.ready:room3", do_actions: [
            Log("Local co-op demo room3 ready"),
            SpawnEffect(key: "billboard_test_spark", position: (0.0, 1.5, 0.0), entity: None),
        ] ),
        ( on: "scene.ready:room4", do_actions: [ Log("Local co-op demo room4 ready") ] ),
        ( on: "scene.ready:room5", do_actions: [ Log("Local co-op demo room5 ready") ] ),
        ( on: "scene.ready:room6", do_actions: [ Log("Local co-op demo room6 ready") ] ),

        // Portal navigation — either player entering fires the LoadScene reload, which
        // respawns both players from the destination scene's entities: list. If both players
        // enter the same tick, this rule fires twice; the second LoadScene is a harmless no-op
        // re-trigger of an already-in-flight load. See prefabs.ron's portal_to_room2 comment.
        ( on: "entity.entered:portal_to_room2", do_actions: [ LoadScene("scenes/room2.scene.ron") ] ),
        ( on: "entity.entered:portal_to_room1", do_actions: [ LoadScene("scenes/main.scene.ron") ] ),
        ( on: "entity.entered:portal_to_room3", do_actions: [ LoadScene("scenes/room3.scene.ron") ] ),
        ( on: "entity.entered:portal_to_room4", do_actions: [ LoadScene("scenes/room4.scene.ron") ] ),
        ( on: "entity.entered:portal_to_room5", do_actions: [ LoadScene("scenes/room5.scene.ron") ] ),
        ( on: "entity.entered:portal_to_room6", do_actions: [ LoadScene("scenes/room6.scene.ron") ] ),
    ],
)
