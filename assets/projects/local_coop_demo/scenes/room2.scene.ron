(
  schema_version: 2,
  name: "room2",

  tonemapping: AcesFitted,

  // Cooler tone than main.scene.ron so the teleport reads visually, not just via console log.
  lighting: (
    ambient: (0.18, 0.20, 0.30),
    ambient_brightness: 220.0,
    directional: (
      color: (0.85, 0.90, 1.0),
      intensity: 28000.0,
      rotation_euler_deg: (-42.0, 30.0, 0.0),
      shadows_enabled: true,
    ),
  ),

  spawn_points: {
    "player_1_start": (-4.0, 0.5, 0.0),
    "player_2_start": (4.0, 0.5, 0.0),
  },

  // Same shape as main.scene.ron's clamp — Stage 2 only proves the portal mechanic, no new
  // camera/view-box behavior. Tuple order is (min_x, min_z, max_x, max_z).
  max_view_box: (-20.0, -20.0, 20.0, 20.0),

  entities: [

    (
      id: "ground",
      prefab: "ground_room2",
      transform: (
        translation: (0.0, -0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // player_p1 MUST be first — see main.scene.ron's comment; same rule applies in every
    // local co-op scene.
    (
      id: "player_01",
      prefab: "player_p1",
      transform: (
        translation: (-4.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    (
      id: "player_02",
      prefab: "player_p2",
      transform: (
        translation: (4.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // entity.entered:portal_to_room1 -> logic/rules.ron -> LoadScene(main).
    (
      id: "portal_to_room1",
      prefab: "portal_to_room1",
      transform: (
        translation: (0.0, 0.0, -15.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 1", offset: (0.0, 4.0, 0.0)),
    ),

    // entity.entered:portal_to_room3 -> logic/rules.ron -> LoadScene(room3) — Stage 3.
    (
      id: "portal_to_room3",
      prefab: "portal_to_room3",
      transform: (
        translation: (0.0, 0.0, 15.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 3", offset: (0.0, 4.0, 0.0)),
    ),

    // Local-coop interact-fix playtest aid (see prefabs.ron's "interact_test_prop" comment) —
    // entity.interacted:interact_test_prop -> logic/rules.ron -> SetVariable, shown below.
    (
      id: "interact_test_prop",
      prefab: "interact_test_prop",
      transform: (
        translation: (0.0, 0.5, -6.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Interact (F)", offset: (0.0, 1.2, 0.0)),
    ),

  ],

  ui: [
    // See main.scene.ron's comment — Label boxes don't clip overflow, so width must be wide
    // enough at the fixed 22px UI font to avoid wrapping into the label below.
    Label((
      id: "controls_hint",
      text: "P1: WASD + Space + Shift | P2: Arrows + Enter + Right Shift",
      position: (20.0, 20.0),
      size: (900.0, 32.0),
    )),
    Label((
      id: "room_hint",
      text: "Violet portal -> room 1 | Orange portal -> room 3",
      position: (20.0, 64.0),
      size: (700.0, 32.0),
    )),
    // Local-coop interact-fix playtest aid: either player walks to the "Interact (F)" box and
    // presses F (both players' interact key defaults to "KeyF" in this project) — this line
    // updates from its initial blank state, proving interact fires with 2 players present.
    // ux-gamedesigner-reviewer finding: don't call it "orange" — room_hint above already calls
    // the room-3 portal "Orange", and the two would read as the same object to a playtester.
    Label((
      id: "interact_hint",
      bind: "interact_status",
      format: "Interact test: {}",
      position: (20.0, 108.0),
      size: (700.0, 32.0),
    )),
  ],
)
