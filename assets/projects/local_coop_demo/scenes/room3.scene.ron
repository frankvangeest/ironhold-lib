(
  schema_version: 2,
  name: "room3",

  // Phase 3 (split_screen_camera_followups.md) playtest aid: exercises
  // nameplate_visibility_system's distance-culling against 2 simultaneously active split
  // cameras. click_target_test's own `nameplate: true` override does the actual force-show;
  // this block only needs to exist so nameplate_setup_system/nameplate_visibility_system run
  // at all in this scene. max_distance left at its default (20.0) — both click targets sit
  // well within it from either split camera under normal play.
  show_nameplates: true,
  nameplate_options: (
    faction_filter: All,
  ),

  tonemapping: AcesFitted,

  // Warm/amber tone, matching the orange portal_to_room3 accent and ground_room3.
  lighting: (
    ambient: (0.26, 0.22, 0.16),
    ambient_brightness: 220.0,
    directional: (
      color: (1.0, 0.90, 0.70),
      intensity: 28000.0,
      rotation_euler_deg: (-42.0, 30.0, 0.0),
      shadows_enabled: true,
    ),
  ),

  spawn_points: {
    "player_1_start": (-4.0, 0.5, 0.0),
    "player_2_start": (4.0, 0.5, 0.0),
  },

  // Same shape as the other rooms' clamp. Tuple order is (min_x, min_z, max_x, max_z).
  max_view_box: (-20.0, -20.0, 20.0, 20.0),

  entities: [

    (
      id: "ground",
      prefab: "ground_room3",
      transform: (
        translation: (0.0, -0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // player_p1_split MUST be first — its `camera.split` block is the sole switch for
    // vertical split-screen (same "first player wins" rule as `party` in the other rooms).
    // Unlike `party` scenes, BOTH players' own `camera` blocks matter here — each gets a real,
    // independent OrbitCamera from their own config, not just the first player's.
    (
      id: "player_01",
      prefab: "player_p1_split",
      transform: (
        translation: (-4.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    (
      id: "player_02",
      prefab: "player_p2_split",
      transform: (
        translation: (4.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // Click-target playtest aid (Phase 2, split_screen_camera_followups.md) — one per viewport
    // so each half's click resolves against its own camera, not the other player's.
    (
      id: "click_target_left",
      prefab: "click_target_test",
      transform: (
        translation: (-4.0, 1.5, -3.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    (
      id: "click_target_right",
      prefab: "click_target_test",
      transform: (
        translation: (4.0, 1.5, -3.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // Phase 4 (split_screen_camera_followups.md) playtest aid: centered on the split axis so
    // both viewports see it simultaneously — verifies stat_label/Ascii world_stat_bar duplicate
    // into MAX_SPLIT_PLAYERS ranked siblings instead of showing in only one viewport.
    (
      id: "stat_widget_scene_placed",
      prefab: "stat_widget_test",
      transform: (
        translation: (0.0, 2.0, -5.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // Return trip reuses the "portal_to_room2" prefab (see prefabs.ron comment) — same event
    // name as room1's forward portal, same rules.ron entry, no new prefab needed.
    (
      id: "portal_to_room2",
      prefab: "portal_to_room2",
      transform: (
        translation: (0.0, 0.0, -15.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 2", offset: (0.0, 4.0, 0.0)),
    ),

    // room3 -> room4 (Stage 4, horizontal split). See prefabs.ron's "portal_to_room4" comment —
    // the return trip reuses the existing "portal_to_room3" prefab, no new prefab needed for it.
    (
      id: "portal_to_room4",
      prefab: "portal_to_room4",
      transform: (
        translation: (0.0, 0.0, 15.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 4", offset: (0.0, 4.0, 0.0)),
    ),

  ],

  ui: [
    Label((
      id: "controls_hint",
      text: "P1: WASD + Space + Shift | P2: Arrows + Enter + Right Shift",
      position: (20.0, 20.0),
      size: (900.0, 32.0),
    )),
    Label((
      id: "room_hint",
      // Kept under 900px width, same budget as controls_hint above (a known-good 59-char line
      // at this box size) — see Stage 4 plan's note on avoiding Stage 2's label-overflow bug.
      text: "Room 3: vertical split | Blue portal -> room 2 | Cyan portal -> room 4",
      position: (20.0, 64.0),
      size: (900.0, 32.0),
    )),
  ],
)
