(
  schema_version: 2,
  name: "room5",

  tonemapping: AcesFitted,

  // Rose/magenta tone, matching the pink portal_to_room5 accent and ground_room5.
  lighting: (
    ambient: (0.26, 0.16, 0.22),
    ambient_brightness: 220.0,
    directional: (
      color: (1.0, 0.80, 0.90),
      intensity: 28000.0,
      rotation_euler_deg: (-42.0, 30.0, 0.0),
      shadows_enabled: true,
    ),
  ),

  spawn_points: {
    "player_1_start": (-1.5, 0.5, 0.0),
    "player_2_start": (1.5, 0.5, 0.0),
  },

  // Same shape as the other rooms' clamp. Tuple order is (min_x, min_z, max_x, max_z).
  max_view_box: (-20.0, -20.0, 20.0, 20.0),

  entities: [

    (
      id: "ground",
      prefab: "ground_room5",
      transform: (
        translation: (0.0, -0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // player_p1_dynamic MUST be first — its `camera.split.dynamic` block is the sole switch for
    // dynamic split-screen (same "first player wins" rule as `party`/fixed `split` elsewhere).
    // Players spawn close together (distance 3.0, comfortably below merge_distance 5.0) so the
    // scene unambiguously starts merged — walk apart past split_distance (12.0) to see it split.
    (
      id: "player_01",
      prefab: "player_p1_dynamic",
      transform: (
        translation: (-1.5, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    (
      id: "player_02",
      prefab: "player_p2_dynamic",
      transform: (
        translation: (1.5, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // Return trip reuses the "portal_to_room4" prefab (see prefabs.ron comment) — same event
    // name as room3's forward portal, same rules.ron entry, no new prefab needed.
    (
      id: "portal_to_room4",
      prefab: "portal_to_room4",
      transform: (
        translation: (0.0, 0.0, -15.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

  ],

  ui: [
    Label((
      id: "controls_hint",
      text: "P1: WASD + Space + Shift | P2: Arrows + Enter + Right Shift",
      position: (20.0, 20.0),
      size: (900.0, 32.0),
    )),
    Label((
      id: "room_hint",
      // Kept under 900px width, same budget as controls_hint above (a known-good 59-char line
      // at this box size) — see Stage 4/5 plan notes on avoiding Stage 2's label-overflow bug.
      text: "Dynamic split: walk apart to split, together to merge | Pink -> room 4",
      position: (20.0, 64.0),
      size: (900.0, 32.0),
    )),
  ],
)
