(
  schema_version: 2,
  name: "room11",

  tonemapping: AcesFitted,

  // Lime tone, matching the lime portal_to_room11 accent (placed in room10.scene.ron) and
  // ground_room11 — see prefabs.ron's ground_room11 comment for why this color was picked.
  lighting: (
    ambient: (0.18, 0.24, 0.14),
    ambient_brightness: 220.0,
    directional: (
      color: (0.85, 0.95, 0.75),
      intensity: 28000.0,
      rotation_euler_deg: (-42.0, 30.0, 0.0),
      shadows_enabled: true,
    ),
  ),

  spawn_points: {
    "player_1_start": (-4.0, 0.5, 0.0),
    "player_2_start": (4.0, 0.5, 0.0),
  },

  // Same shape as the other rooms' clamp. Tuple order is (min_x, min_z, max_x, max_z).
  max_view_box: (-20.0, -20.0, 20.0, 20.0),

  // camera_modes v2 demo (planning/features/camera_modes.md): a single named preset, switched
  // to and restored from via Action::SetCameraMode with owner_player: 0 — retargeting ONLY
  // player 1's camera. Player 2's Orbit camera (player_p2_camera_switch) is never touched by
  // either rule below, proving owner_player targeting is real, not "every camera happens to
  // look the same afterward." "default" is reserved and always restores P1's own
  // scene-authored Orbit camera_mode (see player_p1_camera_switch in prefabs.ron) — it is not
  // defined here.
  camera_modes: {
    "cinematic_fixed": Fixed((
      position: (10.0, 6.0, 4.0),
      look_at: (0.0, 1.0, 0.0),
      fov: 50.0,
      transition: (duration_secs: 0.5, ease: EaseInOut),
    )),
  },

  scene_key_bindings: {
    "Digit1": "cam_p1_fixed",
    "Digit2": "cam_p1_default",
  },

  entities: [

    (
      id: "ground",
      prefab: "ground_room11",
      transform: (
        translation: (0.0, -0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // player_p1_camera_switch MUST be first — its `split` block is the sole switch for
    // split-screen (same "first player wins" rule every other room's split/party uses). This is
    // the player Action::SetCameraMode(owner_player: 0) retargets.
    (
      id: "player_01",
      prefab: "player_p1_camera_switch",
      transform: (
        translation: (-4.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // Never targeted by either camera rule below — stays on its own untouched Orbit camera the
    // entire time, proving the retarget is per-player, not scene-wide.
    (
      id: "player_02",
      prefab: "player_p2_camera_switch",
      transform: (
        translation: (4.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // Return trip reuses the "portal_to_room10" prefab (see prefabs.ron comment) — same event
    // name as room9's forward portal into room10, same rules.ron entry, no new prefab needed.
    (
      id: "portal_to_room10",
      prefab: "portal_to_room10",
      transform: (
        translation: (0.0, 0.0, -15.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 10", offset: (0.0, 4.0, 0.0)),
    ),

  ],

  ui: [
    Label((
      id: "room_hint",
      text: "Room 11: SetCameraMode demo | Steel portal -> room 10",
      position: (20.0, 20.0),
      size: (900.0, 32.0),
    )),
    Label((
      id: "controls_hint",
      text: "P1: WASD+Space+Shift+Z/X look | P2: Arrows+Enter+RShift+Comma/Period look",
      position: (20.0, 64.0),
      size: (900.0, 32.0),
    )),
    Label((
      id: "camera_switch_hint",
      text: "Digit1: P1 -> Fixed (static - walk out of frame) | Digit2: back to Orbit",
      position: (20.0, 108.0),
      size: (900.0, 32.0),
    )),
    Label((
      id: "thesis_hint",
      text: "Only P1's viewport changes - split stays 50/50, P2's camera untouched",
      position: (20.0, 152.0),
      size: (900.0, 32.0),
    )),
  ],
)
