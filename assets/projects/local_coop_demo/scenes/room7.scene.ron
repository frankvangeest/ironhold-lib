(
  schema_version: 2,
  name: "room7",

  // player_model_source_unification.md v1 playtest aid: minimal 2-primitive-player vertical
  // split. Falsifies the two headline claims that are only observable with 2+ primitive players
  // in one scene — that the single-primitive-player structural cap is gone, and that a primitive
  // player now gets its own PlayerIndex/material/StatMap/stat widgets like a GLB player. Every
  // other room in this project uses GLB (Actor-kind) player prefabs; this is the only one using
  // `kind: Primitive` capsules.
  tonemapping: AcesFitted,

  // Emerald/green tone, matching the green portal_to_room7 accent and ground_room7 — the last
  // unused color identity in this project's one-color-per-room convention.
  lighting: (
    ambient: (0.16, 0.24, 0.18),
    ambient_brightness: 220.0,
    directional: (
      color: (0.85, 1.0, 0.90),
      intensity: 28000.0,
      rotation_euler_deg: (-42.0, 30.0, 0.0),
      shadows_enabled: true,
    ),
  ),

  spawn_points: {
    "player_1_start": (-4.0, 0.5, 0.0),
    "player_2_start": (4.0, 0.5, 0.0),
  },

  // Same shape as the other rooms' clamp. Tuple order is (min_x, min_z, max_x, max_z).
  max_view_box: (-20.0, -20.0, 20.0, 20.0),

  entities: [

    (
      id: "ground",
      prefab: "ground_room7",
      transform: (
        translation: (0.0, -0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // player_p1_primitive MUST be first — its `camera.split` block is the sole switch for
    // vertical split-screen (same "first player wins" rule as room3's GLB player_p1_split).
    (
      id: "player_01",
      prefab: "player_p1_primitive",
      transform: (
        translation: (-4.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    (
      id: "player_02",
      prefab: "player_p2_primitive",
      transform: (
        translation: (4.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // Return trip reuses the "portal_to_room6" prefab (see prefabs.ron comment) — same event
    // name as room6's forward portal, same rules.ron entry, no new prefab needed.
    (
      id: "portal_to_room6",
      prefab: "portal_to_room6",
      transform: (
        translation: (0.0, 0.0, -15.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 6", offset: (0.0, 4.0, 0.0)),
    ),

    // room7 -> room8 (local_coop_hot_join_leave.md v1 playtest aid: 2-player Grid scene that
    // grows to 4 via hot-join). See prefabs.ron's "portal_to_room8" comment.
    (
      id: "portal_to_room8",
      prefab: "portal_to_room8",
      transform: (
        translation: (0.0, 0.0, 15.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 8 (hot join)", offset: (0.0, 4.0, 0.0)),
    ),

  ],

  ui: [
    Label((
      id: "room_hint",
      text: "Room 7: 2 PRIMITIVE (capsule) players, vertical split | Green -> room 6",
      position: (20.0, 20.0),
      size: (900.0, 32.0),
    )),
    Label((
      id: "controls_hint",
      text: "P1: WASD + Space + Shift | P2: Arrows + Enter + Right Shift",
      position: (20.0, 64.0),
      size: (900.0, 32.0),
    )),
    // Confirms each primitive player's own split-screen "P{n}" corner label and world-space mana
    // bar resolve against that player's own PlayerIndex/StatMap — the exact gap this feature
    // closes (a primitive player previously had neither).
    Label((
      id: "proof_hint",
      text: "Each capsule: own P1/P2 label, own tint (blue/red), own mana bar above head",
      position: (20.0, 108.0),
      size: (900.0, 32.0),
    )),
    // ux-gamedesigner-reviewer finding: this room has no action bar spending mana, so both bars
    // stay visibly full — proving the bars exist and are per-player (distinct colors/positions),
    // but not that the underlying pools are independently live. See room3 for a primitive-free
    // scene where each player's own action bar visibly drains their own mana pool.
    Label((
      id: "static_bars_hint",
      text: "(Mana bars here are static - see Room 3 to see per-player pools drain live)",
      position: (20.0, 152.0),
      size: (900.0, 32.0),
    )),
  ],
)
