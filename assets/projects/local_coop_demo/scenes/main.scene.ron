(
  schema_version: 2,
  name: "main",

  tonemapping: AcesFitted,

  lighting: (
    ambient: (0.20, 0.22, 0.32),
    ambient_brightness: 220.0,
    directional: (
      color: (1.0, 0.95, 0.82),
      intensity: 28000.0,
      rotation_euler_deg: (-42.0, 30.0, 0.0),
      shadows_enabled: true,
    ),
  ),

  spawn_points: {
    "player_1_start": (-4.0, 0.5, 0.0),
    "player_2_start": (4.0, 0.5, 0.0),
  },

  // Hard XZ clamp so neither player can wander off the 50x50 ground platform
  // (which spans roughly -25..25 on both axes) or out of camera view.
  // Tuple order is (min_x, min_z, max_x, max_z).
  max_view_box: (-20.0, -20.0, 20.0, 20.0),

  entities: [

    (
      id: "ground",
      prefab: "ground",
      transform: (
        translation: (0.0, -0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // player_p1 MUST be first among the two `tags: ["player"]` entities below —
    // its `camera.party` block is what local co-op reads for the shared camera.
    (
      id: "player_01",
      prefab: "player_p1",
      transform: (
        translation: (-4.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    (
      id: "player_02",
      prefab: "player_p2",
      transform: (
        translation: (4.0, 0.5, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // entity.entered:portal_to_room2 -> logic/rules.ron -> LoadScene(room2). Either player
    // walking in teleports both (see prefabs.ron comment on portal_to_room2).
    (
      id: "portal_to_room2",
      prefab: "portal_to_room2",
      transform: (
        translation: (0.0, 0.0, -15.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 2", offset: (0.0, 4.0, 0.0)),
    ),

    // Direct-access shortcuts to rooms 4/7/10 (2026-09-01 playtest aid, `feature/prop-ground-veto`
    // — room10's `cube_obstacle_room10` is the recommended manual repro object for the solid-prop
    // ground-veto fix, and walking the full room2->room3->...->room10 portal chain to reach it
    // every time was slow). Reuses each destination room's own already-wired forward portal prefab
    // (`portal_to_room4`/`portal_to_room7`/`portal_to_room10` — same `id`-keyed
    // `entity.entered:portal_to_roomN` -> `LoadScene` rule every other placement of these prefabs
    // already uses, see `logic/rules.ron`; no new prefab or rule needed) — placed a third/fourth
    // time here, exactly like `portal_to_room10` is already reused as room11's own back-portal.
    // Arranged in a N/E/S/W compass around the two players' spawn point (room2 due north, unchanged
    // above) so all four are evenly spaced and visible together as the shared party camera pulls
    // back — not a full hub (that's `planning/backlog.md`'s still-queued "restructure main.scene.ron
    // into a hub with a portal to every room" item; this only covers the three rooms worth
    // shortcutting to for playtesting). East/west portals are rotated 90° so their gate opening
    // faces back toward spawn, matching how the north-facing room2 portal already reads.
    (
      id: "portal_to_room4",
      prefab: "portal_to_room4",
      transform: (
        translation: (15.0, 0.0, 0.0),
        rotation_euler_deg: (0.0, 90.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 4", offset: (0.0, 4.0, 0.0)),
    ),

    (
      id: "portal_to_room7",
      prefab: "portal_to_room7",
      transform: (
        translation: (0.0, 0.0, 15.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 7", offset: (0.0, 4.0, 0.0)),
    ),

    (
      id: "portal_to_room10",
      prefab: "portal_to_room10",
      transform: (
        translation: (-15.0, 0.0, 0.0),
        rotation_euler_deg: (0.0, 90.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
      label: (text: "Room 10", offset: (0.0, 4.0, 0.0)),
    ),

  ],

  ui: [
    // Label boxes are fixed-pixel Node width/height (Val::Px) with no text clipping — if the
    // text is wider than `size.0` at the fixed 22px UI font, it wraps and the wrapped lines
    // visually overflow past `size.1` into whatever is below. Width here is sized with margin
    // for this string; if you change the text, re-check it doesn't wrap (no live-reload for
    // this — playtest in a real browser).
    Label((
      id: "controls_hint",
      text: "P1: WASD + Space + Shift | P2: Arrows + Enter + Right Shift | C: shake camera",
      position: (20.0, 20.0),
      size: (900.0, 32.0),
    )),
  ],
)
