// ui_demo: nestable flexbox `Group` layouts, with no hand-computed pixel positions.
// See "Group" in docs/20_data_formats.md.
//
// The whole scene is ONE full-screen root Group: a Column whose `justify_content: SpaceBetween`
// pushes a top bar to the top, a bottom bar to the bottom, and the stations in between. This is
// the recipe for anchoring UI to screen edges (a top-level `position:` is always a top-left
// offset; there is no `right:` / `bottom:`). Use plain ASCII in on-screen text: the engine font
// has no glyph for em-dashes and similar characters.
(
    schema_version: 2,
    name: "main",
    entities: [],

    ui: [
        Group((
            id: "root",
            flex_direction: Column,
            justify_content: SpaceBetween,
            width: Percent(100.0),
            height: Percent(100.0),
            children: [

                // ---- Top bar: title on the left, buttons on the right (SpaceBetween) ----
                // SpaceBetween only spreads when the main axis has a definite size, hence
                // `width: Percent(100.0)`.
                Group((
                    id: "top_bar",
                    flex_direction: Row,
                    justify_content: SpaceBetween,
                    align_items: Center,
                    width: Percent(100.0),
                    padding: 12.0,
                    background_color: (0.05, 0.05, 0.08, 0.85),
                    children: [
                        Label((id: "title", text: "ui_demo - Group layout", size: (360.0, 32.0), align: Left)),
                        Group((
                            gap: 8.0,
                            children: [
                                Button((id: "add_btn",   text: "Add",   action: "ui.add")),
                                Button((id: "reset_btn", text: "Reset", action: "ui.reset")),
                            ],
                        )),
                    ],
                )),

                // ---- Middle: three labelled stations side by side ----
                Group((
                    id: "stations",
                    flex_direction: Row,
                    justify_content: Center,
                    align_items: Start,
                    width: Percent(100.0),
                    gap: 24.0,
                    padding: 24.0,
                    children: [

                        // Station A: a row nested inside a column.
                        Group((
                            id: "station_a",
                            flex_direction: Column,
                            gap: 8.0,
                            padding: 12.0,
                            background_color: (0.12, 0.14, 0.20, 0.9),
                            children: [
                                Label((id: "a_title", text: "A: row in column", size: (240.0, 28.0), align: Left)),
                                Group((
                                    gap: 8.0,
                                    children: [
                                        Rect((id: "a1", size: (60.0, 60.0), color: (0.85, 0.35, 0.30, 1.0))),
                                        Rect((id: "a2", size: (60.0, 60.0), color: (0.35, 0.75, 0.40, 1.0))),
                                        Rect((id: "a3", size: (60.0, 60.0), color: (0.35, 0.50, 0.90, 1.0))),
                                    ],
                                )),
                            ],
                        )),

                        // Station B: SpaceBetween spreads three squares across a fixed width.
                        Group((
                            id: "station_b",
                            flex_direction: Column,
                            gap: 8.0,
                            padding: 12.0,
                            background_color: (0.12, 0.14, 0.20, 0.9),
                            children: [
                                Label((id: "b_title", text: "B: SpaceBetween", size: (300.0, 28.0), align: Left)),
                                Group((
                                    flex_direction: Row,
                                    justify_content: SpaceBetween,
                                    width: Px(300.0),
                                    children: [
                                        Rect((id: "b1", size: (40.0, 40.0), color: (0.85, 0.35, 0.30, 1.0))),
                                        Rect((id: "b2", size: (40.0, 40.0), color: (0.35, 0.75, 0.40, 1.0))),
                                        Rect((id: "b3", size: (40.0, 40.0), color: (0.35, 0.50, 0.90, 1.0))),
                                    ],
                                )),
                            ],
                        )),

                        // Station C: an empty Group is a spacer (extra space between two children).
                        Group((
                            id: "station_c",
                            flex_direction: Column,
                            padding: 12.0,
                            background_color: (0.12, 0.14, 0.20, 0.9),
                            children: [
                                Label((id: "c_title", text: "C: spacer", size: (200.0, 28.0), align: Left)),
                                Rect((id: "c1", size: (200.0, 24.0), color: (0.85, 0.35, 0.30, 1.0))),
                                Group((height: Px(32.0), children: [])),
                                Rect((id: "c2", size: (200.0, 24.0), color: (0.35, 0.50, 0.90, 1.0))),
                            ],
                        )),
                    ],
                )),

                // ---- Bottom bar: right-aligned with justify_content: End ----
                Group((
                    id: "bottom_bar",
                    flex_direction: Row,
                    justify_content: End,
                    align_items: Center,
                    width: Percent(100.0),
                    gap: 12.0,
                    padding: 12.0,
                    background_color: (0.05, 0.05, 0.08, 0.85),
                    children: [
                        Label((id: "count_label", text: "", bind: "count", format: "Count: {}", size: (200.0, 32.0), align: Right)),
                        Button((id: "next_btn", text: "+10", action: "ui.next")),
                    ],
                )),
            ],
        )),
    ],
)
