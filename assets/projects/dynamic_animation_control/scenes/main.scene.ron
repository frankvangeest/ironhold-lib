// Frozen poses (deterministic) — see "Spawn-already-posed pattern" in docs/20_data_formats.md.
// Four zombies, each frozen at a different fraction of the "death" clip's duration via
// PlayAnimationOn(..., freeze: true) fired from logic/rules.ron on scene.ready:main. Every pose
// is set once and held (no locomotion, no per-frame drift), which is what makes this scene a
// valid screenshot regression baseline for the whole seek/freeze mechanism — see
// screenshot_baselines/scenes/dynamic_animation_control_main.png.
(
  schema_version: 2,
  name: "main",

  tonemapping: AcesFitted,

  lighting: (
    ambient: (0.28, 0.30, 0.36),
    ambient_brightness: 120.0,
    directional: (
      color: (1.0, 0.95, 0.85),
      intensity: 32000.0,
      rotation_euler_deg: (-45.0, 25.0, 0.0),
      shadows_enabled: true,
    ),
  ),

  // Keeps world-space labels legible if a designer flies the flycam further from the row —
  // without this, label text is pinned at a fixed screen pixel size regardless of distance,
  // which is the mechanism behind the overlap this whole block exists to avoid (see the
  // "contact sheet" comment on the entities below). reference_distance matches the camera's
  // default z so labels render at their authored font_size from the scene's default view.
  label_depth_scale: (
    reference_distance: 9.0,
    min_scale: 0.5,
  ),

  entities: [
    (
      id: "camera_01",
      prefab: "flycam",
      transform: (
        translation: (0.0, 3.2, 9.0),
        rotation_euler_deg: (-10.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    (
      id: "ground_01",
      prefab: "ground",
      transform: (
        translation: (0.0, -0.25, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // "Contact sheet" pattern: a full RON-snippet caption on each model overlaps its neighbours
    // at almost any window size (fixed-pixel text vs. a screen-space gap that shrinks with
    // viewport height — there's no camera distance that fixes both ends at once). Each model
    // instead gets only a short, large, colour-coded token; the full explanation lives in the
    // "legend" panel in ui: below, keyed by the same colour. 3m pitch (was 4m) keeps every
    // specimen and its token inside the camera frustum on a 16:9-or-narrower canvas.
    (
      id: "pose_0",
      prefab: "zombie_pose",
      transform: ( translation: (-4.5, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
      label: ( text: "0%", offset: (0.0, 2.2, 0.0), font_size: 30.0, color: (0.35, 0.85, 0.35, 1.0) ),
    ),
    (
      id: "pose_50",
      prefab: "zombie_pose",
      transform: ( translation: (-1.5, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
      label: ( text: "50%", offset: (0.0, 2.2, 0.0), font_size: 30.0, color: (1.0, 0.85, 0.2, 1.0) ),
    ),
    (
      id: "pose_75",
      prefab: "zombie_pose",
      transform: ( translation: (1.5, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
      label: ( text: "75%", offset: (0.0, 2.2, 0.0), font_size: 30.0, color: (1.0, 0.55, 0.15, 1.0) ),
    ),
    (
      id: "pose_100",
      prefab: "zombie_pose",
      transform: ( translation: (4.5, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
      label: ( text: "100%", offset: (0.0, 2.2, 0.0), font_size: 30.0, color: (1.0, 0.25, 0.2, 1.0) ),
    ),
  ],

  ui: [
    Label((
      id: "title",
      text: "Dynamic Animation Control - Page 1 of 2: Frozen Poses",
      position: (16.0, 16.0),
      size: (700.0, 30.0),
      align: Left,
    )),
    Label((
      id: "camera_hint",
      text: "WASD move, E/Space up/down, Shift fast, hold LMB/RMB to look",
      position: (16.0, 54.0),
      size: (700.0, 30.0),
      align: Left,
    )),
    Button((
      id: "goto_continue_button",
      text: "Page 2 ->",
      action: "ui.goto_continue",
      position: (16.0, 96.0),
      size: (160.0, 44.0),
    )),

    // Legend — the swatch colours match each zombie's on-model token above 1:1. This is also
    // where the shared structure lives: all four use the same clip/freeze, only the fraction
    // changes, which is the actual point of the demo and was getting lost in four repeated
    // full-sentence captions.
    //
    // Every Label/Button renders its own translucent black backdrop and a FIXED font size
    // (22px for Label, 26px for Button — not driven by `size`, which only sets the layout box).
    // Rows below are spaced 34px apart to clear that real line height; a separate background
    // Rect behind the whole block was tried and dropped — it just double-darkened the already
    // auto-backed rows instead of unifying them.
    Label((
      id: "legend_head",
      text: "All four: clip: \"death\", freeze: true",
      position: (16.0, 152.0),
      size: (700.0, 28.0),
      align: Left,
    )),
    Rect((
      id: "legend_swatch_0",
      position: (16.0, 190.0),
      size: (16.0, 16.0),
      color: (0.35, 0.85, 0.35, 1.0),
    )),
    Label((
      id: "legend_0",
      text: "0%    start_at_fraction: 0.0",
      position: (40.0, 186.0),
      size: (480.0, 26.0),
      align: Left,
    )),
    Rect((
      id: "legend_swatch_50",
      position: (16.0, 224.0),
      size: (16.0, 16.0),
      color: (1.0, 0.85, 0.2, 1.0),
    )),
    Label((
      id: "legend_50",
      text: "50%   start_at_fraction: 0.5",
      position: (40.0, 220.0),
      size: (480.0, 26.0),
      align: Left,
    )),
    Rect((
      id: "legend_swatch_75",
      position: (16.0, 258.0),
      size: (16.0, 16.0),
      color: (1.0, 0.55, 0.15, 1.0),
    )),
    Label((
      id: "legend_75",
      text: "75%   start_at_fraction: 0.75",
      position: (40.0, 254.0),
      size: (480.0, 26.0),
      align: Left,
    )),
    Rect((
      id: "legend_swatch_100",
      position: (16.0, 292.0),
      size: (16.0, 16.0),
      color: (1.0, 0.25, 0.2, 1.0),
    )),
    Label((
      id: "legend_100",
      text: "100%  start_at_fraction: 1.0",
      position: (40.0, 288.0),
      size: (480.0, 26.0),
      align: Left,
    )),
  ],
)
