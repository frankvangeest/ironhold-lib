(
    schema_version: 3,
    project_id: "dynamic_animation_control",
    display_name: "Dynamic Animation Control",

    initial_scene: "scenes/main.scene.ron",

    asset_catalog: "assets.ron",
    prefab_catalog: "prefabs/prefabs.ron",
    rules_path: "logic/rules.ron",

    global_environment: (
        intensity: 800.0,
        fallback: (
            top_color: (0.30, 0.42, 0.60),
            bottom_color: (0.05, 0.05, 0.08),
        ),
    ),

    global_key_bindings: {
        "Escape": "quit",
    },

    primitive_default_color: (0.55, 0.58, 0.55),
)
