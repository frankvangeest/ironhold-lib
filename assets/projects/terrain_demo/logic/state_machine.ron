(
    schema_version: 1,
    initial_state: "exploring",

    global_on: [
        (
            event: "ui.button_pressed:quit",
            do_actions: [Quit],
        ),
        // scene.loaded fires after the RON is parsed but before terrain mesh generation
        // completes. scene.ready fires once all entities (including the terrain) are spawned.
        // This gap is noticeable on large terrains — use scene.loaded for early setup.
        (
            event: "scene.loaded:terrain",
            do_actions: [Log("Terrain assets loaded, generating mesh...")],
        ),
    ],

    states: [
        (
            name: "exploring",
            entry_actions: [
                Log("Terrain Demo: FlyCamera active. WASD/mouse to navigate, Shift for speed boost."),
            ],
            exit_actions: [],
            on: [],
        ),
    ],

    transitions: [
        ( on: "scene.ready:terrain", to: "exploring" ),
    ],
)
