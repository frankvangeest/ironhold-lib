(
  schema_version: 2,
  name: "terrain",

  // AcesFitted: cinematic, high-performance tonemapper. No LUT required.
  tonemapping: AcesFitted,

  lighting: (
    // Cool sky fill — low enough to keep the primitive shapes well-contrasted.
    ambient: (0.20, 0.24, 0.38),
    ambient_brightness: 90.0,
    directional: (
      // Bright sun from a side angle to catch the geometry of all seven primitives.
      color: (1.0, 0.94, 0.80),
      intensity: 32000.0,
      rotation_euler_deg: (-35.0, 45.0, 0.0),
      shadows_enabled: true,
    ),
  ),

  terrain: (
    heightmap: "projects/terrain_demo/terrain/heightmap.png",
    splatmap: "shared/terrain/splatmap.png",
    // scale: (horizontal units/pixel, max height in world units, horizontal units/pixel)
    // 1024×1024 heightmap × 0.5 = ~512×512 unit terrain; max elevation 30 units.
    scale: (0.5, 30.0, 0.5),
    position: (0.0, -30.0, 0.0),
    material_paths: [
      "shared/terrain/dirt.png",
      "shared/terrain/grass.png",
      "shared/terrain/rock.png",
      "shared/terrain/snow.png",
    ],
    // UV tiling scale for the layer textures. Higher = more fine tiling.
    uv_scale: 10.0,
  ),

  spawn_points: {
    // Elevated diagonal corner giving a clear view of all seven primitive shapes.
    // Primitives span ±100 on each axis; this point frames them within a ~60° FoV.
    // The underground cone at (0,-100,0) is not visible from above by design.
    "shapes_overview": (180.0, 120.0, 180.0),
  },

  entities: [
    // FlyCamera — spawns at the shapes_overview point so all primitives are in view.
    // Controls: WASD move | LMB/RMB + mouse look | Shift fast | E/Space up | Q/Ctrl down.
    (
      id: "camera_01",
      prefab: "flycam",
      transform: (
        translation: (180.0, 120.0, 180.0),
        rotation_euler_deg: (-30.0, 45.0, 0.0),  // pitch -30° down, yaw 45° toward -X-Z
        scale: (1.0, 1.0, 1.0),
      ),
    ),
  ],

  ui: [
    (
      kind: "label",
      id: "flycam_position",
      text: "X: 0.0  Y: 0.0  Z: 0.0",
      position: (16.0, 16.0),
      size: (320.0, 32.0),
    ),
    (
      kind: "button",
      id: "quit_button",
      text: "Quit",
      action: "ui.quit",
      position: (16.0, 60.0),
      size: (120.0, 40.0),
    ),
  ],
)
