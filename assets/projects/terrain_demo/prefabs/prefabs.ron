(
  schema_version: 1,
  prefabs: {
    // FlyCamera prefab. No model — the engine detects the "flycam" tag and
    // spawns Camera3d + FlyCamera directly. The model field is required by the
    // schema but is ignored for flycam entities.
    "flycam": (
      kind: "prop",
      model: "",
      components: (
        tags: ["flycam"],
      ),
    ),

    // ── Primitive shape prefabs ───────────────────────────────────────────────
    // `model` is the Bevy shape name.  `primitive` holds dimension/appearance
    // overrides — all fields are optional.  Omit `primitive` entirely or omit
    // any field to use the built-in default for that shape.
    //
    // Color priority (highest wins):
    //   1. primitive.color      — per-prefab override (set here)
    //   2. primitive_default_color — project-level default (set in *.project.ron)
    //   3. grey (0.7, 0.7, 0.7)  — engine fallback when nothing is set
    //
    // Other field reference:
    //   size:       (x, y, z)   — Cuboid
    //   radius:     f32         — Sphere radius | Cylinder/Capsule/Cone radius |
    //                             Torus outer radius | ConicalFrustum bottom radius
    //   radius_top: f32         — ConicalFrustum top radius | Torus inner radius
    //   height:     f32         — Cylinder height | Capsule half_length |
    //                             Cone height | ConicalFrustum height
    //   roughness:  f32         — 0 = mirror … 1 = fully rough  (default 0.5)
    //   metallic:   f32         — 0 = dielectric … 1 = full metal (default 0.0)

    // No color set — uses project primitive_default_color (warm sand from terrain_demo.project.ron)
    "prim_cuboid": (
      kind: "primitive",
      model: "Cuboid",
      components: (),
      primitive: (
        size: (4.0, 4.0, 4.0),
        roughness: 0.4,
      ),
    ),

    "prim_sphere": (
      kind: "primitive",
      model: "Sphere",
      components: (),
      primitive: (
        radius: 3.0,
        color: (0.9, 0.2, 0.2),  // red — +X axis
        roughness: 0.2,
        metallic: 0.3,
      ),
    ),

    "prim_cylinder": (
      kind: "primitive",
      model: "Cylinder",
      components: (),
      primitive: (
        radius: 2.0,
        height: 5.0,
        color: (0.9, 0.55, 0.1),  // orange — −X axis
        roughness: 0.6,
      ),
    ),

    "prim_capsule": (
      kind: "primitive",
      model: "Capsule3d",
      components: (),
      primitive: (
        radius: 1.5,
        height: 9.0,
        color: (0.2, 0.9, 0.2),  // green — +Y axis
        roughness: 0.5,
      ),
    ),

    "prim_cone": (
      kind: "primitive",
      model: "Cone",
      components: (),
      primitive: (
        radius: 2.5,
        height: 5.0,
        color: (0.1, 0.45, 0.1),  // dark green — −Y axis
        roughness: 0.7,
      ),
    ),

    "prim_torus": (
      kind: "primitive",
      model: "Torus",
      components: (),
      primitive: (
        radius: 2.5,             // outer radius
        radius_top: 0.6,         // inner radius
        color: (0.2, 0.4, 0.9),  // blue — +Z axis
        roughness: 0.3,
        metallic: 0.5,
      ),
    ),

    "prim_frustum": (
      kind: "primitive",
      model: "ConicalFrustum",
      components: (),
      primitive: (
        radius: 2.5,             // bottom radius
        radius_top: 1.0,         // top radius
        height: 5.0,
        color: (0.7, 0.2, 0.9),  // purple — −Z axis
        roughness: 0.4,
        metallic: 0.2,
      ),
    ),
  }
)
