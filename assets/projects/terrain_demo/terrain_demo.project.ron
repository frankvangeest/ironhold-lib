(
    schema_version: 3,
    project_id: "terrain_demo",
    display_name: "Terrain Demo",

    initial_scene: "scenes/terrain.scene.ron",

    asset_catalog: "assets.ron",
    prefab_catalog: "prefabs/prefabs.ron",
    state_machine_path: "logic/state_machine.ron",
    model_fixes_path: "overrides/model_fixes.ron",

    global_environment: (
        intensity: 400.0,
        fallback: (
            top_color: (0.1, 0.2, 0.4),
            bottom_color: (0.01, 0.01, 0.01),
        ),
    ),

    global_key_bindings: {
        "Escape": "quit",
    },

    // Default color for all primitive shapes that don't specify their own color.
    // Overridden per-prefab via `primitive.color` in prefabs.ron.
    primitive_default_color: (0.8, 0.75, 0.6),
)
