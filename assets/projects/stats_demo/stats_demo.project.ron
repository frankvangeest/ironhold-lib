            top_color: (0.15, 0.22, 0.45),
            bottom_color: (0.02, 0.02, 0.04),
        ),
    ),

    primitive_default_color: (0.65, 0.63, 0.60),

    damage_popup_style: (
        font_size:     20.0,
        duration_secs:  1.2,
        rise_speed:     1.5,
        spawn_offset:  (0.0, 2.0, 0.0),
        damage_color:  (0.95, 0.25, 0.20, 1.0),
        heal_color:    (0.20, 0.90, 0.20, 1.0),
    ),
)
