            components: (),
            interactable: (radius: 2.0, hint_text: "F  Overheal"),
            motion: (bob: (0.12, 0.7)),
            children: [
                (
                    shape: Cylinder,
                    primitive: ( radius: 0.28, height: 0.55, color: (0.55, 0.53, 0.50), roughness: 0.85 ),
                    offset: (0.0, 0.275, 0.0),
                    rotation_euler_deg: (0.0, 0.0, 0.0),
                    scale: (1.0, 1.0, 1.0),
                ),
                (
                    shape: Sphere,
                    primitive: ( radius: 0.22, color: (0.18, 0.88, 0.35), roughness: 0.10, metallic: 0.05 ),
                    offset: (0.0, 0.77, 0.0),
                    rotation_euler_deg: (0.0, 0.0, 0.0),
                    scale: (1.0, 1.0, 1.0),
                ),
            ],
        ),

        "shrine_speed": (
