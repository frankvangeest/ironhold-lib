(
  schema_version: 1,
  models: {
    "hero": (
      path: "shared/models/character-01.glb#Scene0",
    ),
    "orc": (
      path: "shared/models/creatures/orc.glb#Scene0",
    ),
    "chest_01": (
      path: "shared/models/props/treasure-chest-01.glb#Scene0",
    ),
    "chest_02": (
      path: "shared/models/props/treasure-chest-02.glb#Scene0",
    ),
    "anvil": (
      path: "shared/models/props/anvil.glb#Scene0",
    ),
    "alpaking": (
      path: "shared/models/creatures/alpaking.glb#Scene0",
    ),
    "snake": (
      path: "shared/models/creatures/snake01.glb#Scene0",
    ),
    "spider": (
      path: "shared/models/creatures/spider01.glb#Scene0",
    ),

    // ── Selectable player characters ───────────────────────────────────────────
    // Each GLB is the full rigged character with at least one embedded animation
    // (Idle_Loop). Bevy only creates an AnimationPlayer when a GLTF contains
    // animation data, so every character model MUST include at least one clip —
    // without it, animation_sources retargeting silently does nothing.
    // Additional clips (Walk, Run, attacks, etc.) come from animation_sources.
    "character_male":   ( path: "shared/models/characters/character-male-01.glb#Scene0" ),
    "character_female": ( path: "shared/models/characters/character-female-01.glb#Scene0" ),
    "zombie":           ( path: "shared/models/characters/zombie-01.glb#Scene0" ),

    // ── Animation packs (shared rig — no mesh/material data) ──────────────────
    "anim_locomotion": ( path: "shared/models/characters/character-animations/locomotion.glb#Scene0" ),
    "anim_melee":      ( path: "shared/models/characters/character-animations/melee.glb#Scene0" ),
    "anim_emotes":     ( path: "shared/models/characters/character-animations/emotes.glb#Scene0" ),
    "anim_zombie":     ( path: "shared/models/characters/character-animations/zombie.glb#Scene0" ),
  },

  textures: {
    // Kenney Particle Pack sprites used by combat effects
    "particle/spark_01": "shared/textures/particles/kenney-particle-pack/spark_01.png",
    "particle/spark_02": "shared/textures/particles/kenney-particle-pack/spark_02.png",
    "particle/spark_03": "shared/textures/particles/kenney-particle-pack/spark_03.png",
    "particle/smoke_01": "shared/textures/particles/kenney-particle-pack/smoke_01.png",
    "particle/smoke_02": "shared/textures/particles/kenney-particle-pack/smoke_02.png",
    "particle/magic_04": "shared/textures/particles/kenney-particle-pack/magic_04.png",
    "particle/magic_05": "shared/textures/particles/kenney-particle-pack/magic_05.png",
  },

  audio: {
    "click":     (path: "shared/audio/menu-button-click.wav"),
    "walk":      (path: "shared/audio/walk.wav"),
    "run_grass": (path: "shared/audio/run-grass.wav"),
    "bg_music":  (path: "shared/audio/bg-music-balance.mp3"),
    "swing":     (path: "shared/audio/combat/heave-male.wav", volume: 0.7),
    "hit":       (path: "shared/audio/combat/punch-01.wav",   volume: 0.9),
  },

  effects: {
    // Short orange-red spark burst on a successful attack hit.
    "hit_spark": (
      particle_count: 10,
      lifetime_secs: 0.40,
      speed: 3.0,
      speed_jitter: 0.9,
      spread_deg: 180.0,
      offset: (0.0, 1.2, 0.0),
      size: 0.06,
      size_end: 0.0,
      color_start: (1.0, 0.75, 0.2, 1.0),
      color_end:   (1.0, 0.1,  0.0, 0.0),
      gravity: -4.5,
      sprites: ["particle/spark_01", "particle/spark_02", "particle/spark_03"],
    ),

    // Soft grey smoke puff on enemy death — brief visual "poof".
    "death_poof": (
      particle_count: 8,
      lifetime_secs: 0.70,
      speed: 1.2,
      speed_jitter: 0.4,
      spread_deg: 60.0,
      offset: (0.0, 1.0, 0.0),
      size: 0.18,
      size_end: 0.40,
      color_start: (0.55, 0.55, 0.55, 0.9),
      color_end:   (0.30, 0.30, 0.30, 0.0),
      gravity: -0.5,
      sprites: ["particle/smoke_01", "particle/smoke_02"],
    ),

    // Toxic green droplets spraying from a snake bite — shows at the player's position.
    "venom_splash": (
      particle_count: 8,
      lifetime_secs: 0.55,
      speed: 2.8,
      speed_jitter: 0.9,
      spread_deg: 100.0,
      offset: (0.0, 1.0, 0.0),
      size: 0.05,
      size_end: 0.0,
      color_start: (0.15, 0.95, 0.15, 1.0),
      color_end:   (0.0,  0.40, 0.0,  0.0),
      gravity: -5.5,
      sprites: ["particle/spark_01", "particle/spark_02"],
    ),

    // Dark purple sticky burst when a spider strikes — shows at the player's position.
    "web_burst": (
      particle_count: 6,
      lifetime_secs: 0.65,
      speed: 1.8,
      speed_jitter: 0.5,
      spread_deg: 80.0,
      offset: (0.0, 1.0, 0.0),
      size: 0.07,
      size_end: 0.02,
      color_start: (0.55, 0.05, 0.85, 0.95),
      color_end:   (0.20, 0.0,  0.35, 0.0 ),
      gravity: -3.0,
      sprites: ["particle/smoke_01", "particle/smoke_02"],
    ),

    // Soft cyan/white shimmer on enemy respawn.
    "respawn_glow": (
      particle_count: 16,
      lifetime_secs: 0.90,
      speed: 1.8,
      speed_jitter: 0.5,
      spread_deg: 50.0,
      offset: (0.0, 1.0, 0.0),
      size: 0.07,
      size_end: 0.14,
      color_start: (0.5, 0.95, 1.0, 1.0),
      color_end:   (0.1, 0.50, 0.9, 0.0),
      gravity: 0.8,
      sprites: ["particle/magic_04", "particle/magic_05"],
    ),
  },
  decals: {
    "target_ring": "shared/textures/decals/ring_inverse_gradient.png",
  },
)
