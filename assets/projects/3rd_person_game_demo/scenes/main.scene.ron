(
  schema_version: 2,
  name: "main",

  tonemapping: AcesFitted,

  lighting: (
    // Warm desert ambient — sandy ground reflects warm light upward.
    ambient: (0.28, 0.24, 0.17),
    ambient_brightness: 90.0,
    directional: (
      // Late-afternoon desert sun: warm orange-gold at a low south-west angle.
      // Long shadows separate entities clearly against the flat ground.
      color: (1.0, 0.88, 0.68),
      intensity: 32000.0,
      rotation_euler_deg: (-35.0, 45.0, 0.0),
      shadows_enabled: true,
      shadow_distance: 60.0,
      cascade_overlap: 0.4,
    ),
  ),

  spawn_points: {
    // Player spawns slightly above ground; physics capsule settles immediately.
    "player_start": (0.0, 1.0, 0.0),
  },

  entities: [
    // ── Ground ─────────────────────────────────────────────────────────────────
    // 100×100 Cuboid centred at y=−0.25 so its top surface sits at y=0.
    (
      id: "ground",
      prefab: "ground_plane",
      transform: (
        translation: (0.0, -0.25, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Enemies ────────────────────────────────────────────────────────────────
    // Orc_01 — front-left. Both orcs play idle animation via orc_policy.ron.
    // Click or Tab to select (targetable + click_selectable on prefab).
    (
      id: "orc_01",
      prefab: "enemy_orc_melee",
      transform: (
        translation: (-4.0, 0.0, -5.0),
        rotation_euler_deg: (0.0, 150.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    // Orc_02 — front-right, flanking from the other side.
    (
      id: "orc_02",
      prefab: "enemy_orc_melee",
      transform: (
        translation: (4.5, 0.0, -5.5),
        rotation_euler_deg: (0.0, 215.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Snakes ─────────────────────────────────────────────────────────────────
    // snake_01 — left flank, patrolling; will detect and chase the player.
    (
      id: "snake_01",
      prefab: "enemy_snake",
      transform: (
        translation: (-10.0, 0.0, -4.0),
        rotation_euler_deg: (0.0, 90.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    // snake_02 — deep back-right, an ambush position behind the orcs.
    (
      id: "snake_02",
      prefab: "enemy_snake",
      transform: (
        translation: (6.0, 0.0, -12.0),
        rotation_euler_deg: (0.0, 200.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Spiders ────────────────────────────────────────────────────────────────
    // spider_01 — rear-left. Wide patrol; fast chase makes it dangerous at range.
    (
      id: "spider_01",
      prefab: "enemy_spider",
      transform: (
        translation: (-6.0, 0.0, -12.0),
        rotation_euler_deg: (0.0, 135.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    // spider_02 — far right, patrolling near the chest area — a loot guardian.
    (
      id: "spider_02",
      prefab: "enemy_spider",
      transform: (
        translation: (12.0, 0.0, -3.0),
        rotation_euler_deg: (0.0, 190.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Creatures ──────────────────────────────────────────────────────────────
    // Alpaking hovers 2.5 units above the ground using Flying_Idle animation.
    (
      id: "alpaking_01",
      prefab: "creature_alpaking",
      transform: (
        translation: (9.0, 2.5, -1.5),
        rotation_euler_deg: (0.0, 220.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Props ──────────────────────────────────────────────────────────────────
    // Standalone chest to the player's right. Chest collider bottom = entity_y − 0.4,
    // so placing at y=0.4 puts the bottom flush with the ground.
    (
      id: "chest_01",
      prefab: "chest_01",
      transform: (
        translation: (5.5, 0.4, 3.5),
        rotation_euler_deg: (0.0, -25.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    // Anvil prop — to the left-rear, makes the clearing feel like a camp.
    (
      id: "anvil_01",
      prefab: "prop_anvil",
      transform: (
        translation: (-3.5, 0.0, 4.5),
        rotation_euler_deg: (0.0, 40.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    // Loot display — wooden platform with chest on top (see loot_display prefab).
    // Entity at y=0; platform bottom is flush with ground.
    (
      id: "loot_display_01",
      prefab: "loot_display",
      transform: (
        translation: (-7.0, 0.0, 4.0),
        rotation_euler_deg: (0.0, 20.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
  ],

  ui: [
    // ── Menu / utility buttons ─────────────────────────────────────────────────
    Button((
      id: "start_menu_button",
      text: "Menu",
      action: "ui.start_menu",
      position: (16.0, 16.0),
      size: (80.0, 36.0),
    )),
    Button((
      id: "dance_button",
      text: "Dance",
      action: "ui.dance",
      position: (16.0, 176.0),
      size: (200.0, 44.0),
    )),
    Button((
      id: "test_actions_button",
      text: "Spawn Chest",
      action: "ui.test_actions",
      position: (16.0, 228.0),
      size: (200.0, 44.0),
    )),
    Button((
      id: "hud_mute_button",
      text: "Toggle Mute",
      action: "ui.toggle_mute",
      position: (16.0, 280.0),
      size: (200.0, 44.0),
    )),
    Button((
      id: "hitbox_debug_on_button",
      text: "Hitbox Debug: ON",
      action: "ui.toggle_hitboxes_on",
      position: (16.0, 332.0),
      size: (200.0, 44.0),
    )),
    Button((
      id: "hitbox_debug_off_button",
      text: "Hitbox Debug: OFF",
      action: "ui.toggle_hitboxes_off",
      position: (16.0, 380.0),
      size: (200.0, 44.0),
    )),

    // ── Player stat bars ───────────────────────────────────────────────────────
    // Reads from LoadedStats (populated via stats/stats.ron + stats_path in project.ron).
    StatBar((
      id: "health_bar",
      stat_key: "player_health",
      position: (16.0, 62.0),
      size: (200.0, 16.0),
      fill_color:       (0.85, 0.15, 0.15, 1.0),
      background_color: (0.20, 0.06, 0.06, 1.0),
      show_value: true,
      color_bands: [
        ( above_percent: 0.5,  color: (0.85, 0.15, 0.15, 1.0) ),
        ( above_percent: 0.25, color: (1.0,  0.55, 0.0,  1.0) ),
        ( above_percent: 0.0,  color: (0.6,  0.0,  0.0,  1.0) ),
      ],
      absolute: true,
    )),
    StatBar((
      id: "mana_bar",
      stat_key: "player_mana",
      position: (16.0, 82.0),
      size: (200.0, 10.0),
      fill_color:       (0.25, 0.50, 1.00, 1.0),
      background_color: (0.06, 0.10, 0.22, 1.0),
      absolute: true,
    )),

    // ── Combat status line ─────────────────────────────────────────────────────
    // Shows transient messages: cooldown, not enough mana, etc.
    Label((
      id: "combat_status_label",
      text: "",
      bind: "combat_status",
      format: "{}",
      position: (16.0, 100.0),
      size: (280.0, 22.0),
      align: Left,
    )),

    // ── Target frame ────────────────────────────────────────────────────────────
    // Shows the currently selected target as "<prefab> <id>" (e.g. "enemy_orc_melee orc_01").
    // The "target_display" GameVariable is written directly by the targeting capability
    // (capabilities/targeting.rs) on every select/clear — no rule wiring required.
    // Controls: LMB click enemy to select | T cycle (Shift+T reverse) | LMB empty to clear.
    Label((
      id: "target_label",
      text: "",
      bind: "target_display",
      format: " Target: {}",
      position: (256.0, 16.0),
      size: (500.0, 36.0),
      align: Left,
    )),

    // ── Audio HUD ───────────────────────────────────────────────────────────────
    Label((
      id: "audio_state_hud",
      text: "",
      bind: "audio_state",
      format: " Audio: {}",
      position: (800.0, 16.0),
      size: (220.0, 30.0),
      align: Left,
    )),

    // ── Action bar ─────────────────────────────────────────────────────────────
    // Press 1 to attack the current target (select with LMB or T).
    // Press 2 for a heavy strike that deals double damage (costs mana, longer cooldown).
    // {target} in do_actions is substituted with the current target's spawn ID at runtime.
    // If no target is selected the substitution becomes the literal "{target}" which
    // resolves to no matching entity — the stat modify no-ops silently.
    ActionBar((
      id: "skill_bar",
      position: (416.0, 580.0),
      slot_size: 48.0,
      slot_gap: 4.0,
      background_color: (0.05, 0.05, 0.08, 0.85),
      slots: [
        (
          key: "1",
          icon: "",
          do_actions: [
            PlaySound(key: "swing"),
            ModifyStat(key: "{target}.health", delta: -30.0),
            ShowDamagePopup(entity: "{target}", amount: -30.0),
            SpawnEffect(key: "hit_spark", entity: "{target}"),
          ],
          cooldown_secs: 1.0,
          label: "Attack",
        ),
        (
          key: "2",
          icon: "",
          do_actions: [
            PlaySound(key: "swing"),
            ModifyStat(key: "{target}.health", delta: -60.0),
            ShowDamagePopup(entity: "{target}", amount: -60.0),
            SpawnEffect(key: "hit_spark", entity: "{target}"),
          ],
          cooldown_secs: 6.0,
          cost: (stat: "player_mana", amount: 20.0),
          label: "Heavy Strike",
        ),
        (
          key: "3",
          icon: "",
          do_actions: [
            PlaySound(key: "swing"),
            ModifyStat(key: "{target}.health", delta: -1.0),
            ShowDamagePopup(entity: "{target}", amount: -1.0),
            SpawnEffect(key: "hit_spark", entity: "{target}"),
          ],
          cooldown_secs: 0.2,
          label: "Poke",
        ),
      ],
    )),
  ],
)
