(
  schema_version: 2,
  name: "main",

  show_nameplates: true,
  // Tuned to this project's actual camera-to-widget distances, NOT just the Orbit min_radius/
  // max_radius (3.0/18.0, prefabs.ron) — enemies/props sit elsewhere in the scene, so their
  // distance from the camera is orbit radius PLUS however far they are from the player (this
  // project's NPCs land around 16-26 units from camera across the zoom range). Without this
  // block at all, reference_distance defaults to 50.0 (far outside either range) and the
  // (ref/dist) depth-scale formula stays clamped at 1.0 (no compensation) at every zoom level.
  // First shipped as (8.0, 0.25) — a real-hardware playtest screenshot at max zoom-out showed
  // 14px name text rendering at ~3.5px, illegible (only bar *colour* survived, not fill amount
  // or the "X / Y" numbers). Retuned to (12.0, 0.5): still shrinks enough to stop the crowding,
  // floors at a readable ~7px instead.
  // See docs/20_data_formats.md's "Label depth scaling" section for the full explanation.
  label_depth_scale: (
    reference_distance: 12.0,
    min_scale: 0.5,
  ),
  nameplate_options: (
    faction_filter: All,
    show_player_nameplate: true,  // player's own nameplate shown by default; toggle with the "Nameplate" HUD button
    max_distance: 25.0,
    text_shadow: true,
    // Authored explicitly (matches the schema default) so this is the visible, single source of
    // truth every stat_label/world_stat_bar in prefabs.ron is tuned to share — see their RON
    // comments and docs/20_data_formats.md's "Label depth scaling" callout for why co-located
    // widgets need a shared offset. Changing this value means re-tuning every prefab that shares it.
    offset: (0.0, 2.4, 0.0),
    // No stat_bars here — enemies already use world_stat_bar + stat_label for health display.
    // To add nameplate bars, give entities a stat_templates entry and reference the stat key as
    // "{self}.health" (entity-scoped). Global stats.ron keys (e.g. player_health) are not
    // entity-scoped and will not satisfy a {self}. stat bar — see docs/20_data_formats.md.
  ),

  tonemapping: AcesFitted,

  lighting: (
    // Warm desert ambient — sandy ground reflects warm light upward.
    ambient: (0.28, 0.24, 0.17),
    ambient_brightness: 90.0,
    directional: (
      // Late-afternoon desert sun: warm orange-gold at a low south-west angle.
      // Long shadows separate entities clearly against the flat ground.
      color: (1.0, 0.88, 0.68),
      intensity: 32000.0,
      rotation_euler_deg: (-35.0, 45.0, 0.0),
      shadows_enabled: true,
      shadow_distance: 60.0,
      cascade_overlap: 0.4,
    ),
  ),

  spawn_points: {
    // Player spawns slightly above ground; physics capsule settles immediately.
    "player_start": (0.0, 1.0, 10.0),
    // Chest_02 test-spawn: to the player's right, slightly forward, y=0.4 so the
    // center-origin chest sits flush with the ground.
    "chest_spawn": (4.0, 0.4, 10.5),
  },

  entities: [
    // ── Ground ─────────────────────────────────────────────────────────────────
    // 100×100 Cuboid centred at y=−0.25 so its top surface sits at y=0.
    (
      id: "ground",
      prefab: "ground_plane",
      transform: (
        translation: (0.0, -0.25, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Zombies ────────────────────────────────────────────────────────────────
    // Slow shambling undead in the mid-range. They patrol and chase sluggishly
    // but hit hard — 15 damage per scratch every 4 s.
    (
      id: "zombie_01",
      prefab: "enemy_zombie",
      transform: (
        translation: (2.0, 0.0, -8.0),
        rotation_euler_deg: (0.0, 200.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    (
      id: "zombie_02",
      prefab: "enemy_zombie",
      transform: (
        translation: (-5.0, 0.0, -9.0),
        rotation_euler_deg: (0.0, 160.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Snakes ─────────────────────────────────────────────────────────────────
    // snake_01 — left flank, patrolling; will detect and chase the player.
    (
      id: "snake_01",
      prefab: "enemy_snake",
      transform: (
        translation: (-10.0, 0.0, -4.0),
        rotation_euler_deg: (0.0, 90.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    // snake_02 — deep back-right ambush position.
    (
      id: "snake_02",
      prefab: "enemy_snake",
      transform: (
        translation: (6.0, 0.0, -12.0),
        rotation_euler_deg: (0.0, 200.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Spiders ────────────────────────────────────────────────────────────────
    // spider_01 — rear-left. Wide patrol; fast chase makes it dangerous at range.
    (
      id: "spider_01",
      prefab: "enemy_spider",
      transform: (
        translation: (-6.0, 0.0, -12.0),
        rotation_euler_deg: (0.0, 135.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    // spider_02 — far right, patrolling near the chest area — a loot guardian.
    (
      id: "spider_02",
      prefab: "enemy_spider",
      transform: (
        translation: (12.0, 0.0, -3.0),
        rotation_euler_deg: (0.0, 190.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Friendly NPC ───────────────────────────────────────────────────────────
    // Silver-clad male character near the anvil. Selectable with a green indicator.
    (
      id: "npc_01",
      prefab: "friendly_npc_male",
      transform: (
        translation: (6.0, 0.0, 6.0),
        rotation_euler_deg: (0.0, 160.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // Merchant NPC — press F near this character to open the shop panel.
    (
      id: "merchant_01",
      prefab: "merchant_vendor",
      transform: (
        translation: (-8.0, 0.0, 10.0),
        rotation_euler_deg: (0.0, 45.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Props ──────────────────────────────────────────────────────────────────
    // Standalone chest to the player's right. Chest collider bottom = entity_y − 0.4,
    // so placing at y=0.4 puts the bottom flush with the ground.
    (
      id: "chest_01",
      prefab: "chest_01",
      transform: (
        translation: (-2.5, 0.4, 10.5),
        rotation_euler_deg: (0.0, -25.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    // Anvil prop — to the left-rear, makes the clearing feel like a camp.
    (
      id: "anvil_01",
      prefab: "prop_anvil",
      transform: (
        translation: (-3.5, 0.0, 4.5),
        rotation_euler_deg: (0.0, 40.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    // Loot display — wooden platform with chest on top (see loot_display prefab).
    // Entity at y=0; platform bottom is flush with ground.
    (
      id: "loot_display_01",
      prefab: "loot_display",
      transform: (
        translation: (-7.0, 0.0, 4.0),
        rotation_euler_deg: (0.0, 20.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
  ],

  ui: [
    // ── Menu / utility buttons ─────────────────────────────────────────────────
    Button((
      id: "start_menu_button",
      text: "Menu",
      action: "ui.start_menu",
      position: (16.0, 16.0),
      size: (80.0, 36.0),
    )),
    Button((
      id: "dance_button",
      text: "Dance",
      action: "ui.dance",
      position: (16.0, 176.0),
      size: (200.0, 44.0),
    )),
    Button((
      id: "test_actions_button",
      text: "Spawn Chest",
      action: "ui.test_actions",
      position: (16.0, 228.0),
      size: (200.0, 44.0),
    )),
    Button((
      id: "toggle_nameplate_button",
      // Originally shortened to "Nameplate" because "Toggle Nameplate" overflowed this 200px-wide
      // button at the fixed 26px default (ButtonDef had no font_size field at the time — caught
      // via a real playtest screenshot). Restored to the full label with a smaller font_size
      // instead of widening the box (widening risks colliding with target_label at x=256, since
      // this button's box starts at x=16) — see docs/20_data_formats.md's Button table.
      text: "Toggle Nameplate",
      font_size: 20.0,
      action: "ui.toggle_own_nameplate",
      position: (16.0, 280.0),
      size: (200.0, 44.0),
    )),
    Button((
      id: "hitbox_debug_on_button",
      text: "Hitbox: ON",
      action: "ui.toggle_hitboxes_on",
      position: (16.0, 332.0),
      size: (200.0, 44.0),
    )),
    Button((
      id: "hitbox_debug_off_button",
      text: "Hitbox: OFF",
      action: "ui.toggle_hitboxes_off",
      position: (16.0, 380.0),
      size: (200.0, 44.0),
    )),

    // ── Player stat bars ───────────────────────────────────────────────────────
    // Reads from LoadedStats (populated via stats/stats.ron + stats_path in project.ron).
    StatBar((
      id: "health_bar",
      stat_key: "player_health",
      position: (16.0, 62.0),
      size: (200.0, 16.0),
      fill_color:       (0.85, 0.15, 0.15, 1.0),
      background_color: (0.20, 0.06, 0.06, 1.0),
      show_value: true,
      color_bands: [
        ( above_percent: 0.5,  color: (0.85, 0.15, 0.15, 1.0) ),
        ( above_percent: 0.25, color: (1.0,  0.55, 0.0,  1.0) ),
        ( above_percent: 0.0,  color: (0.6,  0.0,  0.0,  1.0) ),
      ],
      absolute: true,
    )),
    StatBar((
      id: "mana_bar",
      stat_key: "player_mana",
      position: (16.0, 82.0),
      size: (200.0, 10.0),
      fill_color:       (0.25, 0.50, 1.00, 1.0),
      background_color: (0.06, 0.10, 0.22, 1.0),
      absolute: true,
    )),

    // ── Combat status line ─────────────────────────────────────────────────────
    // Shows transient messages: cooldown, not enough mana, etc.
    Label((
      id: "combat_status_label",
      text: "",
      bind: "combat_status",
      format: "{}",
      position: (16.0, 100.0),
      size: (280.0, 22.0),
      align: Left,
    )),

    // ── Target frame ────────────────────────────────────────────────────────────
    // Shows the currently selected target as "<prefab> <id>" (e.g. "enemy_orc_melee orc_01").
    // The "target_display" GameVariable is written directly by the targeting capability
    // (capabilities/targeting.rs) on every select/clear — no rule wiring required.
    // Controls: LMB click enemy to select | T cycle (Shift+T reverse) | LMB empty to clear.
    Label((
      id: "target_label",
      text: "",
      bind: "target_display",
      format: " Target: {}",
      position: (256.0, 16.0),
      size: (500.0, 36.0),
      align: Left,
    )),

    // ── Audio HUD ───────────────────────────────────────────────────────────────
    // "audio_muted" is not written automatically — it's kept in sync by the
    // audio.muted/audio.unmuted rules in logic/state_machine.ron. Any IconButton's
    // `bind` needs a matching SetVariable("<key>", "true"/"false") rule pair.
    IconButton((
      id: "hud_audio_toggle",
      action: "ui.toggle_mute",
      // icon_on/icon_off name which state of `bind` shows them, not which state the artwork
      // depicts — bind is "audio_muted", so icon_on (shown when muted) is the no-sound art
      // (audioOff.png) and icon_off (shown when unmuted) is the sound-wave art (audioOn.png).
      icon_on: "ui/audio_off",
      icon_off: "ui/audio_on",
      bind: "audio_muted",
      position: (976.0, 26.0),
      size: (36.0, 36.0),
      icon_color: (0.90, 0.75, 0.40, 1.0),   // warm brass, matches the desert HUD palette
      active_color: (0.75, 0.40, 0.30, 1.0), // dusty terracotta while muted, draws attention
      hover_color: (1.0, 0.90, 0.65, 1.0),   // lighter brass, subtle hover feedback
      click_color: (1.0, 0.60, 0.15, 1.0),   // brighter amber flash, echoes the late-afternoon sun light
      shadow_offset: (-2.0, 2.0),            // left + down
      shadow_color: (0.75, 0.75, 0.75, 0.55), // light grey, semi-transparent
    )),

    // ── Dialogue panel ─────────────────────────────────────────────────────────
    // Starts hidden; revealed by dialogue_tick_system when a conversation begins.
    // Walk up to the silver guard NPC and press F to start a conversation.
    DialoguePanel((
      id: "npc_dialogue_panel",
      position: (16.0, 440.0),
      size: (1220.0, 200.0),
      background_color: (0.04, 0.04, 0.07, 0.93),
      speaker_font_size: 18.0,
      body_font_size: 15.0,
      choice_font_size: 13.0,
    )),

    // ── Inventory panel ────────────────────────────────────────────────────────
    // Starts hidden. Press I (wired in state_machine.ron) to open.
    // Shows the player's persistent inventory (PlayerInventory resource).
    // Note: OpenInventory/CloseInventory target the panel by node TYPE — only one
    // InventoryPanel per scene is supported. The id field is decorative.
    InventoryPanel((
      id: "player_inventory",
      position: (12.0, 80.0),
      columns: 5,
      rows: 4,
      slot_size: 52.0,
      slot_gap: 4.0,
      background_color: (0.06, 0.06, 0.10, 0.92),
      font_size: 10.0,
      icon_sheet: "icons_items",
      icon_cols: 8,
      icon_rows: 8,
      icon_cell_size: 64,
    )),
// ── Shop panel ─────────────────────────────────────────────────────────────
    // Starts hidden. Walk up to the merchant NPC and press F to open.
    // Populated by OpenShop(merchant_id) from state_machine.ron.
    // The close button is embedded in the panel header (child entity) so it
    // hides together with the panel. No standalone Button needed.
    ShopPanel((
      id: "shop_panel",
      position: (330.0, 80.0),
      size: (320.0, 380.0),
      background_color: (0.06, 0.04, 0.10, 0.92),
      font_size: 13.0,
    )),

// ── Container panel ────────────────────────────────────────────────────────
    // Starts hidden. Opened by OpenContainer(entity_id) from state_machine.ron.
    // Shows the inventory of a container entity (chest, crate, etc.).
    // Includes embedded close button and "Take All" button.
    ContainerPanel((
      id: "chest_panel",
      position: (430.0, 80.0),
      columns: 3,
      rows: 3,
      slot_size: 52.0,
      slot_gap: 4.0,
      background_color: (0.10, 0.08, 0.04, 0.92),
      font_size: 10.0,
      icon_sheet: "icons_items",
      icon_cols: 8,
      icon_rows: 8,
      icon_cell_size: 64,
    )),

    // ── Action bar ─────────────────────────────────────────────────────────────
    // Press 1 to attack the current target (select with LMB or T).
    // Press 2 for a heavy strike that deals double damage (costs mana, longer cooldown).
    // {target} in do_actions is substituted with the current target's spawn ID at runtime.
    // If no target is selected the substitution becomes the literal "{target}" which
    // resolves to no matching entity — the stat modify no-ops silently.
    ActionBar((
      id: "skill_bar",
      position: (416.0, 580.0),
      slot_size: 48.0,
      slot_gap: 4.0,
      background_color: (0.05, 0.05, 0.08, 0.85),
      icon_sheet: "icons_status_effects",
      icon_cols: 8,
      icon_rows: 8,
      icon_cell_size: 64,
      slots: [
        (
          key: "1",
          icon_index: 0,   // Sword Slash
          icon_color: (0.9, 0.75, 0.6, 1.0),
          do_actions: [
            PlayAnimationOn(target: "player_01", clip: "attack_light"),
            PlaySound(key: "swing"),
            ModifyStat(key: "{target}.health", delta: -30.0),
            ShowDamagePopup(entity: "{target}", amount: -30.0),
            SpawnEffect(key: "hit_spark", entity: "{target}"),
            EmitEvent("entity.attacked:{target}"),
          ],
          cooldown_secs: 1.0,
          label: "Attack",
        ),
        (
          key: "2",
          icon_index: 2,   // Dual Strike
          icon_color: (0.75, 0.80, 0.85, 1.0),
          do_actions: [
            PlayAnimationOn(target: "player_01", clip: "attack_heavy"),
            PlaySound(key: "swing"),
            ModifyStat(key: "{target}.health", delta: -60.0),
            ShowDamagePopup(entity: "{target}", amount: -60.0),
            SpawnEffect(key: "hit_spark", entity: "{target}"),
            EmitEvent("entity.attacked:{target}"),
          ],
          cooldown_secs: 6.0,
          cost: (stat: "player_mana", amount: 20.0),
          label: "Heavy Strike",
        ),
        (
          key: "3",
          icon_index: 25,  // Fist Attack
          do_actions: [
            PlaySound(key: "swing"),
            ModifyStat(key: "{target}.health", delta: -1.0),
            ShowDamagePopup(entity: "{target}", amount: -1.0),
            SpawnEffect(key: "hit_spark", entity: "{target}"),
            EmitEvent("entity.attacked:{target}"),
          ],
          cooldown_secs: 0.2,
          label: "Poke",
        ),
        (
          key: "4",
          icon_index: 63,  // Arcane Burst
          icon_color: (0.3, 0.5, 1.0, 1.0),
          do_actions: [
            PlayAnimationOn(target: "player_01", clip: "attack_magic"),
            PlaySound(key: "swing"),
            ModifyStat(key: "{target}.health", delta: -15.0),
            ShowDamagePopup(entity: "{target}", amount: -15.0),
            SpawnEffect(key: "hit_spark", entity: "{target}"),
            EmitEvent("entity.attacked:{target}"),
          ],
          cooldown_secs: 0.3,
          cost: (stat: "player_mana", amount: 18.0),
          label: "Mana Blast",
        ),
        (
          key: "5",
          icon_index: 27,  // Heart Heal
          icon_color: (0.6, 0.0, 0.0, 1.0),
          do_actions: [
            ModifyStat(key: "player_health", delta: 25.0),
            ShowFloatingText(entity: "player_01", text: "+25 HP"),
          ],
          cooldown_secs: 8.0,
          cost: (stat: "player_mana", amount: 15.0),
          label: "Heal",
        ),
        (
          // Non-digit hotkey reference slot — demonstrates key/key_hint/label together.
          // key_hint is what actually renders in the slot's corner; label is reserved for a
          // future hover tooltip and isn't displayed anywhere yet (see docs/20_data_formats.md).
          key: "KeyE",
          icon_index: 4,
          icon_color: (0.6, 0.9, 0.6, 1.0),
          key_hint: "Taunt",
          label: "Taunt",
          do_actions: [
            PlaySound(key: "swing"),
            ShowFloatingText(entity: "player_01", text: "Taunt!"),
            ModifyStat(key: "{target}.health", delta: -5.0),
            ShowDamagePopup(entity: "{target}", amount: -5.0),
            SpawnEffect(key: "hit_spark", entity: "{target}"),
            EmitEvent("entity.attacked:{target}"),
          ],
          cooldown_secs: 3.0,
        ),
        (
          key: "i",
          icon: "icons_items",   // uses items sheet; index 56 = Coin Pouch (magic bag)
          icon_index: 56,
          icon_color: (0.55, 0.35, 0.15, 1.0),   // light brown
          do_actions: [ ToggleInventory ],
          label: "Inventory",
        ),
      ],
    )),
  ],

  // Ground-ring decal shown under the selected target entity.
  // Color resolves per prefab: indicator_color > indicator_category > color fallback.
  // Fallback cyan = generic use/interact target with no explicit category.
  target_indicator: (
    texture: "target_ring",
    radius: 1.2,
    color: (0.3, 0.8, 1.0, 0.75),  // cyan — default fallback (use / interact)
    offset_y: 0.05,
    named_colors: {
      "hostile":  (1.0, 0.15, 0.15, 0.85),  // red    — enemies
      "neutral":  (1.0, 0.80, 0.15, 0.85),  // yellow — neutral creatures and chests
      "friendly": (0.2, 1.0,  0.3,  0.85),  // green  — friendly NPCs
    },
  ),
)
