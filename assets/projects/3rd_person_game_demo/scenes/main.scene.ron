(
  schema_version: 2,
  name: "main",

  // AcesFitted: cinematic, high-performance tonemapper. No LUT required.
  tonemapping: AcesFitted,

  lighting: Some((
    // Cool sky fill — low enough to let directional shadows read clearly.
    ambient: Some((0.18, 0.22, 0.35)),
    ambient_brightness: Some(80.0),
    directional: Some((
      // Warm midday sun from a shallow south-west angle for long shadow definition.
      color: (1.0, 0.92, 0.75),
      intensity: 28000.0,
      rotation_euler_deg: (-40.0, 30.0, 0.0),
      shadows_enabled: true,
    )),
  )),

  terrain: Some((
    heightmap: "projects/3rd_person_game_demo/terrain/heightmap.png",
    splatmap: "shared/terrain/splatmap.png",
    // scale: (horizontal units/pixel, max height in world units, horizontal units/pixel)
    // 1024×1024 heightmap × 0.5 = ~512×512 unit terrain; max elevation 30 units.
    scale: (0.5, 30.0, 0.5),
    // Offset the terrain down so the player spawn at (0, 4, 0) sits above the surface.
    position: Some((0.0, -20.0, 0.0)),
    material_paths: [
      "shared/terrain/grass.png",
      "shared/terrain/rock.png",
      "shared/terrain/dirt.png",
      "shared/terrain/snow.png",
    ],
  )),

  spawn_points: {
    "player_start": (0.0, 4.0, 0.0),
  },

  entities: [
    (
      id: "player_01",
      prefab: "player_warrior",
      transform: (
        translation: (0.0, 4.0, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    (
      id: "chest_01",
      prefab: "chest_01",
      transform: (
        translation: (4.0, 0.0, 0.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
    (
      id: "alpaking_01",
      prefab: "creature_alpaking",
      transform: (
        translation: (4.0, 0.0, -4.0),
        rotation_euler_deg: (0.0, 180.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),
  ],

  ui: [
    (
      kind: "button",
      id: "start_menu_button",
      text: "Start Menu",
      action: "ui.start_menu",
      position: (100.0, 100.0),
      size: (200.0, 60.0),
    ),
    (
      kind: "button",
      id: "dance_button",
      text: "Dance",
      action: "ui.dance",
      position: (100.0, 180.0),
      size: (200.0, 60.0),
    ),
    (
      kind: "button",
      id: "test_actions_button",
      text: "Test Actions",
      action: "ui.test_actions",
      position: (100.0, 260.0),
      size: (200.0, 60.0),
    ),
  ],
)
