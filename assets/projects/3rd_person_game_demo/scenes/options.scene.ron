// Options screen laid out with nested `Group`s instead of hand-computed pixel positions: one
// Column holds the sections, each section is its own Column, and the four volume buttons are a
// Row. Spacing is `gap` (8 between items in a section, 24 between sections), so adding or
// removing a line no longer means re-typing every y coordinate below it.
// See "Group" in docs/20_data_formats.md and assets/projects/ui_demo for more patterns.
(
  schema_version: 2,
  name: "options",

  lighting: (
    ambient: (0.3, 0.3, 0.35),
    directional: (
      color: (1.0, 0.95, 0.85),
      intensity: 8000.0,
      rotation_euler_deg: (-30.0, 45.0, 0.0),
    ),
  ),

  entities: [],

  ui: [
    Group((
      id: "options_root",
      flex_direction: Column,
      gap: 24.0,
      position: (100.0, 30.0),
      children: [

        // --- Controls ---
        Group((
          id: "controls_section",
          flex_direction: Column,
          gap: 8.0,
          children: [
            Label((
              id: "controls_heading",
              text: "Controls",
              size: (300.0, 35.0),
            )),
            Label((
              id: "ctrl_move",
              text: "Move:    WASD  /  Left Stick",
              size: (400.0, 30.0),
            )),
            Label((
              id: "ctrl_camera",
              text: "Camera:  Mouse  /  Right Stick",
              size: (400.0, 30.0),
            )),
            Label((
              id: "ctrl_sprint",
              text: "Sprint:  Shift  /  Left Trigger",
              size: (400.0, 30.0),
            )),
            Label((
              id: "ctrl_dance",
              text: "Dance:   In-game button",
              size: (400.0, 30.0),
            )),
          ],
        )),

        // --- Audio ---
        Group((
          id: "volume_section",
          flex_direction: Column,
          gap: 8.0,
          children: [
            Label((
              id: "audio_heading",
              text: "Volume",
              size: (300.0, 35.0),
            )),
            // Volume preset buttons: 25 / 50 / 75 / 100 (no hard-mute; use Toggle Mute below)
            Group((
              id: "volume_buttons",
              flex_direction: Row,
              gap: 10.0,
              children: [
                Button((
                  id: "vol_25",
                  text: "25%",
                  action: "ui.set_volume_25",
                  size: (90.0, 50.0),
                )),
                Button((
                  id: "vol_50",
                  text: "50%",
                  action: "ui.set_volume_50",
                  size: (90.0, 50.0),
                )),
                Button((
                  id: "vol_75",
                  text: "75%",
                  action: "ui.set_volume_75",
                  size: (90.0, 50.0),
                )),
                Button((
                  id: "vol_100",
                  text: "100%",
                  action: "ui.set_volume_100",
                  size: (90.0, 50.0),
                )),
              ],
            )),
          ],
        )),

        // Mute toggle: shows live state via bound label.
        Group((
          id: "mute_section",
          flex_direction: Column,
          gap: 8.0,
          children: [
            Label((
              id: "options_audio_state",
              text: "",
              bind: "audio_state",
              format: "Audio: {}",
              size: (300.0, 30.0),
              align: Left,
            )),
            Button((
              id: "toggle_mute",
              text: "Toggle Mute",
              action: "ui.toggle_mute",
              size: (200.0, 50.0),
            )),
          ],
        )),

        // --- Navigation ---
        Button((
          id: "back_button",
          text: "< Back",
          action: "ui.back_to_start_menu",
          size: (300.0, 65.0),
        )),
      ],
    )),
  ],
)
