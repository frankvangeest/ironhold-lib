// Options screen laid out with nested `Group`s instead of hand-computed pixel positions: one
// Column holds a title and three framed sections, each section is its own Column with padding
// and a background, and the four volume buttons are a Row. Spacing is `gap` and `padding`, so
// adding or removing a line no longer means re-typing every y coordinate below it.
// See "Group" in docs/20_data_formats.md and assets/projects/ui_demo for more patterns.
(
  schema_version: 2,
  name: "options",

  lighting: (
    ambient: (0.3, 0.3, 0.35),
    directional: (
      color: (1.0, 0.95, 0.85),
      intensity: 8000.0,
      rotation_euler_deg: (-30.0, 45.0, 0.0),
    ),
  ),

  entities: [],

  ui: [
    Group((
      id: "options_root",
      flex_direction: Column,
      gap: 16.0,
      position: (100.0, 24.0),
      children: [

        Label((
          id: "options_title",
          text: "Options",
          size: (620.0, 44.0),
          align: Left,
          font_size: 34.0,
        )),

        // --- Controls ---
        Group((
          id: "controls_section",
          flex_direction: Column,
          gap: 6.0,
          padding: 12.0,
          background_color: (0.10, 0.12, 0.18, 0.85),
          children: [
            Label((
              id: "controls_heading",
              text: "Controls",
              size: (596.0, 32.0),
              align: Left,
              font_size: 26.0,
            )),
            Label((
              id: "ctrl_move",
              text: "Move:    WASD  /  Left Stick",
              size: (596.0, 28.0),
              align: Left,
              font_size: 20.0,
            )),
            Label((
              id: "ctrl_camera",
              text: "Camera:  Mouse  /  Right Stick",
              size: (596.0, 28.0),
              align: Left,
              font_size: 20.0,
            )),
            Label((
              id: "ctrl_sprint",
              text: "Sprint:  Shift  /  Left Trigger",
              size: (596.0, 28.0),
              align: Left,
              font_size: 20.0,
            )),
            Label((
              id: "ctrl_dance",
              text: "Dance:   In-game button",
              size: (596.0, 28.0),
              align: Left,
              font_size: 20.0,
            )),
          ],
        )),

        // --- Audio ---
        Group((
          id: "volume_section",
          flex_direction: Column,
          gap: 8.0,
          padding: 12.0,
          background_color: (0.10, 0.12, 0.18, 0.85),
          children: [
            // `audio_volume_percent` is written by the engine (the chosen preset, e.g. "75"): no
            // state_machine.ron rule is needed, and it reads the current preset (100% at startup).
            // Mute is different: it is NOT written automatically (see `options_audio_state` below).
            Label((
              id: "audio_heading",
              text: "",
              bind: "audio_volume_percent",
              format: "Volume: {}%",
              size: (596.0, 32.0),
              align: Left,
              font_size: 26.0,
            )),
            // Volume preset buttons: 25 / 50 / 75 / 100 (no hard-mute; use Toggle Mute below)
            Group((
              id: "volume_buttons",
              flex_direction: Row,
              gap: 10.0,
              children: [
                Button((
                  id: "vol_25",
                  text: "25%",
                  action: "ui.set_volume_25",
                  size: (90.0, 50.0),
                )),
                Button((
                  id: "vol_50",
                  text: "50%",
                  action: "ui.set_volume_50",
                  size: (90.0, 50.0),
                )),
                Button((
                  id: "vol_75",
                  text: "75%",
                  action: "ui.set_volume_75",
                  size: (90.0, 50.0),
                )),
                Button((
                  id: "vol_100",
                  text: "100%",
                  action: "ui.set_volume_100",
                  size: (90.0, 50.0),
                )),
              ],
            )),
          ],
        )),

        // Mute toggle: shows live state via bound label.
        Group((
          id: "mute_section",
          flex_direction: Row,
          align_items: Center,
          gap: 16.0,
          padding: 12.0,
          background_color: (0.10, 0.12, 0.18, 0.85),
          children: [
            Button((
              id: "toggle_mute",
              text: "Toggle Mute",
              action: "ui.toggle_mute",
              size: (200.0, 50.0),
            )),
            Label((
              id: "options_audio_state",
              text: "",
              bind: "audio_state",
              format: "Audio: {}",
              size: (200.0, 30.0),
              align: Left,
              font_size: 22.0,
            )),
          ],
        )),

        // --- Navigation ---
        Button((
          id: "back_button",
          text: "< Back",
          action: "ui.back_to_start_menu",
          size: (300.0, 56.0),
        )),
      ],
    )),
  ],
)
