(
  schema_version: 2,
  name: "options",

  lighting: (
    ambient: (0.3, 0.3, 0.35),
    directional: (
      color: (1.0, 0.95, 0.85),
      intensity: 8000.0,
      rotation_euler_deg: (-30.0, 45.0, 0.0),
    ),
  ),

  entities: [],

  ui: [
    // --- Controls ---
    Label((
      id: "controls_heading",
      text: "Controls",
      position: (100.0, 30.0),
      size: (300.0, 35.0),
    )),
    Label((
      id: "ctrl_move",
      text: "Move:    WASD  /  Left Stick",
      position: (100.0, 70.0),
      size: (400.0, 30.0),
    )),
    Label((
      id: "ctrl_camera",
      text: "Camera:  Mouse  /  Right Stick",
      position: (100.0, 105.0),
      size: (400.0, 30.0),
    )),
    Label((
      id: "ctrl_sprint",
      text: "Sprint:  Shift  /  Left Trigger",
      position: (100.0, 140.0),
      size: (400.0, 30.0),
    )),
    Label((
      id: "ctrl_dance",
      text: "Dance:   In-game button",
      position: (100.0, 175.0),
      size: (400.0, 30.0),
    )),

    // --- Audio ---
    Label((
      id: "audio_heading",
      text: "Volume",
      position: (100.0, 230.0),
      size: (300.0, 35.0),
    )),
    // Volume preset buttons — 25 / 50 / 75 / 100 (no hard-mute; use Toggle Mute below)
    Button((
      id: "vol_25",
      text: "25%",
      action: "ui.set_volume_25",
      position: (100.0, 270.0),
      size: (90.0, 50.0),
    )),
    Button((
      id: "vol_50",
      text: "50%",
      action: "ui.set_volume_50",
      position: (200.0, 270.0),
      size: (90.0, 50.0),
    )),
    Button((
      id: "vol_75",
      text: "75%",
      action: "ui.set_volume_75",
      position: (300.0, 270.0),
      size: (90.0, 50.0),
    )),
    Button((
      id: "vol_100",
      text: "100%",
      action: "ui.set_volume_100",
      position: (400.0, 270.0),
      size: (90.0, 50.0),
    )),

    // Mute toggle — shows live state via bound label.
    Label((
      id: "options_audio_state",
      text: "",
      bind: "audio_state",
      format: "Audio: {}",
      position: (100.0, 335.0),
      size: (300.0, 30.0),
      align: Left,
    )),
    Button((
      id: "toggle_mute",
      text: "Toggle Mute",
      action: "ui.toggle_mute",
      position: (100.0, 375.0),
      size: (200.0, 50.0),
    )),

    // --- Navigation ---
    Button((
      id: "back_button",
      text: "< Back",
      action: "ui.back_to_start_menu",
      position: (100.0, 445.0),
      size: (300.0, 65.0),
    )),
  ],
)
