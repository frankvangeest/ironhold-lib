(
    schema_version: 1,
    initial_state: "menu",

    // Mirror audio state events into a GameVariable so any bound Label shows live state.
    // SyncAudioState in each state's entry_actions re-emits the current state on entry,
    // ensuring labels are correct on first project load and after navigating between scenes.
    global_on: [
        ( event: "audio.muted",   do_actions: [ SetVariable("audio_state", "Muted")    ] ),
        ( event: "audio.unmuted", do_actions: [ SetVariable("audio_state", "Sound On") ] ),
    ],

    states: [
        (
            name: "menu",
            entry_actions: [ SyncAudioState ],
            exit_actions: [],
            on: [
                ( event: "ui.button_pressed:start_game", do_actions: [ LoadScene("scenes/character_select.scene.ron") ] ),
                ( event: "ui.button_pressed:options",    do_actions: [ LoadScene("scenes/options.scene.ron") ] ),
                ( event: "ui.button_pressed:quit",       do_actions: [ Quit ] ),
                // Fallback: main scene loaded directly (e.g. browser screenshot test bypassing
                // character select). Spawn the male character so the scene is never playerless.
                ( event: "scene.ready:main", do_actions: [
                    Spawn(prefab: "player_male", id: "player_01", spawn_point: "player_start"),
                ]),
            ],
        ),
        (
            // Options is a full scene swap (no overlay) until modal backdrop / click-blocking
            // is implemented (see backlog: "overlay modal backdrop").
            name: "options",
            entry_actions: [ SyncAudioState ],
            exit_actions: [],
            on: [
                ( event: "ui.button_pressed:back_to_start_menu", do_actions: [ LoadScene("scenes/start_menu.scene.ron") ] ),
                ( event: "ui.button_pressed:set_volume_25",  do_actions: [ SetVolume(25)  ] ),
                ( event: "ui.button_pressed:set_volume_50",  do_actions: [ SetVolume(50)  ] ),
                ( event: "ui.button_pressed:set_volume_75",  do_actions: [ SetVolume(75)  ] ),
                ( event: "ui.button_pressed:set_volume_100", do_actions: [ SetVolume(100) ] ),
                ( event: "ui.button_pressed:toggle_mute",    do_actions: [ ToggleMute     ] ),
            ],
        ),
        (
            // Character selection screen: the player picks which character to play.
            // Clicking a character fires LoadScene(main) AND transitions to the matching
            // spawning_* state, which defers the Spawn call until main is ready.
            name: "selecting",
            entry_actions: [],
            exit_actions: [],
            on: [
                ( event: "ui.button_pressed:select_male",   do_actions: [ LoadScene("scenes/main.scene.ron") ] ),
                ( event: "ui.button_pressed:select_female", do_actions: [ LoadScene("scenes/main.scene.ron") ] ),
                ( event: "ui.button_pressed:back_to_menu",  do_actions: [ LoadScene("scenes/start_menu.scene.ron") ] ),
            ],
        ),
        (
            // Intermediate state: main.scene.ron is loading; character choice was "male".
            // When scene.ready:main fires, spawn the male player then transition to playing.
            // NOTE: id "player_01" is a shared contract — action_bar and ShowFloatingText rules
            //       in the playing state reference this id. All three spawning_* states must use it.
            name: "spawning_male",
            entry_actions: [],
            exit_actions: [],
            on: [
                ( event: "scene.ready:main", do_actions: [
                    Spawn(prefab: "player_male", id: "player_01", spawn_point: "player_start"),
                ]),
            ],
        ),
        (
            name: "spawning_female",
            entry_actions: [],
            exit_actions: [],
            on: [
                ( event: "scene.ready:main", do_actions: [
                    Spawn(prefab: "player_female", id: "player_01", spawn_point: "player_start"),
                ]),
            ],
        ),
        (
            name: "playing",
            entry_actions: [
                PlayMusicLoop(key: "bg_music"),
                PreloadScene("scenes/pause.scene.ron"),
                SyncAudioState,
                // Reset player stats on each play session.
                SetStat(key: "player_health", value: 100.0),
                SetStat(key: "player_mana",   value: 60.0),
                SetVariable("combat_status", ""),
                // Preload animation source GLBs so the player's animation graph is fully
                // decoded before the first attack/death clip fires. Without this, each GLB
                // triggers an async GLTF decode stall the first time its clips are needed.
                PreloadGlb("anim_locomotion"),
                PreloadGlb("anim_melee"),
                PreloadGlb("anim_emotes"),
                PreloadGlb("anim_magic"),
                PreloadGlb("anim_hit_death"),
                PreloadGlb("anim_zombie"),
                // Preload GLB models so first-encounter spawns don't stall on WASM.
                PreloadPrefab("enemy_snake"),
                PreloadPrefab("enemy_spider"),
                PreloadPrefab("enemy_zombie"),
                // Warm WebGPU particle pipelines during the loading window.
                SpawnEffect(key: "hit_spark",    position: (0.0, -100.0, 0.0)),
                SpawnEffect(key: "death_poof",   position: (0.0, -100.0, 0.0)),
                SpawnEffect(key: "respawn_glow", position: (0.0, -100.0, 0.0)),
                SpawnEffect(key: "venom_splash", position: (0.0, -100.0, 0.0)),
                SpawnEffect(key: "web_burst",    position: (0.0, -100.0, 0.0)),
            ],
            exit_actions:  [ StopMusic ],
            on: [
                ( event: "ui.button_pressed:dance",       do_actions: [ PlayAnimationOn(target: "player_01", clip: "dance") ] ),
                ( event: "ui.button_pressed:test_actions",do_actions: [ Spawn(prefab: "chest_02", id: "chest_02_spawned", spawn_point: "chest_spawn") ] ),

                // ── Inventory (action bar slot "i" fires ToggleInventory directly; close button uses close_inventory event) ────
                ( event: "ui.button_pressed:close_inventory",  do_actions: [ CloseInventory ] ),

                // ── Merchant shop ───────────────────────────────────────────────
                // Walk up to merchant_01 and press F — interactable fires entity.interacted:merchant_01.
                ( event: "entity.interacted:merchant_01",  do_actions: [ OpenShop("merchant_01") ] ),
                ( event: "entity.exited:merchant_01",      do_actions: [ CloseShop ] ),
                ( event: "ui.button_pressed:close_shop",   do_actions: [ CloseShop ] ),
                ( event: "ui.button_pressed:buy_item:health_potion",      do_actions: [ BuyItem("health_potion") ] ),
                ( event: "ui.button_pressed:buy_item:mana_potion",        do_actions: [ BuyItem("mana_potion") ] ),
                ( event: "ui.button_pressed:buy_item:iron_sword",         do_actions: [ BuyItem("iron_sword") ] ),
                ( event: "ui.button_pressed:buy_item:old_key",            do_actions: [ BuyItem("old_key") ] ),

                // ── Chest / container inventory ─────────────────────────────────
                // Walk up to chest_01 and press F — opens the ContainerPanel to show
                // what's inside. Use the close button or take-all to interact.
                // chest_01 has initial_items defined in prefabs.ron.
                ( event: "entity.interacted:chest_01",               do_actions: [ OpenContainer("chest_01") ] ),
                ( event: "entity.exited:chest_01",                   do_actions: [ CloseContainer ] ),
                // chest_02_spawned is spawned by the "Spawn Chest" button; contains 500 gold coins.
                ( event: "entity.interacted:chest_02_spawned",       do_actions: [ OpenContainer("chest_02_spawned") ] ),
                ( event: "entity.exited:chest_02_spawned",           do_actions: [ CloseContainer ] ),
                ( event: "ui.button_pressed:close_container",        do_actions: [ CloseContainer ] ),
                ( event: "ui.button_pressed:take_all_from_container", do_actions: [ TakeAllFromContainer ] ),
                ( event: "ui.button_pressed:start_menu",  do_actions: [ LoadScene("scenes/start_menu.scene.ron") ] ),
                ( event: "ui.button_pressed:toggle_mute",        do_actions: [ ToggleMute                                              ] ),
                ( event: "ui.button_pressed:toggle_hitboxes_on",  do_actions: [ SetVariable("debug_target_hitboxes", "true")            ] ),
                ( event: "ui.button_pressed:toggle_hitboxes_off", do_actions: [ SetVariable("debug_target_hitboxes", "false")           ] ),

                // ── Action bar feedback ──────────────────────────────────────────
                ( event: "action_bar.no_target:1",             do_actions: [ SetVariable("combat_status", "No target selected")          ] ),
                ( event: "action_bar.no_target:2",             do_actions: [ SetVariable("combat_status", "No target selected")          ] ),
                ( event: "action_bar.no_target:3",             do_actions: [ SetVariable("combat_status", "No target selected")          ] ),
                ( event: "action_bar.no_target:4",             do_actions: [ SetVariable("combat_status", "No target selected")          ] ),
                ( event: "action_bar.on_cooldown:1",           do_actions: [ SetVariable("combat_status", "Attack on cooldown")          ] ),
                ( event: "action_bar.on_cooldown:2",           do_actions: [ SetVariable("combat_status", "Heavy Strike on cooldown")    ] ),
                ( event: "action_bar.on_cooldown:3",           do_actions: [ SetVariable("combat_status", "Poke on cooldown")            ] ),
                ( event: "action_bar.on_cooldown:4",           do_actions: [ SetVariable("combat_status", "Mana Blast on cooldown")      ] ),
                ( event: "action_bar.insufficient_resource:2", do_actions: [ SetVariable("combat_status", "Not enough mana")             ] ),
                ( event: "action_bar.insufficient_resource:4", do_actions: [ SetVariable("combat_status", "Not enough mana")             ] ),
                ( event: "action_bar.activated:1",             do_actions: [ SetVariable("combat_status", ""), ShowFloatingText(entity: "player_01", text: "Attack!")        ] ),
                ( event: "action_bar.activated:2",             do_actions: [ SetVariable("combat_status", ""), ShowFloatingText(entity: "player_01", text: "Heavy Strike!")  ] ),
                ( event: "action_bar.activated:3",             do_actions: [ SetVariable("combat_status", ""), ShowFloatingText(entity: "player_01", text: "Poke!")          ] ),
                ( event: "action_bar.activated:4",             do_actions: [ SetVariable("combat_status", ""), ShowFloatingText(entity: "player_01", text: "Mana Blast!")    ] ),
                // ── Player death ─────────────────────────────────────────────────
                ( event: "stat.player_health.depleted",        do_actions: [ PlayAnimationOn(target: "player_01", clip: "death") ] ),
            ],
        ),
        (
            name: "paused",
            entry_actions: [ LoadSceneOverlay("scenes/pause.scene.ron") ],
            exit_actions:  [ UnloadOverlay ],
            on: [
                ( event: "ui.button_pressed:pause_quit",  do_actions: [ Quit       ] ),
                ( event: "ui.button_pressed:toggle_mute", do_actions: [ ToggleMute ] ),
            ],
        ),
    ],

    transitions: [
        // Scene lifecycle → state entry.
        ( on: "scene.ready:start_menu",       to: "menu"      ),
        ( on: "scene.ready:options",          to: "options"   ),
        ( on: "scene.ready:character_select", to: "selecting" ),
        // Direct-to-main fallback (no character select): menu state handles the spawn,
        // then this transition advances to playing so all entry_actions fire normally.
        ( from: "menu", on: "scene.ready:main", to: "playing" ),

        // Character selection → spawning intermediate state.
        ( from: "selecting", on: "ui.button_pressed:select_male",   to: "spawning_male"   ),
        ( from: "selecting", on: "ui.button_pressed:select_female", to: "spawning_female" ),

        // Main scene ready in spawning_* state → advance to playing.
        // (scene.ready:main fires AFTER the on: Spawn rule in each spawning_* state,
        //  so the player entity is queued before playing's entry_actions fire.)
        ( from: "spawning_male",   on: "scene.ready:main", to: "playing" ),
        ( from: "spawning_female", on: "scene.ready:main", to: "playing" ),

        // Pause overlay transitions.
        ( from: "playing", on: "ui.button_pressed:toggle_pause", to: "paused"  ),
        ( from: "paused",  on: "ui.button_pressed:toggle_pause", to: "playing" ),
        ( from: "paused",  on: "ui.button_pressed:resume",       to: "playing" ),
    ],
)
