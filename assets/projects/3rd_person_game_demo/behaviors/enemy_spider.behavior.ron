// Spider enemy — wide patrol → fast chase → aggressive claw attack loop.
// npc.player_reached:{self}  fires when the spider closes to approach_distance (2.0 m).
// npc.player_lost:{self}     fires when the player escapes chase_radius.
(
    schema_version: 1,
    initial_state: "alive",

    global_on: [],

    states: [
        (
            name: "alive",
            entry_actions: [
                SetStat(key: "{self}.health", value: 75.0),
                SetEntityVisible(entity: "{self}", visible: true),
                SpawnEffect(key: "respawn_glow", entity: "{self}"),
            ],
            exit_actions: [],
            on: [],
        ),
        (
            name: "attacking",
            // Short wind-up so the animation leads the damage by half a second.
            entry_actions: [
                EmitEventAfterDelay(event: "spider.attack_tick:{self}", delay_secs: 0.5),
            ],
            exit_actions: [],
            on: [
                (
                    event: "spider.attack_tick:{self}",
                    do_actions: [
                        PlayAnimationOn(target: "{self}", clip: "attack"),
                        PlaySound(key: "hit"),
                        ModifyStat(key: "player_health", delta: -12.0),
                        ShowDamagePopup(entity: "player_01", amount: -12.0),
                        SpawnEffect(key: "web_burst", entity: "player_01"),
                        EmitEventAfterDelay(event: "spider.attack_tick:{self}", delay_secs: 2.0),
                    ],
                ),
            ],
        ),
        (
            name: "dead",
            entry_actions: [
                SpawnEffect(key: "death_poof", entity: "{self}"),
                ShowFloatingText(entity: "player_01", text: "You killed {self}!", offset: (0.0, -0.02, 0.0)),
                SetEntityVisible(entity: "{self}", visible: false),
                EmitEventAfterDelay(event: "entity.respawned:{self}", delay_secs: 12.0),
            ],
            exit_actions: [],
            on: [],
        ),
    ],

    transitions: [
        ( from: "alive",     on: "npc.player_reached:{self}",  to: "attacking" ),
        ( from: "attacking", on: "npc.player_lost:{self}",     to: "alive"     ),
        ( from: "alive",     on: "stat.{self}.health.depleted", to: "dead"      ),
        ( from: "attacking", on: "stat.{self}.health.depleted", to: "dead"      ),
        ( from: "dead",      on: "entity.respawned:{self}",     to: "alive"     ),
    ],
)
