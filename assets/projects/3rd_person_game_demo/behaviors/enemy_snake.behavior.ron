// Snake enemy — patrol → chase → bite loop.
// The NPC system handles all movement. This behavior drives attack state and death.
// npc.player_reached:{self}  fires when the snake closes to approach_distance (1.5 m).
// npc.player_lost:{self}     fires when the player exits chase_radius or line-of-sight is broken.
//
// Death (planning/features/monster_corpse_loot.md v2) — same pattern as
// enemy_zombie.behavior.ron: this entity never revives; it swaps for a separate `snake_corpse`
// entity at death and despawns, with a fixed respawn timer armed independently before that.
(
    schema_version: 1,
    initial_state: "alive",

    global_on: [],

    states: [
        (
            name: "alive",
            // npc_revive clears the death-pose override (stop_action sentinel). Only reachable
            // via the "give up chasing" transition below now — this entity is never revived in
            // place after death.
            entry_actions: [
                PlayAnimationOn(target: "{self}", clip: "npc_revive"),
                EmitEvent("npc.revive:{self}"),
                ResetToSpawn("{self}"),
                SetStat(key: "{self}.health", value: 50.0),
                SetEntityVisible(entity: "{self}", visible: true),
                SpawnEffect(key: "respawn_glow", entity: "{self}"),
            ],
            exit_actions: [],
            on: [],
        ),
        (
            name: "attacking",
            // Start the bite loop with a short wind-up so the animation has time to begin
            // before the first damage tick.
            entry_actions: [
                EmitEventAfterDelay(event: "snake.bite_tick:{self}", delay_secs: 0.8),
            ],
            exit_actions: [],
            on: [
                (
                    event: "snake.bite_tick:{self}",
                    do_actions: [
                        PlayAnimationOn(target: "{self}", clip: "bite"),
                        PlaySound(key: "hit"),
                        ModifyStat(key: "player_health", delta: -8.0),
                        ShowDamagePopup(entity: "player_01", amount: -8.0),
                        SpawnEffect(key: "venom_splash", entity: "player_01"),
                        CameraShake(duration_secs: 0.25, intensity: 0.08),
                        // Re-arm the loop. Dropped automatically when state changes.
                        EmitEventAfterDelay(event: "snake.bite_tick:{self}", delay_secs: 3.0),
                    ],
                ),
            ],
        ),
        (
            name: "dead",
            // npc.dead stops the NPC system from moving the corpse for the remainder of the death
            // animation. Death animation is 2.25 s — swap to the corpse once it's finished.
            entry_actions: [
                EmitEvent("npc.dead:{self}"),
                PlayAnimationOn(target: "{self}", clip: "death"),
                SpawnEffect(key: "death_poof", entity: "{self}"),
                ShowFloatingText(entity: "player_01", text: "You killed {self}!", offset: (0.0, -0.02, 0.0)),
                EmitEventAfterDelay(event: "snake.swap_to_corpse:{self}", delay_secs: 2.25),
                EmitEventAfterDelay(event: "monster.respawn:{self}", delay_secs: 60.0),
            ],
            exit_actions: [],
            on: [
                (
                    event: "snake.swap_to_corpse:{self}",
                    do_actions: [
                        Despawn("{self}_corpse"),
                        Spawn(prefab: "snake_corpse", id: "{self}_corpse", at_entity: "{self}"),
                        // Not an immediate Despawn: the corpse spawns Visibility::Hidden and only
                        // reveals once its animation_policy RON loads and its frozen death pose is
                        // confirmed applied (several frames, longer on a cold web fetch) — see
                        // AnimationController.awaiting_reveal in capabilities/animation.rs. Despawning
                        // "{self}" immediately would leave a visible gap with nothing on screen. This
                        // entity's own death clip already played to completion with looping: false, so
                        // it's already sitting frozen on the exact same last frame the corpse spawns
                        // into (same model, same clip, same at_entity transform) — keeping it alive a
                        // little longer costs nothing visually, it's a bit-identical overlap, not a
                        // crossfade.
                        SetDespawnTimer(entity: "{self}", delay_secs: 1.0),
                    ],
                ),
            ],
        ),
    ],

    transitions: [
        ( from: "alive",     on: "npc.player_reached:{self}",   to: "attacking" ),
        ( from: "attacking", on: "npc.player_lost:{self}",      to: "alive"     ),
        ( from: "alive",     on: "stat.{self}.health.depleted", to: "dead"      ),
        ( from: "attacking", on: "stat.{self}.health.depleted", to: "dead"      ),
    ],
)
