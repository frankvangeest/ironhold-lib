// Snake enemy — patrol → chase → bite loop.
// The NPC system handles all movement. This behavior drives attack state and the alive/dead cycle.
// npc.player_reached:{self}  fires when the snake closes to approach_distance (1.5 m).
// npc.player_lost:{self}     fires when the player exits chase_radius or line-of-sight is broken.
(
    schema_version: 1,
    initial_state: "alive",

    global_on: [],

    states: [
        (
            name: "alive",
            // npc_revive clears the death-pose override (stop_action sentinel) so the snake
            // returns to idle rather than staying frozen in its death frame after respawn.
            // ResetToSpawn before SetEntityVisible so the snake never briefly appears at the
            // death spot. SetStat before visible so the stat bar never briefly shows 0 HP.
            entry_actions: [
                PlayAnimationOn(target: "{self}", clip: "npc_revive"),
                EmitEvent("npc.revive:{self}"),
                ResetToSpawn("{self}"),
                SetStat(key: "{self}.health", value: 50.0),
                SetEntityVisible(entity: "{self}", visible: true),
                SpawnEffect(key: "respawn_glow", entity: "{self}"),
            ],
            exit_actions: [],
            on: [],
        ),
        (
            name: "attacking",
            // Start the bite loop with a short wind-up so the animation has time to begin
            // before the first damage tick.
            entry_actions: [
                EmitEventAfterDelay(event: "snake.bite_tick:{self}", delay_secs: 0.8),
            ],
            exit_actions: [],
            on: [
                (
                    event: "snake.bite_tick:{self}",
                    do_actions: [
                        PlayAnimationOn(target: "{self}", clip: "bite"),
                        PlaySound(key: "hit"),
                        ModifyStat(key: "player_health", delta: -8.0),
                        ShowDamagePopup(entity: "player_01", amount: -8.0),
                        SpawnEffect(key: "venom_splash", entity: "player_01"),
                        CameraShake(duration_secs: 0.25, intensity: 0.08),
                        // Re-arm the loop. Dropped automatically when state changes.
                        EmitEventAfterDelay(event: "snake.bite_tick:{self}", delay_secs: 3.0),
                    ],
                ),
            ],
        ),
        (
            name: "dead",
            // npc.dead stops the NPC system from moving the corpse.
            // Death animation is 2.25 s; hide at 3 s so it completes before disappearing.
            // Respawn at 15 s from death so the area has a brief rest window.
            entry_actions: [
                EmitEvent("npc.dead:{self}"),
                PlayAnimationOn(target: "{self}", clip: "death"),
                SpawnEffect(key: "death_poof", entity: "{self}"),
                ShowFloatingText(entity: "player_01", text: "You killed {self}!", offset: (0.0, -0.02, 0.0)),
                EmitEventAfterDelay(event: "snake.hide:{self}", delay_secs: 10.0),
                EmitEventAfterDelay(event: "entity.respawned:{self}", delay_secs: 25.0),
            ],
            exit_actions: [],
            on: [
                (
                    event: "snake.hide:{self}",
                    do_actions: [
                        SetEntityVisible(entity: "{self}", visible: false),
                    ],
                ),
            ],
        ),
    ],

    transitions: [
        ( from: "alive",     on: "npc.player_reached:{self}",   to: "attacking" ),
        ( from: "attacking", on: "npc.player_lost:{self}",      to: "alive"     ),
        ( from: "alive",     on: "stat.{self}.health.depleted", to: "dead"      ),
        ( from: "attacking", on: "stat.{self}.health.depleted", to: "dead"      ),
        ( from: "dead",      on: "entity.respawned:{self}",     to: "alive"     ),
    ],
)
