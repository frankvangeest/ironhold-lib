(
  schema_version: 2,
  prefabs: {
    "player_warrior": (
      kind: Actor,
      model: "hero",
      animation_policy: "prefabs/animation/player_policy.ron",
      components: (
        tags: ["player"],
        camera: (
          offset:         (0.0, 2.5, 8.0),
          look_at_offset: (0.0, 1.0, 0.0),
          zoom_speed:     8.0,
          orbit_speed:    0.4,
          min_radius:     3.0,
          max_radius:     18.0,
          // RMB-only orbit frees LMB for click-to-select targeting.
          orbit_button: "Right",
        ),
        inputs: (
          forward:      "KeyW",
          backward:     "KeyS",
          left:         "KeyA",
          right:        "KeyD",
          strafe_left:  "KeyQ",
          strafe_right: "KeyE",
          jump:         "Space",
          // "Tab" is intercepted by browsers for focus management.
          // KeyT is reliable and won't fight the browser.
          target_next:  "KeyT",
        ),
      ),
    ),

    // ── Selectable player characters ───────────────────────────────────────────
    // All three use the character-animations pack via animation_sources.
    // Male and female share player_policy_human.ron (same rig, same clips).
    // Zombie uses player_policy_zombie.ron (zombie-specific clips only).
    "player_male": (
      kind: Actor,
      model: "character_male",
      animation_policy: "prefabs/animation/player_policy_human.ron",
      components: (
        tags: ["player"],
        camera: (
          offset:         (0.0, 2.5, 8.0),
          look_at_offset: (0.0, 1.0, 0.0),
          zoom_speed:     8.0,
          orbit_speed:    0.4,
          min_radius:     3.0,
          max_radius:     18.0,
          orbit_button: "Right",
        ),
        inputs: (
          forward:      "KeyW",
          backward:     "KeyS",
          left:         "KeyA",
          right:        "KeyD",
          strafe_left:  "KeyQ",
          strafe_right: "KeyE",
          jump:         "Space",
          target_next:  "KeyT",
        ),
      ),
    ),

    "player_female": (
      kind: Actor,
      model: "character_female",
      animation_policy: "prefabs/animation/player_policy_human.ron",
      components: (
        tags: ["player"],
        camera: (
          offset:         (0.0, 2.5, 8.0),
          look_at_offset: (0.0, 1.0, 0.0),
          zoom_speed:     8.0,
          orbit_speed:    0.4,
          min_radius:     3.0,
          max_radius:     18.0,
          orbit_button: "Right",
        ),
        inputs: (
          forward:      "KeyW",
          backward:     "KeyS",
          left:         "KeyA",
          right:        "KeyD",
          strafe_left:  "KeyQ",
          strafe_right: "KeyE",
          jump:         "Space",
          target_next:  "KeyT",
        ),
      ),
    ),

    // ── Character select preview props ────────────────────────────────────────
    // Display-only props on the character select screen: same models as the
    // selectable players but NO tags: ["player"], no camera, and no inputs.
    // Use full GLBs (not mesh-only) so Bevy creates an AnimationPlayer on the
    // armature root — required for idle animation to play via animation_sources.
    "preview_male": (
      kind: Actor,
      model: "character_male",
      animation_policy: "prefabs/animation/player_policy_human.ron",
      components: (),
    ),
    "preview_female": (
      kind: Actor,
      model: "character_female",
      animation_policy: "prefabs/animation/player_policy_human.ron",
      components: (),
    ),

    // ── Zombie enemy ──────────────────────────────────────────────────────────
    // Slow shambling undead. Patrols a diamond, shuffles toward the player on
    // detection, and scratches hard but rarely. High HP compensates for low speed.
    "enemy_zombie": (
      kind: Actor,
      model: "zombie",
      animation_policy: "prefabs/animation/player_policy_zombie.ron",
      components: (
        tags: ["enemy"],
        npc: (
          faction: Hostile,
          on_player_near: Chase,
          detection_radius: 6.0,
          chase_radius: 12.0,
          approach_distance: 1.8,
          patrol_speed: 0.8,
          chase_speed: 1.5,
          eye_height: 1.7,
          collider_height: 1.8,
          collider_radius: 0.3,
          investigate_timeout_secs: 20.0,
          patrol_waypoints: [
            ( 3.0, 0.0,  0.0),
            ( 0.0, 0.0,  3.0),
            (-3.0, 0.0,  0.0),
            ( 0.0, 0.0, -3.0),
          ],
        ),
      ),
      targetable: true,
      click_selectable: true,
      indicator_category: "hostile",
      behavior: "behaviors/enemy_zombie.behavior.ron",
      stat_templates: [
        (
          key: "health",
          base: 120.0,
          min: 0.0,
          max: 120.0,
          regen_rate: 0.0,
          regen_delay: 0.0,
          thresholds: [
            ( when: BelowOrEqual(0.0), emit: "stat.{self}.health.depleted" ),
          ],
        ),
      ],
      stat_label: (
        stat_key: "{self}.health",
        offset: (0.0, 2.8, 0.0),
        font_size: 14.0,
        color: (0.45, 0.85, 0.35, 0.9),
        show_max: true,
      ),
      world_stat_bar: (
        stat_key: "{self}.health",
        offset: (0.0, 3.1, 0.0),
        fill_color: (0.25, 0.70, 0.15, 1.0),
        bg_color:   (0.05, 0.15, 0.02, 0.85),
        color_bands: [
          (0.0,  (0.85, 0.12, 0.12, 1.0)),
          (0.3,  (0.95, 0.75, 0.10, 1.0)),
          (0.6,  (0.25, 0.70, 0.15, 1.0)),
        ],
        style: Pixel( size: (56.0, 7.0) ),
      ),
    ),

    // ── Snake enemy ────────────────────────────────────────────────────────────────
    // Ground-level ambush predator. Patrols a small diamond, chases at moderate speed,
    // bites the player every 3 s when in range. Health bar placed low to match body height.
    "enemy_snake": (
      kind: Actor,
      model: "snake",
      animation_policy: "prefabs/animation/snake_policy.ron",
      components: (
        tags: ["enemy"],
        npc: (
          faction: Hostile,
          on_player_near: Chase,
          detection_radius: 7.0,
          chase_radius: 14.0,
          approach_distance: 1.5,
          patrol_speed: 1.5,
          chase_speed: 3.5,
          eye_height: 0.3,
          collider_height: 0.8,
          collider_radius: 0.3,
          investigate_timeout_secs: 15.0,
          patrol_waypoints: [
            ( 4.0, 0.0,  0.0),
            ( 0.0, 0.0,  4.0),
            (-4.0, 0.0,  0.0),
            ( 0.0, 0.0, -4.0),
          ],
        ),
      ),
      targetable: true,
      click_selectable: true,
      select_aim_height: 0.4,
      indicator_category: "hostile",
      behavior: "behaviors/enemy_snake.behavior.ron",
      stat_templates: [
        (
          key: "health",
          base: 50.0,
          min: 0.0,
          max: 50.0,
          regen_rate: 0.0,
          regen_delay: 0.0,
          thresholds: [
            ( when: BelowOrEqual(0.0), emit: "stat.{self}.health.depleted" ),
          ],
        ),
      ],
      stat_label: (
        stat_key: "{self}.health",
        offset: (0.0, 1.3, 0.0),
        font_size: 13.0,
        color: (0.25, 0.95, 0.25, 0.9),
        show_max: true,
      ),
      world_stat_bar: (
        stat_key: "{self}.health",
        offset: (0.0, 1.55, 0.0),
        fill_color: (0.12, 0.85, 0.18, 1.0),
        bg_color:   (0.02, 0.18, 0.03, 0.85),
        color_bands: [
          (0.0,  (0.85, 0.12, 0.12, 1.0)),
          (0.3,  (0.95, 0.75, 0.10, 1.0)),
          (0.6,  (0.12, 0.85, 0.18, 1.0)),
        ],
        style: Pixel( size: (44.0, 6.0) ),
      ),
    ),

    // ── Spider enemy ───────────────────────────────────────────────────────────────
    // Aggressive pursuit predator. Wide patrol, fast chase, strikes every 2 s.
    // Taller model so health bar sits higher; purple theme.
    "enemy_spider": (
      kind: Actor,
      model: "spider",
      animation_policy: "prefabs/animation/spider_policy.ron",
      components: (
        tags: ["enemy"],
        npc: (
          faction: Hostile,
          on_player_near: Chase,
          detection_radius: 10.0,
          chase_radius: 18.0,
          approach_distance: 2.0,
          patrol_speed: 2.0,
          chase_speed: 5.0,
          waypoint_wait_secs: 2.0,
          eye_height: 0.5,
          alerted_duration: 0.1,
          collider_height: 1.2,
          collider_radius: 0.4,
          patrol_waypoints: [
            ( 5.0, 0.0,  0.0),
            ( 0.0, 0.0,  5.0),
            (-5.0, 0.0,  0.0),
            ( 0.0, 0.0, -5.0),
          ],
        ),
      ),
      targetable: true,
      click_selectable: true,
      select_aim_height: 0.6,
      indicator_category: "hostile",
      behavior: "behaviors/enemy_spider.behavior.ron",
      stat_templates: [
        (
          key: "health",
          base: 75.0,
          min: 0.0,
          max: 75.0,
          regen_rate: 0.0,
          regen_delay: 0.0,
          thresholds: [
            ( when: BelowOrEqual(0.0), emit: "stat.{self}.health.depleted" ),
          ],
        ),
      ],
      stat_label: (
        stat_key: "{self}.health",
        offset: (0.0, 2.1, 0.0),
        font_size: 14.0,
        color: (0.85, 0.45, 1.0, 0.9),
        show_max: true,
      ),
      world_stat_bar: (
        stat_key: "{self}.health",
        offset: (0.0, 2.35, 0.0),
        fill_color: (0.60, 0.10, 0.90, 1.0),
        bg_color:   (0.12, 0.02, 0.18, 0.85),
        color_bands: [
          (0.0,  (0.85, 0.12, 0.12, 1.0)),
          (0.3,  (0.95, 0.75, 0.10, 1.0)),
          (0.6,  (0.60, 0.10, 0.90, 1.0)),
        ],
        style: Pixel( size: (48.0, 6.0) ),
      ),
    ),

    "chest_01": (
      kind: Prop,
      model: "chest_01",
      components: (
        tags: ["loot"],
      ),
      colliders: [
        (shape: Cuboid, size: (0.70, 0.55, 1.00), offset: (0.0, -0.125, 0.0)),
        (shape: Cuboid, size: (0.68, 0.28, 0.98), offset: (0.0,  0.275, 0.0)),
      ],
      click_selectable: true,
      select_aim_height: 0.1,
      indicator_category: "neutral",
    ),

    "chest_02": (
      kind: Prop,
      model: "chest_02",
      components: (
        tags: ["loot"],
      ),
    ),

    "prop_anvil": (
      kind: Prop,
      model: "anvil",
      targetable: true,
      click_selectable: true,
      select_aim_height: 0.1,
      components: (
        tags: [],
      ),
    ),

    // Friendly male NPC — silver metallic look, idles near the player start.
    // Selectable with a green indicator ring (indicator_category: "friendly").
    "friendly_npc_male": (
      kind: Actor,
      model: "character_male",
      material: "mat_silver",
      animation_policy: "prefabs/animation/player_policy_human.ron",
      click_selectable: true,
      indicator_category: "friendly",
    ),

    // Large flat sand-coloured ground plane. physics: true so the player can walk on it.
    "ground_plane": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      primitive: (
        size: (100.0, 0.5, 100.0),
        color: (0.71, 0.60, 0.38),  // warm sandy tan (linear RGB)
        roughness: 0.90,
        metallic: 0.0,
        physics: true,
      ),
    ),

    // Wooden display platform with a chest on top.
    // Entity placed at y=0; platform bottom sits flush with the ground.
    "loot_display": (
      kind: Primitive,
      model: "",
      components: (),
      children: [
        // Wooden platform — 0.2 units thick, center at y=0.1, bottom at y=0, top at y=0.2
        (
          shape: Cuboid,
          primitive: (
            size: (3.0, 0.2, 3.0),
            color: (0.45, 0.28, 0.12),
            roughness: 0.85,
            physics: true,
          ),
          offset: (0.0, 0.1, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Chest_01 collider bottom is 0.4 below entity origin (see colliders def).
        // Chest entity at y=0.6 → bottom at 0.6 - 0.4 = 0.2 = platform top. ✓
        (
          prefab: "chest_01",
          offset: (0.0, 0.6, 0.0),
          rotation_euler_deg: (0.0, 20.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),
  }
)
