(
  schema_version: 2,
  prefabs: {
    "player_warrior": (
      kind: Actor,
      model: "hero",
      animation_policy: "prefabs/animation/player_policy.ron",
      components: (
        tags: ["player"],
        // Orbit camera tuning. All fields optional — omit the block to use engine defaults.
        camera: (
          offset:         (0.0, 2.5, 8.0),   // camera sits 2.5 m up, 8 m behind
          look_at_offset: (0.0, 1.0, 0.0),   // look at chest height
          zoom_speed:     8.0,
          orbit_speed:    0.4,
          min_radius:     3.0,
          max_radius:     18.0,
        ),
      ),
    ),

    "enemy_orc_melee": (
      kind: Actor,
      model: "orc",
      components: (
        tags: ["enemy"],
      ),
    ),

    "chest_01": (
      kind: Prop,
      model: "chest_01",
      components: (
        tags: ["loot"],
      ),
      colliders: [
        // Base body of the chest
        (shape: Cuboid, size: (0.70, 0.55, 1.00), offset: (0.0, -0.125, 0.0)),
        // Lid (slightly smaller and offset upward)
        (shape: Cuboid, size: (0.68, 0.28, 0.98), offset: (0.0,  0.275, 0.0)),
      ],
    ),

    "chest_02": (
      kind: Prop,
      model: "chest_02",
      components: (
        tags: ["loot"],
      ),
    ),

    "prop_anvil": (
      kind: Prop,
      model: "anvil",
      components: (
        tags: [],
      ),
    ),

    "creature_alpaking": (
      kind: Actor,
      model: "alpaking",
      components: (
        tags: ["creature"],
      ),
    ),

    // Composite prefab: wooden platform with a GLB chest nested on top.
    // Demonstrates kind:"prop" nesting inside a kind:"primitive" composite.
    "loot_display": (
      kind: Primitive,
      model: "",
      components: (),
      children: [
        // Wooden platform base — inline Cuboid with a static physics collider
        (
          shape: Cuboid,
          primitive: (
            size: (3.0, 0.15, 3.0),
            color: (0.45, 0.28, 0.12),
            roughness: 0.85,
            physics: true,
          ),
          offset: (0.0, -0.79, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // GLB chest nested on top of the platform
        (
          prefab: "chest_01",
          offset: (0.0, 0.15, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),
  }
)
