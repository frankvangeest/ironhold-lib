(
  schema_version: 2,
  prefabs: {
    "player_warrior": (
      kind: Actor,
      model: "hero",
      animation_policy: "prefabs/animation/player_policy.ron",
      components: (
        tags: ["player"],
        camera: (
          offset:         (0.0, 2.5, 8.0),
          look_at_offset: (0.0, 1.0, 0.0),
          zoom_speed:     8.0,
          orbit_speed:    0.4,
          min_radius:     3.0,
          max_radius:     18.0,
          // RMB-only orbit frees LMB for click-to-select targeting.
          orbit_button: "Right",
        ),
        inputs: (
          forward:      "KeyW",
          backward:     "KeyS",
          left:         "KeyA",
          right:        "KeyD",
          strafe_left:  "KeyQ",
          strafe_right: "KeyE",
          jump:         "Space",
          // "Tab" is intercepted by browsers for focus management.
          // KeyT is reliable and won't fight the browser.
          target_next:  "KeyT",
        ),
      ),
    ),

    "enemy_orc_melee": (
      kind: Actor,
      model: "orc",
      animation_policy: "prefabs/animation/orc_policy.ron",
      components: (
        tags: ["enemy"],
      ),
      targetable: true,
      click_selectable: true,
    ),

    "creature_alpaking": (
      kind: Actor,
      model: "alpaking",
      animation_policy: "prefabs/animation/alpaking_policy.ron",
      components: (
        tags: ["creature"],
      ),
    ),

    "chest_01": (
      kind: Prop,
      model: "chest_01",
      components: (
        tags: ["loot"],
      ),
      colliders: [
        (shape: Cuboid, size: (0.70, 0.55, 1.00), offset: (0.0, -0.125, 0.0)),
        (shape: Cuboid, size: (0.68, 0.28, 0.98), offset: (0.0,  0.275, 0.0)),
      ],
    ),

    "chest_02": (
      kind: Prop,
      model: "chest_02",
      components: (
        tags: ["loot"],
      ),
    ),

    "prop_anvil": (
      kind: Prop,
      model: "anvil",
      components: (
        tags: [],
      ),
    ),

    // Large flat sand-coloured ground plane. physics: true so the player can walk on it.
    "ground_plane": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      primitive: (
        size: (100.0, 0.5, 100.0),
        color: (0.71, 0.60, 0.38),  // warm sandy tan (linear RGB)
        roughness: 0.90,
        metallic: 0.0,
        physics: true,
      ),
    ),

    // Wooden display platform with a chest on top.
    // Entity placed at y=0; platform bottom sits flush with the ground.
    "loot_display": (
      kind: Primitive,
      model: "",
      components: (),
      children: [
        // Wooden platform — 0.2 units thick, center at y=0.1, bottom at y=0, top at y=0.2
        (
          shape: Cuboid,
          primitive: (
            size: (3.0, 0.2, 3.0),
            color: (0.45, 0.28, 0.12),
            roughness: 0.85,
            physics: true,
          ),
          offset: (0.0, 0.1, 0.0),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Chest_01 collider bottom is 0.4 below entity origin (see colliders def).
        // Chest entity at y=0.6 → bottom at 0.6 - 0.4 = 0.2 = platform top. ✓
        (
          prefab: "chest_01",
          offset: (0.0, 0.6, 0.0),
          rotation_euler_deg: (0.0, 20.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),
  }
)
