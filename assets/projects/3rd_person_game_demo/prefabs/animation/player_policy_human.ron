(
    default_transition_ms: 150,

    animation_sources: [
        "anim_locomotion",
        "anim_melee",
        "anim_emotes",
    ],

    base: (
        idle:      "Idle_Loop",
        walk:      "Walk_Loop",
        run:       "Sprint_Loop",
        jump_loop: "Jump_Loop",
    ),

    clips: {
        "dance":        "Dance_Loop",
        "attack_light": "Sword_Attack",
    },

    overrides: [
        (
            id: "jump_enter",
            clip: "Jump_Start",
            priority: 200,
            looping: false,
            duration: 0.4,
            cancel_on_move: false,
        ),
        (
            id: "jump_exit",
            clip: "Jump_Land",
            priority: 200,
            looping: false,
            duration: 0.4,
            cancel_on_move: false,
            transition_ms: 100,
        ),
        (
            id: "dance",
            clip: "Dance_Loop",
            priority: 50,
            looping: true,
            cancel_on_move: true,
            stop_action: "stop_dance",
        ),
        (
            id: "attack_light",
            clip: "Sword_Attack",
            priority: 100,
            looping: false,
            duration: 0.6,
            cancel_on_move: false,
        ),
    ],
)
