(
    schema_version: 1,
    items: {
        // index 2 = "Heart Potion" — matches healthbar fill_color
        "health_potion": (
            display_name: "Health Potion",
            icon_index: 2,
            icon_color: (0.85, 0.15, 0.15, 1.0),
            stackable: true,
            max_stack: 10,
            weight: 0.5,
            tags: ["consumable"],
            // What a shop pays per unit (this merchant's own price in prefabs.ron overrides it). No sell_price = cannot be sold.
            sell_price: 5,
            // Use it from the bag menu (left click) or right-click it to drink at once. {self} is the player.
            use: (
                do_actions: [
                    ModifyStat(key: "player_health", delta: 40.0),
                    ShowFloatingText(entity: "{self}", text: "+40 HP"),
                ],
                consume: 1,
            ),
        ),
        // index 3 = "Mana Flask" — matches mana bar fill_color
        "mana_potion": (
            display_name: "Mana Potion",
            icon_index: 3,
            icon_color: (0.25, 0.50, 1.00, 1.0),
            stackable: true,
            max_stack: 10,
            weight: 0.5,
            tags: ["consumable"],
            sell_price: 5,
            use: (
                do_actions: [
                    ModifyStat(key: "player_mana", delta: 30.0),
                    ShowFloatingText(entity: "{self}", text: "+30 MP"),
                ],
                consume: 1,
            ),
        ),
        // index 54 = "Metal Ingot" — steel grey; closest weapon-material on this sheet
        "iron_sword": (
            display_name: "Iron Sword",
            icon_index: 54,
            icon_color: (0.80, 0.85, 0.95, 1.0),
            stackable: false,
            weight: 3.5,
            tags: ["weapon", "melee"],
            sell_price: 30,
        ),
        // index 62 = "Royal Coin" — gold tint
        "gold_coin": (
            display_name: "Gold Coin",
            icon_index: 62,
            icon_color: (1.0, 0.85, 0.20, 1.0),
            stackable: true,
            max_stack: 999,
            weight: 0.01,
            tags: ["currency"],
            currency_stat: "gold",
        ),
        // index 63 = "Key" — brass/iron tint
        "old_key": (
            display_name: "Old Key",
            icon_index: 63,
            icon_color: (0.90, 0.75, 0.40, 1.0),
            stackable: false,
            weight: 0.2,
            tags: ["quest"],
            // A quest item: the player cannot destroy it, and with no sell_price no shop buys it either.
            destroyable: false,
        ),
    },
)
