(
  schema_version: 2,
  name: "flycam_spectator_test",

  tonemapping: AcesFitted,

  lighting: (
    ambient: (0.22, 0.28, 0.38),
    ambient_brightness: 100.0,
    directional: (
      color: (1.0, 0.95, 0.80),
      intensity: 32000.0,
      rotation_euler_deg: (-45.0, 25.0, 0.0),
      shadows_enabled: true,
    ),
  ),

  entities: [
    (
      id: "ground",
      prefab: "ground",
      transform: ( translation: (0.0, -0.5, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
    ),
    (
      id: "player_01",
      prefab: "player_orbit_demo",
      transform: ( translation: (0.0, 0.5, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
    ),
    (
      id: "camera_01",
      prefab: "flycam_demo",
      transform: ( translation: (0.0, 6.0, 12.0), rotation_euler_deg: (-15.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
    ),
  ],

  // Spectator mode (docs/20_data_formats.md, "Spectator mode" under the flycam special tag): a
  // `tags: ["player"]` entity and a `tags: ["flycam"]` entity in the same scene. The flycam takes
  // camera priority — the player above still spawns and plays normally (movement, stats, targeting
  // all keep working), but gets no camera of its own. Note both entities share the same default
  // WASD keys (the player's own `movement`/`inputs` component, and the flycam's default fly
  // controls) — each reads raw input independently, so WASD drives both at once; this is expected,
  // not a bug, since neither system is aware the other exists. A flycam has no
  // CharacterController/collider, so "Back to Main" is a UI button here instead of a walkable pad,
  // same as flycam_test.
  ui: [
    Label((
      id: "hint",
      text: "Spectator mode: flycam has camera priority. WASD + mouse to fly. Player also moves on WASD — nothing follows it.",
      position: (16.0, 16.0),
      size: (900.0, 28.0),
      align: Left,
    )),
    Button((
      id: "back_to_main_button",
      text: "Back to Main",
      action: "ui.back_to_main",
      position: (16.0, 52.0),
      size: (200.0, 40.0),
    )),
  ],
)
