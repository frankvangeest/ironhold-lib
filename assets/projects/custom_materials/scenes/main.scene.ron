(
  schema_version: 2,
  name: "custom_materials_main",

  lighting: (
    // Ambient kept low so directional shadows read clearly on the white marble floor.
    // Too-high ambient washes out the vein contrast in the albedo.
    ambient: (0.25, 0.30, 0.45),
    ambient_brightness: 15.0,

    directional: (
      color: (1.0, 0.95, 0.85),
      intensity: 30000.0,
      rotation_euler_deg: (-45.0, 25.0, 0.0),
      shadows_enabled: true,
      // Scene spans ~440 units (camera Z=120 → last row Z=-320); set cascades to match.
      shadow_distance: 450.0,
      // Wider cascade overlap softens the transition between shadow cascade levels,
      // reducing the risk of a visible band on large flat surfaces.
      // cascade_overlap: Some(0.5),
    ),

    // Accent point lights — one warm fill, one cool fill, one above each row.
    point_lights: [
      // Warm key light over PBR row
      (
        position: (0.0, 15.0, -120.0),
        color: (1.0, 0.85, 0.6),
        intensity: 200000.0,
        range: 80.0,
        shadows_enabled: true,
      ),
      // Cool fill light over procedural row
      (
        position: (0.0, 15.0, -40.0),
        color: (0.5, 0.7, 1.0),
        intensity: 80000.0,
        range: 60.0,
      ),
      // Warm backlight behind PBR row
      (
        position: (0.0, 8.0, -160.0),
        color: (1.0, 0.6, 0.3),
        intensity: 60000.0,
        range: 50.0,
      ),
    ],
  ),

  // Labels shrink with depth so distant row labels don't compete for attention.
  // At 80 units they're at authored size; they don't go below 25% of that.
  label_depth_scale: (
    reference_distance: 80.0,
    min_scale: 0.25,
  ),

  spawn_points: {
    "overview": (-10.0, 40.0, 120.0),
  },

  entities: [
    // FlyCamera — AcesFitted tonemapping, no bloom (web-compatible).
    // Controls: WASD move | LMB/RMB + mouse look | Shift fast | E/Space up | Q/Ctrl down.
    (
      id: "camera_01",
      prefab: "flycam",
      transform: (
        translation: (-10.0, 40.0, 120.0),
        rotation_euler_deg: (-18.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Floor ────────────────────────────────────────────────────────────────
    (
      id: "floor",
      prefab: "floor_slab",
      transform: (
        translation: (0.0, -5.0, -160.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 2.0),
      ),
    ),

    // ── Sky sphere ───────────────────────────────────────────────────────────
    // Centred on the scene floor mid-point. Radius 500 safely contains the whole
    // showcase area. No label — background element.
    (
      id: "sky_sphere",
      prefab: "sky_sphere",
      transform: (
        translation: (0.0, 0.0, -160.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Row 1 (Z = 0): unlit + checker family ────────────────────────────────
    // 7 objects at 25-unit spacing (±75). Checker Color joins the trio here so all
    // four checker variants live together.
    (
      id: "sphere_unlit_pink",
      prefab: "sphere_unlit_pink",
      transform: (translation: (-75.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Unlit Pink"),
    ),
    (
      id: "sphere_unlit_teal",
      prefab: "sphere_unlit_teal",
      transform: (translation: (-50.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Unlit Teal"),
    ),
    // Checker quartet: UV-space (seam visible) · World-space · Local-space · Color.
    (
      id: "sphere_checker_bw_uv",
      prefab: "sphere_checker_bw_uv",
      transform: (translation: (-25.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Checker UV"),
    ),
    (
      id: "sphere_checker_bw_world",
      prefab: "sphere_checker_bw_world",
      transform: (translation: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Checker World"),
    ),
    (
      id: "sphere_checker_bw_local",
      prefab: "sphere_checker_bw_local",
      transform: (translation: (25.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Checker Local"),
    ),
    (
      id: "cuboid_checker_color",
      prefab: "cuboid_checker_color",
      transform: (translation: (50.0, 0.0, 0.0), rotation_euler_deg: (0.0, 30.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Checker Color"),
    ),
    (
      id: "sphere_normals",
      prefab: "sphere_normals",
      transform: (translation: (75.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Normals"),
    ),

    // ── Row 2 (Z = -40): gradient effects ─────────────────────────────────────
    (
      id: "capsule_gradient_sky",
      prefab: "capsule_gradient_sky",
      transform: (translation: (-25.0, 0.0, -40.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Gradient Sky"),
    ),
    (
      id: "cylinder_gradient_ember",
      prefab: "cylinder_gradient_ember",
      transform: (translation: (25.0, 0.0, -40.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Gradient Ember"),
    ),

    // ── Row 3 (Z = -80): fresnel + stripes ────────────────────────────────────
    (
      id: "sphere_fresnel_blue",
      prefab: "sphere_fresnel_blue",
      transform: (translation: (-50.0, 0.0, -80.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Fresnel Blue"),
    ),
    (
      id: "torus_fresnel_green",
      prefab: "torus_fresnel_green",
      transform: (translation: (0.0, 4.0, -80.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Fresnel Green"),
    ),
    (
      id: "cone_stripes",
      prefab: "cone_stripes",
      transform: (translation: (50.0, 0.0, -80.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "World Stripes"),
    ),

    // ── Row 4 (Z = -120): full PBR ────────────────────────────────────────────
    (
      id: "sphere_pbr_plastic_red",
      prefab: "sphere_pbr_plastic_red",
      transform: (translation: (-75.0, 0.0, -120.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Plastic Red"),
    ),
    (
      id: "sphere_pbr_plastic_white",
      prefab: "sphere_pbr_plastic_white",
      transform: (translation: (-45.0, 0.0, -120.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Plastic White"),
    ),
    (
      id: "sphere_pbr_metal_chrome",
      prefab: "sphere_pbr_metal_chrome",
      transform: (translation: (-15.0, 0.0, -120.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Metal Chrome"),
    ),
    (
      id: "sphere_pbr_metal_rough",
      prefab: "sphere_pbr_metal_rough",
      transform: (translation: (15.0, 0.0, -120.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Metal Rough"),
    ),
    (
      id: "sphere_pbr_gold",
      prefab: "sphere_pbr_gold",
      transform: (translation: (45.0, 0.0, -120.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Gold"),
    ),
    (
      id: "sphere_pbr_water",
      prefab: "sphere_pbr_water",
      transform: (translation: (75.0, 0.0, -120.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Water"),
    ),

    // ── Row 5 (Z = -160): emissive / transparent effects ─────────────────────
    (
      id: "sphere_emissive_shield",
      prefab: "sphere_emissive_shield",
      transform: (translation: (-50.0, 0.0, -160.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Emissive Fresnel"),
    ),
    (
      id: "sphere_emissive_orb_orange",
      prefab: "sphere_emissive_orb_orange",
      transform: (translation: (0.0, 0.0, -160.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Emissive Orb"),
    ),
    (
      id: "torus_emissive_plain",
      prefab: "torus_emissive_plain",
      transform: (translation: (50.0, 4.0, -160.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Emissive Plain"),
    ),

    // ── Row 6 (Z = -200): pulse + texture tint ────────────────────────────────
    (
      id: "sphere_pulse_cyan",
      prefab: "sphere_pulse_cyan",
      transform: (translation: (-45.0, 0.0, -200.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Pulse Cyan"),
    ),
    (
      id: "torus_pulse_gold",
      prefab: "torus_pulse_gold",
      transform: (translation: (-15.0, 4.0, -200.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Pulse Gold"),
    ),
    (
      id: "cuboid_crate_tint_red",
      prefab: "cuboid_crate_tint_red",
      transform: (translation: (15.0, 0.0, -200.0), rotation_euler_deg: (0.0, 20.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Tint Red"),
    ),
    (
      id: "cuboid_crate_tint_blue",
      prefab: "cuboid_crate_tint_blue",
      transform: (translation: (45.0, 0.0, -200.0), rotation_euler_deg: (0.0, -15.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Tint Blue"),
    ),

    // ── Row 7 (Z = -240): dissolve trio ───────────────────────────────────────
    // UV-space (seam visible) · World-space (seamless, world grid) · Local-space (seamless, object-centred).
    (
      id: "sphere_dissolve_fire_uv",
      prefab: "sphere_dissolve_fire_uv",
      transform: (translation: (-50.0, 0.0, -240.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Dissolve UV"),
    ),
    (
      id: "sphere_dissolve_fire",
      prefab: "sphere_dissolve_fire",
      transform: (translation: (0.0, 0.0, -240.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Dissolve World"),
    ),
    (
      id: "sphere_dissolve_fire_local",
      prefab: "sphere_dissolve_fire_local",
      transform: (translation: (50.0, 0.0, -240.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Dissolve Local"),
    ),

    // ── Row 8 (Z = -280): noise textures ──────────────────────────────────────
    (
      id: "sphere_noise_perlin",
      prefab: "sphere_noise_perlin",
      transform: (translation: (-80.0, 0.0, -280.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Perlin"),
    ),
    (
      id: "sphere_noise_voronoi",
      prefab: "sphere_noise_voronoi",
      transform: (translation: (-40.0, 0.0, -280.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Voronoi"),
    ),
    (
      id: "sphere_noise_value",
      prefab: "sphere_noise_value",
      transform: (translation: (0.0, 0.0, -280.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Value Noise"),
    ),
    (
      id: "sphere_noise_gabor",
      prefab: "sphere_noise_gabor",
      transform: (translation: (40.0, 0.0, -280.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Gabor"),
    ),
    (
      id: "sphere_noise_blue",
      prefab: "sphere_noise_blue",
      transform: (translation: (80.0, 0.0, -280.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Blue Noise"),
    ),

    // ── Row 9 (Z = -320): triplanar surfacing ─────────────────────────────────
    // Triplanar projection eliminates UV seams and pole pinch on rounded shapes.
    // A UV-mapped sphere would show a meridian seam and pole pinch on all four;
    // triplanar projection eliminates both artefacts cleanly.
    (
      id: "sphere_triplanar_bricks",
      prefab: "sphere_triplanar_bricks",
      transform: (translation: (-60.0, 0.0, -320.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Triplanar Bricks"),
    ),
    (
      id: "sphere_triplanar_rock",
      prefab: "sphere_triplanar_rock",
      transform: (translation: (-20.0, 0.0, -320.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Triplanar Rock"),
    ),
    (
      id: "sphere_triplanar_bark",
      prefab: "sphere_triplanar_bark",
      transform: (translation: (20.0, 0.0, -320.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Triplanar Bark"),
    ),
    (
      id: "sphere_triplanar_marbel",
      prefab: "sphere_triplanar_marbel",
      transform: (translation: (60.0, 0.0, -320.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
      label: (text: "Triplanar Marbel"),
    ),
  ],

  ui: [
    (
      kind: "label",
      id: "flycam_position",
      text: "X: 0.0  Y: 0.0  Z: 0.0",
      position: (16.0, 16.0),
      size: (340.0, 32.0),
    ),
    (
      kind: "label",
      id: "title_label",
      text: "Custom Materials Demo — WASD + mouse to fly",
      position: (16.0, 56.0),
      size: (480.0, 32.0),
    ),
    (
      kind: "button",
      id: "quit_button",
      text: "Quit",
      action: "ui.quit",
      position: (16.0, 100.0),
      size: (120.0, 40.0),
    ),
  ],
)
