    ),

    // ── Row 4 (Z = -120): full PBR ────────────────────────────────────────────
    (
      id: "sphere_pbr_plastic_red",
      prefab: "sphere_pbr_plastic_red",
      transform: (translation: (-75.0, 0.0, -120.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
    ),
    (
      id: "sphere_pbr_plastic_white",
      prefab: "sphere_pbr_plastic_white",
      transform: (translation: (-45.0, 0.0, -120.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
    ),
    (
