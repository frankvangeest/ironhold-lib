(
  schema_version: 2,
  name: "custom_materials_main",

  lighting: Some((
    // Low ambient — tonemapping handles contrast; high ambient washes everything out.
    ambient: Some((0.25, 0.30, 0.45)),
    ambient_brightness: Some(60.0),

    directional: Some((
      color: (1.0, 0.95, 0.85),
      intensity: 30000.0,
      rotation_euler_deg: (-45.0, 25.0, 0.0),
      shadows_enabled: true,
    )),

    // Accent point lights — one warm fill, one cool fill, one above each row.
    point_lights: [
      // Warm key light over PBR row
      (
        position: (0.0, 15.0, -120.0),
        color: (1.0, 0.85, 0.6),
        intensity: 200000.0,
        range: 80.0,
      ),
      // Cool fill light over procedural row
      (
        position: (0.0, 15.0, -40.0),
        color: (0.5, 0.7, 1.0),
        intensity: 80000.0,
        range: 60.0,
      ),
      // Warm backlight behind PBR row
      (
        position: (0.0, 8.0, -160.0),
        color: (1.0, 0.6, 0.3),
        intensity: 60000.0,
        range: 50.0,
      ),
    ],
  )),

  spawn_points: {
    "overview": (-10.0, 40.0, 120.0),
  },

  entities: [
    // FlyCamera — AcesFitted tonemapping, no bloom (web-compatible).
    // Controls: WASD move | LMB/RMB + mouse look | Shift fast | E/Space up | Q/Ctrl down.
    (
      id: "camera_01",
      prefab: "flycam",
      transform: (
        translation: (-10.0, 40.0, 120.0),
        rotation_euler_deg: (-18.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
      ),
    ),

    // ── Floor ────────────────────────────────────────────────────────────────
    // Large thin slab — receives shadows from all objects.
    // Depth 480 covers rows 1–7 (Z = 0 to Z = -240) with margin.
    (
      id: "floor",
      prefab: "floor_slab",
      transform: (
        translation: (0.0, -5.0, -80.0),
        rotation_euler_deg: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.6),
      ),
    ),

    // ── Row 1 (Z = 0): unlit + checker effects ────────────────────────────────
    (
      id: "sphere_unlit_pink",
      prefab: "sphere_unlit_pink",
      transform: (translation: (-90.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
    ),
    (
      id: "sphere_unlit_teal",
      prefab: "sphere_unlit_teal",
      transform: (translation: (-50.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
    ),
    (
      id: "sphere_checker_bw",
      prefab: "sphere_checker_bw",
      transform: (translation: (-10.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
    ),
    (
      id: "cuboid_checker_color",
      prefab: "cuboid_checker_color",
      transform: (translation: (30.0, 0.0, 0.0), rotation_euler_deg: (0.0, 30.0, 0.0), scale: (1.0, 1.0, 1.0)),
    ),
    (
      id: "sphere_normals",
      prefab: "sphere_normals",
      transform: (translation: (70.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
    ),

    // ── Row 2 (Z = -40): gradient effects ────────────────────────────────────
    (
      id: "capsule_gradient_sky",
      prefab: "capsule_gradient_sky",
      transform: (translation: (-50.0, 0.0, -40.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0)),
    ),
