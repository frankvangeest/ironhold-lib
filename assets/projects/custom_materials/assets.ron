(
  schema_version: 1,

  materials: {
    // Solid hot-pink unlit — the fallback colour made intentional
    "mat_unlit_pink": (
      kind: Custom((
        shader: "shared/shaders/custom_unlit_color.wgsl",
        colors: {
          "color_a": (r:1.0, g:0.08, b:0.58, a:1.0),
        },
      )),
      unlit: true,
    ),

    // Solid teal unlit
    "mat_unlit_teal": (
      kind: Custom((
        shader: "shared/shaders/custom_unlit_color.wgsl",
        colors: {
          "color_a": (r:0.0, g:0.85, b:0.75, a:1.0),
        },
      )),
      unlit: true,
    ),

    // Checkerboard: black & white on a sphere — uses world-space variant so the
    // pattern wraps seamlessly with no meridian seam or pole distortion.
    // tiling = 0.75 → ~6 cells across the r=4 sphere diameter (0.75 × 8 = 6).
    "mat_checker_bw_world": (
      kind: Custom((
        shader: "shared/shaders/custom_checker_world.wgsl",
        colors: {
          "color_a": (r:0.05, g:0.05, b:0.05, a:1.0),
          "color_b": (r:0.95, g:0.95, b:0.95, a:1.0),
        },
        floats: {
          "tiling": 0.75,
        },
      )),
    ),

    // UV-space checker: same black & white on a sphere — meridian seam visible.
    // Compare side-by-side with mat_checker_bw_world (world-space, seamless).
    "mat_checker_bw_uv": (
      kind: Custom((
        shader: "shared/shaders/custom_checker_uv.wgsl",
        colors: {
          "color_a": (r:0.05, g:0.05, b:0.05, a:1.0),
          "color_b": (r:0.95, g:0.95, b:0.95, a:1.0),
        },
        floats: {
          "tiling": 6.0,
        },
      )),
    ),

    // Local (object-space) checker: same B&W, pattern anchored to each object's
    // own coordinate frame. tiling = 0.75 matches mat_checker_bw_world — compare the
    // three spheres side-by-side: UV seam, world grid offset, local centered.
    "mat_checker_bw_local": (
      kind: Custom((
        shader: "shared/shaders/custom_checker_local.wgsl",
        colors: {
          "color_a": (r:0.05, g:0.05, b:0.05, a:1.0),
          "color_b": (r:0.95, g:0.95, b:0.95, a:1.0),
        },
        floats: {
          "tiling": 0.75,
        },
      )),
    ),

    // Checkerboard: orange & navy on a cuboid — uses UV-space variant so tiles
    // align cleanly with the box faces. tiling = 4 → 4 checks per UV [0,1] range.
    "mat_checker_color": (
      kind: Custom((
        shader: "shared/shaders/custom_checker_uv.wgsl",
        colors: {
          "color_a": (r:0.9, g:0.45, b:0.05, a:1.0),
          "color_b": (r:0.05, g:0.1,  b:0.45, a:1.0),
        },
        floats: {
          "tiling": 4.0,
        },
      )),
    ),

    // UV gradient: deep blue → sky
    "mat_gradient_sky": (
      kind: Custom((
        shader: "shared/shaders/custom_gradient.wgsl",
        colors: {
          "color_a": (r:0.04, g:0.04, b:0.25, a:1.0),
          "color_b": (r:0.45, g:0.72, b:1.0,  a:1.0),
        },
      )),
    ),

    // UV gradient: ember glow
    "mat_gradient_ember": (
      kind: Custom((
        shader: "shared/shaders/custom_gradient.wgsl",
        colors: {
          "color_a": (r:0.6, g:0.0, b:0.0, a:1.0),
          "color_b": (r:1.0, g:0.8, b:0.0, a:1.0),
        },
      )),
    ),

    // Fresnel rim: electric blue rim on dark base
    "mat_fresnel_blue": (
      kind: Custom((
        shader: "shared/shaders/custom_fresnel.wgsl",
        colors: {
          "color_a": (r:0.1, g:0.5, b:1.0,  a:1.0),
          "color_b": (r:0.05, g:0.05, b:0.1, a:1.0),
        },
        floats: {
          "rim_power": 2.5,
        },
      )),
    ),

    // Fresnel rim: green energy on black
    "mat_fresnel_green": (
      kind: Custom((
        shader: "shared/shaders/custom_fresnel.wgsl",
        colors: {
          "color_a": (r:0.1, g:1.0, b:0.3,  a:1.0),
          "color_b": (r:0.0, g:0.05, b:0.0, a:1.0),
        },
        floats: {
          "rim_power": 3.5,
        },
      )),
    ),

    // World-space stripes: red & white
    "mat_stripes_rw": (
      kind: Custom((
        shader: "shared/shaders/custom_world_stripes.wgsl",
        colors: {
          "color_a": (r:0.9, g:0.1, b:0.1, a:1.0),
          "color_b": (r:0.95, g:0.95, b:0.95, a:1.0),
        },
        floats: {
          "stripe_freq": 1.5,
        },
      )),
    ),

    // Normal visualizer — no colors needed
    "mat_normals": (
      kind: Custom((
        shader: "shared/shaders/custom_normal_vis.wgsl",
      )),
    ),

    // ── Floor ─────────────────────────────────────────────────────────────────
    // Dark concrete — neutral base so material colours read cleanly.
    "mat_floor": (
      kind: Standard((
        base_color: (r:0.18, g:0.18, b:0.18, a:1.0),
        metallic: 0.0,
        perceptual_roughness: 0.9,
      )),
    ),

    // ── Full PBR via custom_pbr.wgsl ─────────────────────────────────────────
    // Uniform layout: colors sorted first (base_color → params_0),
    // then floats alphabetically: metallic→p1.x, perceptual_roughness→p1.y, reflectance→p1.z

    // Red plastic — dielectric, low-medium roughness
    "mat_pbr_plastic_red": (
      kind: Custom((
        shader: "shared/shaders/custom_pbr.wgsl",
        colors: {
          "base_color": (r:0.85, g:0.08, b:0.08, a:1.0),
        },
        floats: {
          "metallic": 0.0,
          "perceptual_roughness": 0.45,
        },
      )),
    ),

    // White plastic — dielectric, smooth
    "mat_pbr_plastic_white": (
      kind: Custom((
        shader: "shared/shaders/custom_pbr.wgsl",
        colors: {
          "base_color": (r:0.92, g:0.92, b:0.92, a:1.0),
        },
        floats: {
          "metallic": 0.0,
          "perceptual_roughness": 0.2,
        },
      )),
    ),

    // Chrome — fully metallic, near-mirror smooth
    "mat_pbr_metal_chrome": (
      kind: Custom((
        shader: "shared/shaders/custom_pbr.wgsl",
        colors: {
          "base_color": (r:0.9, g:0.9, b:0.95, a:1.0),
        },
        floats: {
          "metallic": 1.0,
          "perceptual_roughness": 0.05,
        },
      )),
    ),

    // Brushed steel — fully metallic, rough
    "mat_pbr_metal_rough": (
      kind: Custom((
        shader: "shared/shaders/custom_pbr.wgsl",
        colors: {
          "base_color": (r:0.6, g:0.62, b:0.65, a:1.0),
        },
        floats: {
          "metallic": 1.0,
          "perceptual_roughness": 0.65,
        },
      )),
    ),

    // Gold — metallic, warm colour, slight roughness
    "mat_pbr_gold": (
      kind: Custom((
        shader: "shared/shaders/custom_pbr.wgsl",
        colors: {
          "base_color": (r:1.0, g:0.78, b:0.1, a:1.0),
        },
        floats: {
          "metallic": 1.0,
          "perceptual_roughness": 0.18,
        },
      )),
    ),

    // Water — dielectric, near-zero roughness, high reflectance
    "mat_pbr_water": (
      kind: Custom((
        shader: "shared/shaders/custom_pbr.wgsl",
        colors: {
          "base_color": (r:0.04, g:0.18, b:0.55, a:1.0),
        },
        floats: {
          "metallic": 0.0,
          "perceptual_roughness": 0.02,
        },
      )),
    ),

    // ── Emissive / transparent effects ────────────────────────────────────────
    // These require `unlit: true` — see docs/25_custom_shaders.md for the
    // no-HDR / no-bloom constraint and the reasoning behind this approach.

    // Emissive fresnel (Blend) — translucent glass-orb shield.
    // Dark, near-transparent centre; bright electric-blue rim.
    // alpha_mode: Blend makes the surface partially see-through.
    "mat_emissive_shield": (
      kind: Custom((
        shader: "shared/shaders/custom_emissive_fresnel.wgsl",
        colors: {
          "base_color": (r:0.05, g:0.10, b:0.30, a:0.10),
          "rim_color":  (r:0.20, g:0.60, b:1.00, a:0.90),
        },
        floats: {
          "rim_power": 2.5,
        },
      )),
      alpha_mode: Blend,
      unlit: true,
    ),

    // Emissive fresnel (Add) — hot orange energy orb.
    // Invisible centre; rim adds orange light on top of whatever is behind it.
    // alpha_mode: Add avoids depth-sorting issues for overlapping transparent meshes.
    "mat_emissive_orb_orange": (
      kind: Custom((
        shader: "shared/shaders/custom_emissive_fresnel.wgsl",
        colors: {
          "base_color": (r:0.50, g:0.20, b:0.00, a:0.00),
          "rim_color":  (r:1.00, g:0.55, b:0.10, a:1.00),
        },
        floats: {
          "rim_power": 3.0,
        },
      )),
      alpha_mode: Add,
      unlit: true,
    ),

    // Plain additive unlit — cool blue-white haze.
    // Shows that alpha_mode: Add + unlit: true works with the existing
    // custom_unlit_color.wgsl — no new shader required for the simple case.
    "mat_emissive_plain": (
      kind: Custom((
        shader: "shared/shaders/custom_unlit_color.wgsl",
        colors: {
          "color_a": (r:0.50, g:0.75, b:1.00, a:0.60),
        },
      )),
      alpha_mode: Add,
      unlit: true,
    ),

    // ── Pulse ─────────────────────────────────────────────────────────────────
    // Cyan emissive that breathes at 1.2 pulses/sec. min_alpha: 0.05 so it
    // nearly vanishes at the bottom of each pulse.
    "mat_pulse_cyan": (
      kind: Custom((
        shader: "shared/shaders/custom_pulse.wgsl",
        colors: {
          "color": (r:0.10, g:0.90, b:1.00, a:1.00),
        },
        floats: {
          "min_alpha": 0.05,
          "speed": 1.2,
        },
      )),
      alpha_mode: Add,
      unlit: true,
    ),

    // Slower warm-gold pulse. min_alpha: 0.3 — never goes fully dark, which
    // looks better for a collectible or power indicator.
    "mat_pulse_gold": (
      kind: Custom((
        shader: "shared/shaders/custom_pulse.wgsl",
        colors: {
          "color": (r:1.00, g:0.82, b:0.10, a:1.00),
        },
        floats: {
          "min_alpha": 0.30,
          "speed": 0.8,
        },
      )),
      alpha_mode: Add,
      unlit: true,
    ),

    // ── Texture tint ──────────────────────────────────────────────────────────
    // Wood crate albedo tinted with a warm orange-red.
    // Demonstrates texture_0 sampling — change the tint to reuse the same
    // texture with a completely different colour scheme.
    "mat_crate_tint_red": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_tint.wgsl",
        textures: {
          "texture_0": "shared/textures/wood_crate_albedo.png",
        },
        colors: {
          "tint": (r:1.00, g:0.35, b:0.15, a:1.00),
        },
      )),
    ),

    // Same texture, cool blue tint — same shader, different colour, zero extra cost.
    "mat_crate_tint_blue": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_tint.wgsl",
        textures: {
          "texture_0": "shared/textures/wood_crate_albedo.png",
        },
        colors: {
          "tint": (r:0.30, g:0.55, b:1.00, a:1.00),
        },
      )),
    ),

    // ── Dissolve ──────────────────────────────────────────────────────────────
    // 40% dissolved, orange-fire edge glow on a dark charred base.
    // alpha_mode: Mask(0.5) discards cut fragments without transparency sorting.
    // World-space variant — sphere mesh has no clean UV seam; tiling in world units.
    "mat_dissolve_fire": (
      kind: Custom((
        shader: "shared/shaders/custom_dissolve_world.wgsl",
        colors: {
          "base_color": (r:0.08, g:0.06, b:0.04, a:1.00),
          "edge_color":  (r:1.00, g:0.45, b:0.05, a:1.00),
        },
        floats: {
          "edge_width": 0.12,
          "threshold":  0.40,
          "tiling":     0.75,
        },
      )),
      alpha_mode: Mask(0.5),
    ),

    // Local (object-space) dissolve — same fire colours, pattern anchored to each
    // object. Completes the UV / World / Local trio alongside the checker set.
    "mat_dissolve_fire_local": (
      kind: Custom((
        shader: "shared/shaders/custom_dissolve_local.wgsl",
        colors: {
          "base_color": (r:0.08, g:0.06, b:0.04, a:1.00),
          "edge_color":  (r:1.00, g:0.45, b:0.05, a:1.00),
        },
        floats: {
          "edge_width": 0.12,
          "threshold":  0.40,
          "tiling":     0.75,
        },
      )),
      alpha_mode: Mask(0.5),
    ),

    // UV-space dissolve — visible meridian seam on spheres. Compare side-by-side
    // with mat_dissolve_fire (world-space) to show when the world variant is needed.
    "mat_dissolve_fire_uv": (
      kind: Custom((
        shader: "shared/shaders/custom_dissolve_uv.wgsl",
        colors: {
          "base_color": (r:0.08, g:0.06, b:0.04, a:1.00),
          "edge_color":  (r:1.00, g:0.45, b:0.05, a:1.00),
        },
        floats: {
          "edge_width": 0.12,
          "threshold":  0.40,
          "tiling":     6.0,
        },
      )),
      alpha_mode: Mask(0.5),
    ),

    // ── Noise textures ────────────────────────────────────────────────────────
    // Each noise type displayed as a texture tint on a sphere.
    // White tint (1,1,1,1) shows the raw noise pattern.
    // Useful as masks, roughness sources, dissolve inputs, or UV offsets.

    // Noise textures use triplanar projection so the pattern wraps cleanly across
    // the sphere surface with no meridian seam or pole pinch.
    // tiling: 0.2 → ~1.6 repeats across an r=4 sphere diameter (shows the full pattern).

    // Perlin noise — smooth organic variation; good for terrain height, fog, water ripples.
    "mat_noise_perlin": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar.wgsl",
        textures: {
          "texture_0": "shared/textures/noise/noise-perlin-512-r8.png",
        },
        colors: { "tint": (r:1.0, g:1.0, b:1.0, a:1.0) },
        floats: { "blend_sharpness": 4.0, "tiling": 0.2 },
      )),
    ),

    // Voronoi noise — cellular/cracked pattern; good for scales, cracks, skin, rock faces.
    "mat_noise_voronoi": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar.wgsl",
        textures: {
          "texture_0": "shared/textures/noise/noise-voronoi-512-c12.png",
        },
        colors: { "tint": (r:1.0, g:1.0, b:1.0, a:1.0) },
        floats: { "blend_sharpness": 4.0, "tiling": 0.2 },
      )),
    ),

    // Value noise — blocky low-frequency variation; good for roughness maps, smoke, clouds.
    "mat_noise_value": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar.wgsl",
        textures: {
          "texture_0": "shared/textures/noise/noise-value-512-r16.png",
        },
        colors: { "tint": (r:1.0, g:1.0, b:1.0, a:1.0) },
        floats: { "blend_sharpness": 4.0, "tiling": 0.2 },
      )),
    ),

    // Gabor noise — directional grain/fibre pattern; good for wood grain, brushed metal, fabric.
    "mat_noise_gabor": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar.wgsl",
        textures: {
          "texture_0": "shared/textures/noise/noise-gabor-512-f008-a60-s12.png",
        },
        colors: { "tint": (r:1.0, g:1.0, b:1.0, a:1.0) },
        floats: { "blend_sharpness": 4.0, "tiling": 0.2 },
      )),
    ),

    // Blue noise — uniform random distribution with no clumping; ideal for dithering,
    // shadow sample jitter, and alpha stippling.
    "mat_noise_blue": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar.wgsl",
        textures: {
          "texture_0": "shared/textures/noise/noise-blue-128.png",
        },
        colors: { "tint": (r:1.0, g:1.0, b:1.0, a:1.0) },
        floats: { "blend_sharpness": 4.0, "tiling": 0.2 },
      )),
    ),

    // ── Sky dome ─────────────────────────────────────────────────────────────
    // Gradient viewed from inside a large sphere. double_sided: true disables
    // back-face culling so the interior faces are visible. unlit: true keeps the
    // sky constant regardless of scene lighting.
    // color_a → params_0 = horizon/bottom colour; color_b → params_1 = zenith colour.
    "mat_sky_gradient": (
      kind: Custom((
        shader: "shared/shaders/custom_gradient.wgsl",
        colors: {
          "color_a": (r:0.52, g:0.70, b:0.88, a:1.0),   // horizon — pale sky blue
          "color_b": (r:0.03, g:0.10, b:0.48, a:1.0),   // zenith — deep blue
        },
      )),
      double_sided: true,
      unlit: true,
    ),

    // ── Triplanar surface textures ────────────────────────────────────────────
    // These contrast with the noise row above: same triplanar shader, but now
    // applied to real stylised surface textures to show it as a surfacing tool.
    // A sphere with UV mapping would show pole pinch and a meridian seam on all
    // three — triplanar projection eliminates both artefacts automatically.

    // Stylised bricks — geometric pattern makes the seam-free join obvious.
    // Full PBR: normal map adds depth to mortar lines; roughness distinguishes
    // smooth brick faces from rough mortar joints.
    "mat_triplanar_bricks": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar_pbr.wgsl",
        textures: {
          "texture_0": "shared/textures/Stylized_Bricks_004_SD/Stylized_Bricks_004_basecolor.png",
          "texture_1": "shared/textures/Stylized_Bricks_004_SD/Stylized_Bricks_004_normal.png",
          "texture_2": "shared/textures/Stylized_Bricks_004_SD/Stylized_Bricks_004_roughness.png",
          "texture_3": "shared/textures/Stylized_Bricks_004_SD/Stylized_Bricks_004_ambientOcclusion.png",
        },
        colors: { "tint": (r:1.0, g:1.0, b:1.0, a:1.0) },
        floats: { "blend_sharpness": 4.0, "metallic": 0.0, "normal_strength": 1.0, "tiling": 0.1 },
      )),
    ),

    // Stylised cliff rock — organic surface with full PBR. Normal map restores
    // the fine surface relief lost in the basecolor-only version.
    "mat_triplanar_rock": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar_pbr.wgsl",
        textures: {
          "texture_0": "shared/textures/Stylized_Cliff_Rock_001_SD/Stylized_Cliff_Rock_001_basecolor.jpg",
          "texture_1": "shared/textures/Stylized_Cliff_Rock_001_SD/Stylized_Cliff_Rock_001_normal.jpg",
          "texture_2": "shared/textures/Stylized_Cliff_Rock_001_SD/Stylized_Cliff_Rock_001_roughness.jpg",
          "texture_3": "shared/textures/Stylized_Cliff_Rock_001_SD/Stylized_Cliff_Rock_001_ambientOcclusion.jpg",
        },
        colors: { "tint": (r:1.0, g:1.0, b:1.0, a:1.0) },
        floats: { "blend_sharpness": 4.0, "metallic": 0.0, "normal_strength": 1.0, "tiling": 0.25 },
      )),
    ),

    // Stylised bark — strong directional grain; normal_strength: 1.2 slightly
    // exaggerates the ridge detail so it reads on the curved sphere surface.
    "mat_triplanar_bark": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar_pbr.wgsl",
        textures: {
          "texture_0": "shared/textures/Stylized_Bark_003_SD/Stylized_Bark_003_basecolor.png",
          "texture_1": "shared/textures/Stylized_Bark_003_SD/Stylized_Bark_003_normal.png",
          "texture_2": "shared/textures/Stylized_Bark_003_SD/Stylized_Bark_003_roughness.png",
          "texture_3": "shared/textures/Stylized_Bark_003_SD/Stylized_Bark_003_ambientOcclusion.png",
        },
        colors: { "tint": (r:1.0, g:1.0, b:1.0, a:1.0) },
        floats: { "blend_sharpness": 6.0, "metallic": 0.0, "normal_strength": 1.2, "tiling": 0.2 },
      )),
    ),

    // Stylised marbel
    "mat_triplanar_marbel": (
      kind: Custom((
        shader: "shared/shaders/custom_texture_triplanar_pbr.wgsl",
        textures: {
          "texture_0": "shared/textures/White_Marble_006_SD/White_Marble_006_basecolor.png",
          "texture_1": "shared/textures/White_Marble_006_SD/White_Marble_006_normal.png",
          "texture_2": "shared/textures/White_Marble_006_SD/White_Marble_006_roughness.png",
          "texture_3": "shared/textures/White_Marble_006_SD/White_Marble_006_ambientOcclusion.png",
        },
        colors: { "tint": (r:1.0, g:1.0, b:1.0, a:1.0) },
        floats: { "blend_sharpness": 4.0, "metallic": 0.0, "normal_strength": 1.0, "tiling": 0.05 },
      )),
    ),
  },
)
