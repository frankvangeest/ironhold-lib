(
    schema_version: 1,
    initial_state: "exploring",

    global_on: [
        (
            event: "ui.button_pressed:quit",
            do_actions: [Quit],
        ),
    ],

    states: [
        (
            name: "exploring",
            entry_actions: [
                Log("Custom Materials Demo ready. FlyCamera active."),
            ],
            exit_actions: [],
            on: [],
        ),
    ],

    transitions: [
        ( on: "scene.ready:custom_materials_main", to: "exploring" ),
    ],
)
