(
  schema_version: 1,
  prefabs: {

    // ── Player ─────────────────────────────────────────────────────────────────
    // Capsule with eyes and nose so the front (-Z) is clearly visible.
    "player": (
      kind: "primitive",
      model: "Capsule3d",
      components: (
        tags: ["player"],
        movement: (
          walk_speed: 5.5,
          run_speed: 10.0,
          jump: RelativeToHeight(percent: 100.0),
        ),
      ),
      primitive: (
        radius: 0.4,
        height: 1.8,
        color: (0.22, 0.52, 0.88),
        roughness: 0.3,
        metallic: 0.15,
      ),
      children: [
        // Left eye
        (
          shape: "Sphere",
          primitive: (
            radius: 0.07,
            color: (0.03, 0.03, 0.05),
            roughness: 0.20,
            metallic: 0.10,
          ),
          offset: (-0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Right eye
        (
          shape: "Sphere",
          primitive: (
            radius: 0.07,
            color: (0.03, 0.03, 0.05),
            roughness: 0.20,
            metallic: 0.10,
          ),
          offset: (0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Nose
        (
          shape: "Sphere",
          primitive: (
            radius: 0.07,
            color: (0.95, 0.58, 0.42),
            roughness: 0.40,
          ),
          offset: (0.0, 1.49, -0.40),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Ground plane ───────────────────────────────────────────────────────────
    "ground": (
      kind: "primitive",
      model: "Cuboid",
      primitive: (
        size: (60.0, 1.0, 60.0),
        color: (0.30, 0.45, 0.25),
        roughness: 0.9,
        physics: true,
      ),
    ),

    // ── Interactable box ───────────────────────────────────────────────────────
    // Press F while near it — the entity FSM (collectible_box.behavior.ron)
    // transitions to "collected" and despawns the box.
    "collectible_box": (
      kind: "primitive",
      model: "Cuboid",
      behavior: "behaviors/collectible_box.behavior.ron",
      interactable: ( radius: 2.5 ),
      primitive: (
        size: (0.8, 0.8, 0.8),
        color: (0.90, 0.70, 0.20),
        roughness: 0.4,
        metallic: 0.3,
      ),
      motion: (
        rotate: (0.0, 1.0, 0.0),
        bob: (0.12, 0.8),
      ),
    ),

    // ── Score trigger zone ─────────────────────────────────────────────────────
    // Invisible sphere sensor. Walking through it fires entity.entered:score_zone_01
    // which the project rules.ron handles (IncrementVariable("score", 10) + PlaySound).
    "score_zone": (
      kind: "primitive",
      model: "Sphere",
      trigger_zone: ( radius: 2.0 ),
      primitive: (
        radius: 0.05,
        color: (0.20, 0.80, 0.50),
        roughness: 0.5,
      ),
    ),

  },
)
