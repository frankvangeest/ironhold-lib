(
  schema_version: 2,
  prefabs: {

    // ── Player ─────────────────────────────────────────────────────────────────
    // Capsule with eyes and nose so the front (-Z) is clearly visible.
    "player": (
      kind: Primitive,
      model: "",
      shape: Capsule3d,
      components: (
        tags: ["player"],
        // Explicit camera_mode: (camera_modes v2 demo, see main.scene.ron's camera_modes
        // registry): every field below reproduces this project's own prior no-camera-block
        // fallback (default_camera_config()/default_fov(), entity_spawner.rs) exactly, so this
        // is purely additive — the ONLY new behavior is `transition:`, which the fallback path
        // has no way to author. Without it, SetCameraMode(mode: "default") restoring this
        // camera would snap instead of blending, asymmetric with the C-key's blended switch to
        // "birdseye" (ux-gamedesigner-reviewer finding, confirmed live by Frank's playtest).
        camera_mode: Orbit((
          offset:         (0.0, 5.0, 10.0),
          look_at_offset: (0.0, 2.0, 0.0),
          zoom_speed:     10.0,
          orbit_speed:    0.5,
          min_radius:     2.0,
          max_radius:     20.0,
          min_pitch:      0.1,
          max_pitch:      0.9,
          orbit_button:   "Either",
          character_rotate_button: "Right",
          initial_pitch:  0.5,
          initial_yaw:    0.0,
          look_speed:     2.0,
          fov:            45.0,
          transition: (duration_secs: 0.4, ease: EaseInOut),
        )),
        movement: (
          walk_speed: 5.5,
          run_speed: 10.0,
          jump: RelativeToHeight(percent: 100.0),
        ),
        // gamepad_controller_input.md playtest aid — left stick moves, right stick turns/pitches
        // camera, buttons below use genre-convention defaults (Xbox naming; see
        // docs/20_data_formats.md for the PlayStation equivalents). Movement/jump/run/interact/
        // target-cycle all work with just `gamepad_index` set; the gamepad_* fields below are
        // shown for reference and already match their defaults. `forward`/`backward`/etc. must
        // still be spelled out here — authoring any `inputs:` block at all replaces the whole
        // default, and those keyboard fields (unlike the gamepad ones) have no serde default.
        inputs: (
          forward:      "KeyW",
          backward:     "KeyS",
          left:         "KeyA",
          right:        "KeyD",
          strafe_left:  "KeyQ",
          strafe_right: "KeyE",
          jump:         "Space",
          gamepad_index: 0,
          gamepad_jump: "South",
          gamepad_run: "East",
          gamepad_interact: "West",
          gamepad_target_next: "North",
          gamepad_deadzone: 0.15,
        ),
      ),
      primitive: (
        radius: 0.4,
        height: 1.8,
        color: (0.22, 0.52, 0.88),
        roughness: 0.3,
        metallic: 0.15,
      ),
      children: [
        // Left eye
        (
          shape: Sphere,
          primitive: (
            radius: 0.07,
            color: (0.03, 0.03, 0.05),
            roughness: 0.20,
            metallic: 0.10,
          ),
          offset: (-0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Right eye
        (
          shape: Sphere,
          primitive: (
            radius: 0.07,
            color: (0.03, 0.03, 0.05),
            roughness: 0.20,
            metallic: 0.10,
          ),
          offset: (0.18, 1.58, -0.37),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
        // Nose
        (
          shape: Sphere,
          primitive: (
            radius: 0.07,
            color: (0.95, 0.58, 0.42),
            roughness: 0.40,
          ),
          offset: (0.0, 1.49, -0.40),
          rotation_euler_deg: (0.0, 0.0, 0.0),
          scale: (1.0, 1.0, 1.0),
        ),
      ],
    ),

    // ── Ground plane ───────────────────────────────────────────────────────────
    "ground": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      primitive: (
        size: (60.0, 1.0, 60.0),
        color: (0.30, 0.45, 0.25),
        roughness: 0.9,
        physics: true,
      ),
    ),

    // ── Interactable box ───────────────────────────────────────────────────────
    // Press F while near it — the entity FSM (collectible_box.behavior.ron)
    // transitions to "collected" and despawns the box.
    "collectible_box": (
      kind: Primitive,
      model: "",
      shape: Cuboid,
      behavior: "behaviors/collectible_box.behavior.ron",
      interactable: ( radius: 2.5 ),
      primitive: (
        size: (0.8, 0.8, 0.8),
        color: (0.90, 0.70, 0.20),
        roughness: 0.4,
        metallic: 0.3,
      ),
      motion: (
        rotate: (0.0, 1.0, 0.0),
        bob: (0.12, 0.8),
      ),
    ),

    // ── Respawning gem ({new_id} substitution demo, planning/features/monotonic_entity_id.md) ──
    // Press F to collect — it hides, spawns a small residue prop with a {new_id}-derived id, then
    // reappears a few seconds later. {self} (this gem's own spawn id) is identical on every
    // collection, so only {new_id} keeps each residue's id from colliding with the previous one —
    // the same shape as the corpse-id-reuse problem this token was built to solve.
    "respawning_gem": (
      kind: Primitive,
      model: "",
      shape: Sphere,
      behavior: "behaviors/respawning_gem.behavior.ron",
      interactable: ( radius: 2.5 ),
      primitive: (
        radius: 0.35,
        color: (0.85, 0.25, 0.85),
        roughness: 0.1,
        metallic: 0.6,
      ),
      motion: (
        rotate: (0.0, 1.5, 0.0),
      ),
    ),

    // ── Gem residue ──────────────────────────────────────────────────────────────
    // Purely decorative — one is spawned per gem collection to make each {new_id}-derived id
    // visible as a distinct, surviving entity rather than a single reused one. Must be a GLB
    // (kind: Prop) rather than a primitive shape (model: "") — Action::Spawn's executor requires
    // a resolvable asset-catalog model key before it will queue any dynamic spawn at all,
    // regardless of prefab kind (a real, pre-existing engine limitation this demo surfaced: a
    // primitive-shaped prop can be scene-placed but not dynamically Action::Spawn-ed).
    "gem_residue": (
      kind: Prop,
      model: "rock_residue",
      nameplate: false,
    ),

    // ── Score trigger zone ─────────────────────────────────────────────────────
    // Invisible sphere sensor. Walking through it fires entity.entered:score_zone_01
    // which the project rules.ron handles (IncrementVariable("score", 10) + PlaySound).
    "score_zone": (
      kind: Primitive,
      model: "",
      shape: Sphere,
      trigger_zone: ( radius: 2.0 ),
      primitive: (
        radius: 0.05,
        color: (0.20, 0.80, 0.50),
        roughness: 0.5,
      ),
    ),

  },
)
