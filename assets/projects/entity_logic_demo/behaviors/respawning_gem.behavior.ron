    ),
  ],
  transitions: [
    ( from: "idle_0", on: "entity.interacted:{self}", to: "collected_0" ),
    ( from: "collected_0", on: "gem.reappear:{self}", to: "idle_1" ),
    ( from: "idle_1", on: "entity.interacted:{self}", to: "collected_1" ),
    ( from: "collected_1", on: "gem.reappear:{self}", to: "idle_2" ),
    ( from: "idle_2", on: "entity.interacted:{self}", to: "collected_2" ),
    ( from: "collected_2", on: "gem.reappear:{self}", to: "idle_3" ),
    ( from: "idle_3", on: "entity.interacted:{self}", to: "collected_3" ),
    ( from: "collected_3", on: "gem.reappear:{self}", to: "idle_4" ),
    ( from: "idle_4", on: "entity.interacted:{self}", to: "collected_4" ),
    ( from: "collected_4", on: "gem.reappear:{self}", to: "idle_5" ),
    ( from: "idle_5", on: "entity.interacted:{self}", to: "collected_5" ),
    ( from: "collected_5", on: "gem.reappear:{self}", to: "idle_6" ),
