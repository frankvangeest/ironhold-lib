      entry_actions: [
        PlaySound(key: "score"),
        SetEntityVisible(entity: "{self}", visible: false),
        Spawn(prefab: "gem_residue", id: "{self}_residue_{new_id}", position: (8.02, 0.15, -4.47)),
        IncrementVariable("residue_count", 1),
        EmitEventAfterDelay(event: "gem.reappear:{self}", delay_secs: 3.0),
      ],
      exit_actions: [],
