// Project-level rules for entity_logic_demo.
// Entity-specific logic lives in behaviors/*.behavior.ron instead.
(
  schema_version: 1,
  rules: [
    // Start-menu gate: the click is a real user gesture, which is what lets the browser's
    // WebAudio AudioContext start correctly for every PlaySound/PlayMusicLoop that follows.
    (
      on: "ui.button_pressed:start_game",
      do_actions: [ LoadScene("scenes/main.scene.ron") ],
    ),
    // Score zone: walk in → +10 points + sound
    (
      on: "entity.entered:score_zone_01",
      do_actions: [
        IncrementVariable("score", 10),
        PlaySound(key: "zone_enter"),
        Log("Score zone entered — +10 points"),
      ],
    ),
    // Score zone: walk out → log only
    (
      on: "entity.exited:score_zone_01",
      do_actions: [
        Log("Score zone exited"),
      ],
    ),
    // camera_modes v2 demo — see main.scene.ron's camera_modes registry + scene_key_bindings.
    // Round-trips through the reserved "default" key, not just a one-way switch, since that's
    // the sentinel's only real teaching surface.
    (
      on: "ui.button_pressed:camera_birdseye",
      do_actions: [SetCameraMode(mode: "birdseye")],
    ),
    (
      on: "ui.button_pressed:camera_reset",
      do_actions: [SetCameraMode(mode: "default")],
    ),
  ],
)
