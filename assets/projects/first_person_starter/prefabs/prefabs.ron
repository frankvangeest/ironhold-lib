(
    schema_version: 2,
    prefabs: {

        // ── The player ───────────────────────────────────────────────────────────────────────
        // The male character seen through a first-person camera. `tags: ["player"]` wires up the
        // character controller, physics and camera automatically.
        "player_male_fps": (
            kind: Actor,
            model: "character_male",
            display_name: "Player",
            components: (
                tags: ["player"],
                movement: (
                    walk_speed: 5.0,
                    run_speed: 8.5,
                ),
                camera_mode: FirstPerson((
                    // Camera position relative to the player's origin (its feet), in metres.
                    eye_offset: (0.0, 1.65, 0.0),
                    // Mouse look: radians per pixel moved. Lower = slower.
                    sensitivity: 0.002,
                    // How far you can look down (negative) and up (positive), in radians.
                    min_pitch: -1.4,
                    max_pitch: 1.4,
                    // Vertical field of view in degrees (the engine uses the vertical angle, so 90 is very
                    // wide: about 120 degrees horizontal on a 16:9 screen). 75 is about 100 horizontal.
                    fov: 75.0,
                    // Right-stick and keyboard-look speed, in radians per second (the mouse uses
                    // `sensitivity` instead).
                    look_speed: 2.5,
                    // true = pushing up looks down (applies to the mouse, the stick and the keys).
                    invert_y: false,
                    // Grab and hide the mouse on the first click; release it while paused. Without
                    // this the mouse leaves the game window and mouse look stops at its edge.
                    capture_cursor: true,
                    // Hide the player's own body so the camera does not look inside the head. It
                    // also hides the player's nameplate and floating bars.
                    hide_own_body: true,
                )),
                inputs: (
                    // `FirstPerson` supplies the shooter defaults: A/D strafe, no turn keys, the
                    // mouse buttons are free for firing, and Shift is hold-to-sprint. Anything you
                    // write here beats the scheme: leave a field out to get the scheme's key, write
                    // `None` to unbind it, write a key name to replace it. For example (A and D then do
                    // nothing: bind `left`/`right` too if you want keys that turn):
                    //   strafe_left: "KeyQ", strafe_right: "KeyE", run_mode: Toggle,
                    controls: FirstPerson,
                    // A gamepad only works for a player that names one. 0 = the first controller.
                    gamepad_index: 0,
                ),
            ),
        ),

        // ── The arena ────────────────────────────────────────────────────────────────────────
        // Ground: a static physics surface. Cuboid(60, 1, 60) placed at y = -0.5 has its top at y = 0.
        "ground": (
            kind: Primitive,
            model: "",
            shape: Cuboid,
            components: (),
            primitive: (
                size: (60.0, 1.0, 60.0),
                color: (0.30, 0.32, 0.28),
                roughness: 0.95,
                physics: true,
            ),
        ),

        // Perimeter walls, one prefab per orientation (a physics cuboid keeps its authored size).
        "wall_ns": (
            kind: Primitive,
            model: "",
            shape: Cuboid,
            components: (),
            primitive: (
                size: (40.0, 4.0, 1.0),
                color: (0.45, 0.45, 0.50),
                roughness: 0.9,
                physics: true,
            ),
        ),
        "wall_ew": (
            kind: Primitive,
            model: "",
            shape: Cuboid,
            components: (),
            primitive: (
                size: (1.0, 4.0, 40.0),
                color: (0.45, 0.45, 0.50),
                roughness: 0.9,
                physics: true,
            ),
        ),

        // Cover: a waist-high box to crouch-walk behind (and to jump on).
        "cover_box": (
            kind: Primitive,
            model: "",
            shape: Cuboid,
            components: (),
            primitive: (
                size: (2.0, 1.2, 2.0),
                color: (0.55, 0.42, 0.30),
                roughness: 0.85,
                physics: true,
            ),
        ),

        // A gentle ramp and a short flight of steps: exercise walking uphill, jumping and landing.
        "ramp": (
            kind: Primitive,
            model: "",
            shape: Cuboid,
            components: (),
            primitive: (
                size: (4.0, 0.3, 8.0),
                color: (0.40, 0.50, 0.55),
                roughness: 0.8,
                physics: true,
            ),
        ),
        "step": (
            kind: Primitive,
            model: "",
            shape: Cuboid,
            components: (),
            primitive: (
                size: (4.0, 0.4, 1.2),
                color: (0.50, 0.50, 0.42),
                roughness: 0.85,
                physics: true,
            ),
        ),

        // A target to look at and (once weapons exist) shoot: a red capsule.
        "training_dummy": (
            kind: Primitive,
            model: "",
            shape: Capsule3d,
            components: (),
            primitive: (
                radius: 0.4,
                height: 1.8,
                color: (0.85, 0.20, 0.18),
                roughness: 0.5,
                physics: true,
            ),
        ),

    }
)
