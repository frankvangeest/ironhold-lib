(
    schema_version: 3,
    project_id: "first_person_starter",
    display_name: "First Person Starter",

    initial_scene: "scenes/main.scene.ron",

    asset_catalog: "assets.ron",
    prefab_catalog: "prefabs/prefabs.ron",
    state_machine_path: "logic/state_machine.ron",
    model_fixes_path: "overrides/model_fixes.ron",

    global_environment: (
        intensity: 400.0,
        fallback: (
            top_color: (0.10, 0.18, 0.38),
            bottom_color: (0.01, 0.01, 0.01),
        ),
    ),

    // P toggles the pause (press it again to resume). Escape only ever PAUSES: once the browser has
    // captured the mouse it takes Escape to release it, the game never sees that key, and the release
    // raises `cursor.lock_lost` (see logic/state_machine.ron), which also only pauses. Because both
    // just pause, an Escape that arrives together with the lock loss cannot undo itself.
    global_key_bindings: {
        "KeyP": "toggle_pause",
        "Escape": "pause",
    },

    // The Start button of a gamepad that belongs to a player pauses too (the "unclaimed" map only
    // applies to pads no player owns).
    global_claimed_gamepad_bindings: { "Start": "toggle_pause" },
)
