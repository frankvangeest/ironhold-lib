// A target dummy: it stands there until its health reaches 0, goes down, and stands up again 3 seconds later.
//
// How it works:
//  - the prefab's `stat_templates` give every dummy its own `{self}.health`, and a threshold there emits
//    `stat.{self}.health.depleted` when it hits 0;
//  - a shot (see the fire slot in scenes/main.scene.ron) does `ModifyStat(key: "{target}.health", ...)`;
//  - this file reacts to that event: poof, sound, and the dummy hides itself (a hidden entity cannot be aimed at or
//    shot, and its health bar hides with it). `SetEntityVisible` is what makes it "down";
//  - 3 seconds later this same file brings it back: full health, visible again.
//
// Why it hides instead of despawning and respawning: `Action::Spawn` cannot create a primitive-shaped prefab at
// runtime (it needs a `model`), so a despawned capsule could never come back. (`ironhold validate` reports a Spawn
// of such a prefab.) A prefab with a `model` can despawn and be re-created with `Spawn` instead, the way
// 3rd_person_game_demo's monsters do.
//
// Known limit of this approach: a hidden dummy still has its collider, so for those 3 seconds it blocks walking
// and shots at whatever stands behind it, though it cannot be aimed at.
(
    schema_version: 1,
    initial_state: "up",

    global_on: [],

    states: [
        (
            name: "up",
            // Also runs when the dummy first spawns: starts at full health, visible.
            entry_actions: [
                SetStat(key: "{self}.health", value: 100.0),
                SetEntityVisible(entity: "{self}", visible: true),
            ],
            exit_actions: [],
            on: [],
        ),
        (
            name: "down",
            entry_actions: [
                PlaySound(key: "hit"),
                SpawnEffect(key: "death_poof", entity: "{self}"),
                SetEntityVisible(entity: "{self}", visible: false),
                // An event addressed to this one dummy (`{self}` is its scene id); this behavior's own transition below
                // catches it. If you move on to another scene before it fires, the event just finds no dummy.
                EmitEventAfterDelay(event: "dummy.rise:{self}", delay_secs: 3.0),
            ],
            exit_actions: [],
            on: [],
        ),
    ],

    transitions: [
        ( from: "up",   on: "stat.{self}.health.depleted", to: "down" ),
        ( from: "down", on: "dummy.rise:{self}",           to: "up"   ),
    ],
)
