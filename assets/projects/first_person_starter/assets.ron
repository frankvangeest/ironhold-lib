(
  schema_version: 1,
  models: {
    // The male character, the same model `3rd_person_game_demo` uses. The player's own body is
    // hidden in first person (`hide_own_body` on the camera), so it needs no animation policy:
    // a first-person player never sees it. Add an `animation_policy` on the prefab if you show the
    // body (a mirror, a third-person camera preset, a multiplayer opponent).
    "character_male": ( path: "shared/models/characters/character-male-01.glb#Scene0" ),
  },
  textures: {
    // Particle sprites for the hit and death effects below.
    "particle/spark_01": "shared/textures/particles/kenney-particle-pack/spark_01.png",
    "particle/spark_02": "shared/textures/particles/kenney-particle-pack/spark_02.png",
    "particle/spark_03": "shared/textures/particles/kenney-particle-pack/spark_03.png",
    "particle/smoke_01": "shared/textures/particles/kenney-particle-pack/smoke_01.png",
    "particle/smoke_02": "shared/textures/particles/kenney-particle-pack/smoke_02.png",
  },
  audio: {
    // "shot" plays when you fire, "hit" when a target goes down, "click" when you fire with nothing in
    // the crosshair. Replace the files with real gun sounds when you have them.
    "shot":  (path: "shared/audio/combat/heave-male.wav", volume: 0.7),
    "hit":   (path: "shared/audio/combat/punch-01.wav",   volume: 0.9),
    "click": (path: "shared/audio/menu-button-click.wav", volume: 0.6),
  },
  effects: {
    // A short spark burst on the target you hit.
    "hit_spark": (
      particle_count: 10,
      lifetime_secs: 0.40,
      speed: 3.0,
      speed_jitter: 0.9,
      spread_deg: 180.0,
      offset: (0.0, 0.2, 0.0),
      size: 0.06,
      size_end: 0.0,
      color_start: (1.0, 0.75, 0.2, 1.0),
      color_end:   (1.0, 0.1,  0.0, 0.0),
      gravity: -4.5,
      sprites: ["particle/spark_01", "particle/spark_02", "particle/spark_03"],
    ),
    // A grey smoke puff when a target goes down.
    "death_poof": (
      particle_count: 8,
      lifetime_secs: 0.70,
      speed: 1.2,
      speed_jitter: 0.4,
      spread_deg: 60.0,
      offset: (0.0, 0.0, 0.0),
      size: 0.18,
      size_end: 0.40,
      color_start: (0.55, 0.55, 0.55, 0.9),
      color_end:   (0.30, 0.30, 0.30, 0.0),
      gravity: -0.5,
      sprites: ["particle/smoke_01", "particle/smoke_02"],
    ),
  },
  materials: {},
)
