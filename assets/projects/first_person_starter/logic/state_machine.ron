(
    schema_version: 1,
    // A flat project: every rule lives in `global_on`. See "Pausing the game" in
    // docs/30_runtime_events_and_logic.md for the state-based alternative.
    global_on: [
        // Warm the particle pipelines off-screen once, or the first hit stalls the web build for a moment while the
        // GPU pipeline compiles (see "Warming up particle pipelines" in docs/20_data_formats.md). Both effects are the
        // same kind (alpha blended sprites), so one call warms both; use one per kind your project adds (additive...).
        ( event: "scene.ready:main", do_actions: [
            Log("First person starter ready"),
            SpawnEffect(key: "hit_spark", position: (0.0, -100.0, 0.0)),
        ] ),

        // Three ways to ask for a pause. They only change the clock; the menu is shown by the
        // `game.paused` / `game.resumed` rules below, which fire once per REAL change, so asking
        // twice in a frame (Escape plus a lost mouse lock) cannot open the menu twice.
        //   P or the gamepad Start button: toggle
        ( event: "ui.button_pressed:toggle_pause", do_actions: [ TogglePause ] ),
        //   Escape: pause only
        ( event: "ui.button_pressed:pause", do_actions: [ PauseGame ] ),
        //   The browser took the mouse back (the player pressed Escape while it was captured; the
        //   game cannot see that key press, so the engine raises this event instead): pause only.
        ( event: "cursor.lock_lost", do_actions: [ PauseGame ] ),

        // Fire with nothing under the crosshair: the shot slot needs a `{target}`, so the engine skips it and
        // raises this event instead. A dry click is the whole "miss" feedback. (The event name carries the
        // slot's `key`, "1".) Note a miss neither starts the cooldown nor costs anything.
        ( event: "action_bar.no_target:1", do_actions: [ PlaySound(key: "click") ] ),

        // The menu button resumes.
        ( event: "ui.button_pressed:resume", do_actions: [ ResumeGame ] ),

        // The pause menu follows the clock.
        ( event: "game.paused",  do_actions: [ LoadSceneOverlay("scenes/pause.scene.ron") ] ),
        ( event: "game.resumed", do_actions: [ UnloadOverlay ] ),
    ],
)
