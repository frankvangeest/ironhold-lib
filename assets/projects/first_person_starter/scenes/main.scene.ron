(
    schema_version: 2,
    name: "main",

    lighting: (
        ambient: (0.8, 0.85, 1.0),
        ambient_brightness: 80.0,
        directional: (
            color: (1.0, 0.95, 0.82),
            intensity: 28000.0,
            rotation_euler_deg: (-42.0, 30.0, 0.0),
            shadows_enabled: true,
        ),
    ),

    spawn_points: {
        "player_start": (0.0, 0.5, 14.0),
    },

    entities: [

        // The player starts at the south end of the arena looking north (-Z), towards the targets.
        (
            id: "player_01",
            prefab: "player_male_fps",
            transform: (
                translation: (0.0, 0.5, 14.0),
                rotation_euler_deg: (0.0, 0.0, 0.0),
                scale: (1.0, 1.0, 1.0),
            ),
        ),

        (
            id: "ground",
            prefab: "ground",
            transform: (
                translation: (0.0, -0.5, 0.0),
                rotation_euler_deg: (0.0, 0.0, 0.0),
                scale: (1.0, 1.0, 1.0),
            ),
        ),

        // Perimeter walls (a 40 x 40 arena).
        ( id: "wall_north", prefab: "wall_ns", transform: ( translation: (0.0, 2.0, -20.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),
        ( id: "wall_south", prefab: "wall_ns", transform: ( translation: (0.0, 2.0, 20.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),
        ( id: "wall_east", prefab: "wall_ew", transform: ( translation: (20.0, 2.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),
        ( id: "wall_west", prefab: "wall_ew", transform: ( translation: (-20.0, 2.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),

        // Cover.
        ( id: "cover_01", prefab: "cover_box", transform: ( translation: (-6.0, 0.6, 4.0), rotation_euler_deg: (0.0, 15.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),
        ( id: "cover_02", prefab: "cover_box", transform: ( translation: (6.0, 0.6, -2.0), rotation_euler_deg: (0.0, -10.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),
        ( id: "cover_03", prefab: "cover_box", transform: ( translation: (0.0, 0.6, -9.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),

        // A ramp on the east side, rising towards the north wall.
        ( id: "ramp_01", prefab: "ramp", transform: ( translation: (12.0, 0.55, -6.0), rotation_euler_deg: (12.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),

        // Three steps on the west side, each 0.4 m higher than the last.
        ( id: "step_01", prefab: "step", transform: ( translation: (-12.0, 0.2, -4.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),
        ( id: "step_02", prefab: "step", transform: ( translation: (-12.0, 0.6, -5.2), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),
        ( id: "step_03", prefab: "step", transform: ( translation: (-12.0, 1.0, -6.4), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),

        // Targets at three ranges. Each is shot, goes down and stands up again by itself (see
        // behaviors/training_dummy.behavior.ron); to add one, copy a line and give it a new id.
        ( id: "dummy_near", prefab: "training_dummy", transform: ( translation: (-3.0, 0.9, 6.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),
        ( id: "dummy_mid", prefab: "training_dummy", transform: ( translation: (4.0, 0.9, -13.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),
        ( id: "dummy_far", prefab: "training_dummy", transform: ( translation: (-8.0, 0.9, -17.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ) ),

    ],

    ui: [
        // Crosshair: a full-screen layout group that centres a 24 x 24 box holding two thin bars.
        // A Group is a pure layout wrapper and never blocks the mouse.
        Group((
            id: "crosshair_layer",
            width: Percent(100.0),
            height: Percent(100.0),
            justify_content: Center,
            align_items: Center,
            children: [
                Group((
                    id: "crosshair",
                    width: Px(24.0),
                    height: Px(24.0),
                    children: [
                        Rect(( id: "crosshair_h", position: (0.0, 11.0), size: (24.0, 2.0), color: (1.0, 1.0, 1.0, 0.85), absolute: true )),
                        Rect(( id: "crosshair_v", position: (11.0, 0.0), size: (2.0, 24.0), color: (1.0, 1.0, 1.0, 0.85), absolute: true )),
                    ],
                )),
            ],
        )),

        // The prefab name of what the crosshair is on (empty when nothing is). `target_name` is a variable the engine
        // keeps up to date (`target_id` is the entity's id instead); any Label can show it with `bind`. The layer
        // centres it at the top of the screen.
        Group((
            id: "target_layer",
            width: Percent(100.0),
            height: Percent(100.0),
            justify_content: Center,
            align_items: Start,
            padding: 24.0,
            children: [
                Label(( id: "target_label", text: "", bind: "target_name", size: (400.0, 28.0), align: Center, font_size: 20.0 )),
            ],
        )),

        // The weapon: one slot. (To add a second weapon, copy the slot with `key: "2"` and e.g. `mouse_button: "Right"`
        // and its own `do_actions`, and add a rule for `action_bar.no_target:2` next to the one for slot 1 in
        // logic/state_machine.ron. Range and catch radius are set per camera in the player prefab, not per weapon.) `key` is the slot's name and a keyboard fallback, `mouse_button` fires it from the
        // left mouse button (only while the mouse is captured), `gamepad_key` from the right trigger. The slot
        // acts on `{target}`, the thing under the crosshair; with nothing there the shot is skipped and the engine
        // raises `action_bar.no_target:1` (logic/state_machine.ron plays a dry click). `cooldown_secs` makes it
        // one shot per press at most every quarter second.
        ActionBar((
            id: "weapon",
            position: (16.0, 150.0),
            slot_size: 48.0,
            slots: [
                (
                    key: "1",
                    mouse_button: "Left",
                    gamepad_key: "RightTrigger2",
                    key_hint: "LMB",
                    label: "Fire",
                    cooldown_secs: 0.25,
                    do_actions: [
                        // "shot" is a placeholder sound (a grunt); swap the file in assets.ron for a real one.
                        PlaySound(key: "shot"),
                        // The damage is written twice: change BOTH. The dummies have 100 health, so 25 is four shots.
                        ModifyStat(key: "{target}.health", delta: -25.0),
                        ShowDamagePopup(entity: "{target}", amount: -25.0),
                        SpawnEffect(key: "hit_spark", entity: "{target}"),
                        // A hook for your own rules (an enemy that notices it was shot, a score): nothing in this
                        // project listens for it.
                        EmitEvent("entity.attacked:{target}"),
                    ],
                ),
            ],
        )),

        // Hints, one short line each so they fit a narrow window (ASCII only: the built-in UI font has no glyph
        // for dashes). They are plain text: update them if you change a key, `run_mode` or a pause binding.
        Label(( id: "hint_keys", text: "WASD move, mouse look, Space jump, Shift sprint", position: (16.0, 16.0), size: (560.0, 26.0), align: Left, font_size: 18.0 )),
        Label(( id: "hint_pad", text: "Gamepad: sticks move and look, A jump, LT sprint", position: (16.0, 44.0), size: (560.0, 26.0), align: Left, font_size: 18.0 )),
        Label(( id: "hint_pause", text: "P or Start pauses. Esc pauses and frees the mouse.", position: (16.0, 72.0), size: (560.0, 26.0), align: Left, font_size: 18.0 )),
        Label(( id: "hint_capture", text: "Click the game once to capture the mouse.", position: (16.0, 100.0), size: (560.0, 26.0), align: Left, font_size: 18.0 )),
        Label(( id: "hint_fire", text: "Fire: left mouse (after that click) or RT.", position: (16.0, 122.0), size: (560.0, 26.0), align: Left, font_size: 18.0 )),
    ],
)
