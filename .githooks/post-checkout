#!/bin/sh
# Auto-syncs .opencode/, .claude/hooks/, and AGENTS.md from `integration`'s tip into a brand-new
# worktree that doesn't have them yet. feature/* branches are cut from `main`, which lags behind
# `integration` until the next release promotion (see CLAUDE.md Branching Model) -- until then,
# every freshly created worktree has no OpenCode config at all, and OpenCode silently falls back
# to no project instructions, no model routing, no permission scoping. This closes that gap
# automatically instead of needing a manual `git checkout integration -- .opencode/ ...` + commit
# every time (real incidents: feature/fix_stale_logic_path_warning and
# feature/rules_to_state_machine_consolidation both hit this, 2026-09-23).
#
# $1 = previous HEAD, $2 = new HEAD, $3 = 1 if a branch checkout, 0 if a file checkout.
# git passes the all-zero SHA as $1 specifically for a worktree's very first checkout -- an
# ordinary `git checkout`/`git switch` inside an already-existing worktree always has a real
# previous SHA, so this condition is what tells "brand-new worktree" apart from "just switched
# branches in a worktree that was already here."

prev_head="$1"
zero_sha="0000000000000000000000000000000000000000"

if [ "$prev_head" != "$zero_sha" ]; then
  exit 0
fi

# Already has config (e.g. this worktree is on integration itself, or main has since been
# promoted and already carries it) -- nothing to do.
if [ -f ".opencode/opencode.json" ]; then
  exit 0
fi

# No local `integration` branch to sync from (e.g. a fresh clone before the one-time bootstrap
# in CLAUDE.md has run) -- don't guess, just skip.
if ! git rev-parse --verify -q integration >/dev/null 2>&1; then
  exit 0
fi

echo "post-checkout: this worktree has no .opencode/ config -- auto-syncing from integration's tip..." >&2

git checkout integration -- .opencode/ .claude/hooks/ AGENTS.md 2>/dev/null

# Nothing actually changed (paths already matched) -- don't create an empty commit.
if git diff --cached --quiet 2>/dev/null; then
  exit 0
fi

git commit -q -m "chore(opencode): auto-sync OpenCode tooling config from integration

Automated by .githooks/post-checkout: this worktree was created from a
branch that predates the OpenCode compatibility work living on
integration. Byte-identical copy of .opencode/, .claude/hooks/, and
AGENTS.md from integration's tip at worktree-creation time. See CLAUDE.md
Branching Model for why this gap exists until integration is next
promoted to main, at which point this hook becomes a no-op again."

echo "post-checkout: committed OpenCode config sync ($(git rev-parse --short HEAD))." >&2

exit 0
